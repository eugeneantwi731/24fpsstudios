---
// Navbar.astro
const currentPath = Astro.url.pathname;

const links = [
  { label: 'HOME',      href: '/'          },
  { label: 'WORK',      href: '/work'       },
  { label: 'ABOUT',     href: '/about'      },
  { label: 'TEAM',      href: '/team'       },
  { label: 'FEED',      href: '/feed'       },
  { label: 'RESOURCES', href: '/resources'  },
];

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="nav-wrap">
  <nav class="navbar">

    <!-- ── LOGO SLOT ── -->
    <a href="/" class="nav-logo" aria-label="24fps Home">
      <img src="/images/24fps-nav.svg" alt="24fps" class="logo-img" />
    </a>

    <!-- ── NAV LINKS ── -->
    <ul class="nav-links" role="navigation">
      {links.map(link => (
        <li class="nav-item">
          <a
            href={link.href}
            class={`nav-link ${isActive(link.href) ? 'active' : ''}`}
          >
            {link.label}
            {isActive(link.href) && <span class="active-dot" aria-hidden="true"></span>}
          </a>
        </li>
      ))}
    </ul>
    <script is:inline>
      /* Shooting-ball tab indicator.
         Pages are separate loads, so on click we remember which tab the ball sat
         on; this script (inline, so it runs before first paint) then launches a
         flying ball from that tab: a short wind-up, one fast eased shot stretched
         along its path with a comet trail, and a squash-and-settle landing on the
         new active tab. Farther trips take a little longer and go faster. The
         resting .active-dot takes over once it lands. */
      (function () {
        var KEY = 'navBall';
        var ul = document.querySelector('.nav-links');
        var links = ul ? Array.prototype.slice.call(ul.querySelectorAll('.nav-link')) : [];
        if (!links.length) return;

        var activeIdx = -1;
        links.forEach(function (l, i) { if (l.classList.contains('active')) activeIdx = i; });

        // 1) On click, remember where the ball is now.
        links.forEach(function (a) {
          a.addEventListener('click', function (e) {
            if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
            try {
              if (activeIdx < 0) sessionStorage.removeItem(KEY);
              else sessionStorage.setItem(KEY, JSON.stringify({ from: activeIdx, ts: Date.now() }));
            } catch (_) {}
          });
        });

        // 2) On arrival, read it (once) and animate.
        var from = -1;
        try {
          var raw = sessionStorage.getItem(KEY);
          sessionStorage.removeItem(KEY);
          if (raw) {
            var o = JSON.parse(raw);
            if (Date.now() - o.ts < 8000 && o.from >= 0 && o.from < links.length) from = o.from;
          }
        } catch (_) {}

        var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
        var restDot = activeIdx >= 0 ? links[activeIdx].querySelector('.active-dot') : null;
        if (reduce || from < 0 || !restDot || !ul.offsetWidth || document.hidden) return;

        ul.classList.add('is-hopping');

        var to = activeIdx;
        var D = 7, PINK = '232,56,109';
        var d = Math.abs(to - from);                       // tabs crossed
        var CROUCH = 110;                                  // wind-up
        var F = d === 0 ? 300 : 300 + d * 55;              // flight time: 355ms … 575ms
        var LIFT = d === 0 ? 14 : Math.min(14, 6 + d * 2); // arc height (px)
        var END = CROUCH + F + 300;                        // + landing settle

        function ease(u) { return u < 0.5 ? 4 * u * u * u : 1 - Math.pow(-2 * u + 2, 3) / 2; } // in-out cubic

        var ball = document.createElement('div');
        ball.setAttribute('aria-hidden', 'true');
        ball.style.cssText = 'position:fixed;left:0;top:0;width:' + D + 'px;height:' + D + 'px;border-radius:50%;' +
          'background:rgb(' + PINK + ');transform-origin:50% 50%;pointer-events:none;z-index:1001;will-change:transform;';
        // Comet trail: one tapered tail + two thin speed lines, all rotated along the path.
        var trail = document.createElement('div');
        trail.setAttribute('aria-hidden', 'true');
        trail.style.cssText = 'position:fixed;left:0;top:0;width:0;height:0;pointer-events:none;z-index:1000;opacity:0;will-change:transform;';
        function part(h, top, taper) {
          var s = document.createElement('span');
          s.style.cssText = 'position:absolute;right:0;top:' + top + 'px;height:' + h + 'px;border-radius:99px;' +
            'background:linear-gradient(to right,rgba(' + PINK + ',0),rgba(' + PINK + ',' + (taper ? 0.85 : 0.55) + '));' +
            (taper ? 'clip-path:polygon(0 50%,100% 0,100% 100%);' : '');
          trail.appendChild(s);
          return s;
        }
        var tail = part(D * 0.8, -D * 0.4, true);
        var lineA = part(1.5, -D * 0.95, false);
        var lineB = part(1.5, D * 0.95 - 1.5, false);
        document.body.appendChild(trail);
        document.body.appendChild(ball);

        function centers() {
          return links.map(function (l) { var r = l.getBoundingClientRect(); return r.left + r.width / 2; });
        }

        var t0 = 0, prev = null, sv = 0, ang = 0, done = false;
        function finish() {
          if (done) return;
          done = true;
          ball.remove(); trail.remove();
          ul.classList.remove('is-hopping');
        }
        window.addEventListener('pageshow', function (e) { if (e.persisted) finish(); });
        setTimeout(finish, END + 2500); // safety net if frames are throttled

        function frame(ts) {
          if (done) return;
          if (!t0) t0 = ts;
          var now = ts - t0;
          if (now >= END) return finish();

          var cs = centers();
          var base = restDot.getBoundingClientRect().bottom;   // floor
          var dir = to >= from ? 1 : -1;
          var x, lift = 0, sx = 1, sy = 1, flying = false;

          if (now < CROUCH) {
            // 1) wind-up: sink and pull back slightly, like drawing a bow
            var c = now / CROUCH, e = 1 - (1 - c) * (1 - c);
            x = cs[from] - dir * 4 * e;
            sy = 1 - 0.38 * e; sx = 1 + 0.32 * e;
          } else if (now < CROUCH + F) {
            // 2) the shot: ease-in-out along a shallow arc
            flying = true;
            var u = (now - CROUCH) / F, k = ease(u);
            var startX = cs[from] - dir * 4;
            x = startX + (cs[to] - startX) * k;
            lift = LIFT * Math.sin(Math.PI * u);
          } else {
            // 3) landing: one squash that rebounds and settles
            var dt = now - CROUCH - F;
            x = cs[to];
            var q = 0.5 * Math.exp(-dt / 70) * Math.cos(dt / 42);
            sy = 1 - q; sx = 1 + q * 0.85;
          }

          var cy = base - D / 2 - lift;
          var cx = x;
          var vx = 0, vy = 0;
          if (prev) {
            var dtf = Math.max(1, ts - prev.ts);
            vx = (cx - prev.x) / dtf; vy = (cy - prev.y) / dtf;
            sv = sv * 0.45 + Math.hypot(vx, vy) * 0.55;
            if (sv > 0.05) ang = Math.atan2(vy, vx) * 180 / Math.PI;
          }

          if (flying) {
            // stretch along the direction of travel (area-preserving), scaled by speed
            var sa = 1 + Math.min(1.5, sv * 1.25);
            ball.style.transform = 'translate(' + (cx - D / 2) + 'px,' + (cy - D / 2) + 'px) rotate(' + ang + 'deg) scale(' + sa + ',' + (1 / Math.sqrt(sa)) + ')';
          } else {
            // squash against the floor: keep the bottom planted
            ball.style.transform = 'translate(' + (cx - D / 2) + 'px,' + (cy - D / 2 + D * (1 - sy) / 2) + 'px) scale(' + sx + ',' + sy + ')';
          }

          // trail only while moving fast
          var len = flying ? Math.min(78, sv * 85) : 0;
          trail.style.opacity = Math.max(0, Math.min(1, (len - 6) / 16));
          trail.style.transform = 'translate(' + cx + 'px,' + cy + 'px) rotate(' + ang + 'deg)';
          tail.style.width = len + 'px';
          lineA.style.width = len * 0.55 + 'px';
          lineB.style.width = len * 0.4 + 'px';

          prev = { x: cx, y: cy, ts: ts };
          requestAnimationFrame(frame);
        }
        requestAnimationFrame(frame);
      })();
    </script>

    <!-- ── CTA ── -->
    <a href="/join" class="nav-cta">
      JOIN OUR CREW
      <span class="cta-arrow" aria-hidden="true">
        <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M8 1L9.5 6.5L15 8L9.5 9.5L8 15L6.5 9.5L1 8L6.5 6.5L8 1Z" fill="none" stroke="#ffffff" stroke-width="1.5" stroke-linejoin="round"/>
        </svg>
      </span>
    </a>

    <!-- ── MOBILE HAMBURGER ── -->
    <button class="hamburger" id="hamburger" aria-label="Open menu" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>

  </nav>
</header>

<!-- ── MOBILE MENU ── -->
<div class="mobile-menu" id="mobile-menu" aria-hidden="true" inert>
  {links.map((link, i) => (
    <a href={link.href} class={`mobile-link ${isActive(link.href) ? 'active' : ''}`} style={`--i:${i}`}>
      {link.label}
    </a>
  ))}
  <a href="/join" class="mobile-cta" style={`--i:${links.length}`}>
    JOIN OUR CREW
    <span class="cta-arrow" aria-hidden="true">
      <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M8 1L9.5 6.5L15 8L9.5 9.5L8 15L6.5 9.5L1 8L6.5 6.5L8 1Z" fill="none" stroke="#ffffff" stroke-width="1.5" stroke-linejoin="round"/>
      </svg>
    </span>
  </a>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Raleway:wght@500;700;800;900&display=swap');

  /* ── LOCAL VARS ── */
  :root {
    --pink:  #E8386D;
    --black: #1A1A1A;
  }

  /* ── WRAPPER — positions the bar with space around it ── */
  .nav-wrap {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 999;
    padding: 16px 24px;
    pointer-events: none; /* lets clicks pass through the gap */
  }

  /* ── THE NAVBAR BAR ITSELF ── */
  .navbar {
    pointer-events: all;
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0 48px;
    height: 72px;
    border-radius: 20px;

    /* Linear gradient: #FCF8F8 > #FFFFFF > #FCF8F8 */
    background: linear-gradient(
      to right,
      #FCF8F8 0%,
      #FFFFFF 25%,
      #FFFFFF 75%,
      #FCF8F8 100%
    );

    border: none;
    box-shadow: none;
    position: relative;
    overflow: visible;
  }

  /* Gradient shadow — same width as navbar, 4-color, pink 40% teal 20% */
  .navbar::after {
    content: '';
    position: absolute;
    bottom: -4.5px;
    left: 5px;
    right: 5px;
    height: 60px;
    border-radius: 0;
    background: linear-gradient(
      to right,
      rgba(230, 80, 125, 0.2) 0%,
      rgba(63, 211, 213, 0.1) 25%,
      rgba(230, 80, 125, 0.2) 50%,
      rgba(63, 211, 213, 0.1) 75%,
      rgba(230, 80, 125, 0.2) 100%
    );
    filter: blur(10.8px);
    opacity: 1;
    z-index: -1;
  }

  /* Glass edge — bright light reflection on border, no color tint */
  .navbar::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 20px;
    padding: 2px;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 1) 0%,
      rgba(255, 255, 255, 0.4) 100%
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  /* ── LOGO ── */
  .nav-logo {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .logo-img {
    height: 48px;
    width: auto;
    display: block;
  }

  /* ── NAV LINKS ── */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 0rem;
    list-style: none;
    margin: 0 auto;
  }

  .nav-item { position: relative; }

  .nav-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    font-family: 'Raleway', sans-serif;
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    color: var(--black);
    padding: 0.4rem 1.25rem;
    transition: color 0.2s;
    position: relative;
    background: none;
  }

  .nav-link:hover {
    color: var(--pink);
    background: none;
  }

  .nav-link.active {
    color: var(--pink);
  }

  /* Active dot — the resting spot of the bouncing ball (see script below) */
  .active-dot {
    display: block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--pink);
    position: absolute;
    bottom: -5px;
    left: 50%;
    transform: translateX(-50%);
  }

  /* While the flying ball is mid-hop, hide the resting dot (keeps its layout
     so we can still measure where the ball needs to land). */
  .nav-links.is-hopping .active-dot { opacity: 0; }

  /* ── CTA BUTTON ── */
  .nav-cta {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--pink);
    color: #fff;
    font-family: 'Raleway', sans-serif;
    font-weight: 800;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    padding: 0.85rem 1.25rem;
    border-radius: 999px;
    transition: all 0.25s;
    box-shadow: 0 4px 16px rgba(232, 56, 109, 0.35);
    white-space: nowrap;
  }

  .nav-cta:hover {
    background: #d42d60;
    transform: translateY(-1px);
    box-shadow: 0 6px 24px rgba(232, 56, 109, 0.45);
  }

  /* Sparkle icon — no circle, just the outline icon */
  .cta-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* Star pops when the button is clicked (the sparks come from here) */
  .nav-cta.is-sparking .cta-arrow svg,
  .mobile-cta.is-sparking .cta-arrow svg {
    animation: star-pop 0.55s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  @keyframes star-pop {
    0%   { transform: scale(1) rotate(0deg); }
    40%  { transform: scale(1.55) rotate(90deg); }
    100% { transform: scale(1) rotate(180deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-cta.is-sparking .cta-arrow svg,
    .mobile-cta.is-sparking .cta-arrow svg { animation: none; }
  }

  .cta-arrow svg {
    width: 18px;
    height: 18px;
    display: block;
  }

  /* ── HAMBURGER ── */
  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    margin-left: auto;
    -webkit-tap-highlight-color: transparent;
  }

  .hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--black);
    border-radius: 2px;
    transform-origin: center;
    transition:
      transform 0.5s cubic-bezier(0.65, 0, 0.25, 1),
      opacity 0.25s ease,
      background-color 0.3s ease;
  }

  /* The three bars fold into an X (bars are 2px tall with a 5px gap, so 7px apart) */
  .hamburger[aria-expanded='true'] span:nth-child(1) { transform: translateY(7px) rotate(45deg);  background: var(--pink); }
  .hamburger[aria-expanded='true'] span:nth-child(2) { transform: scaleX(0); opacity: 0; }
  .hamburger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); background: var(--pink); }

  /* ── MOBILE MENU ── */
  /* Always laid out; hidden with opacity/visibility so it can animate in and out. */
  .mobile-menu {
    display: flex;
    position: fixed;
    top: 104px;
    left: 24px;
    right: 24px;
    background: #FFFFFF;
    border-radius: 20px;
    padding: 1.5rem;
    flex-direction: column;
    gap: 0.25rem;
    z-index: 998;
    box-shadow:
      0 8px 32px rgba(232, 56, 109, 0.12),
      0 16px 48px rgba(63, 211, 213, 0.08),
      0 24px 64px rgba(0,0,0,0.08);
    border: 1px solid rgba(255,255,255,0.9);

    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-14px) scale(0.94);
    transform-origin: top right;
    transition:
      opacity 0.25s ease,
      transform 0.35s cubic-bezier(0.4, 0, 0.6, 1),
      visibility 0s linear 0.35s;
  }

  .mobile-menu.open {
    right: calc(24px + var(--sbw, 0px)); /* stays put when the page scrollbar goes away */
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: none;
    transition:
      opacity 0.3s ease,
      transform 0.55s cubic-bezier(0.34, 1.5, 0.5, 1),
      visibility 0s;
  }

  /* Tabs pop up one after another */
  .mobile-link,
  .mobile-cta {
    opacity: 0;
    transform: translateY(18px) scale(0.94);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .mobile-menu.open .mobile-link,
  .mobile-menu.open .mobile-cta {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.35s ease calc(var(--i, 0) * 55ms + 90ms),
      transform 0.6s cubic-bezier(0.34, 1.55, 0.5, 1) calc(var(--i, 0) * 55ms + 90ms),
      background-color 0.2s ease 0s,
      color 0.2s ease 0s;
  }

  .mobile-link {
    font-family: 'Raleway', sans-serif;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.08em;
    color: var(--black);
    padding: 0.85rem 1rem;
    border-radius: 10px;
  }

  .mobile-link:hover,
  .mobile-link.active {
    background: rgba(232, 56, 109, 0.06);
    color: var(--pink);
  }

  .mobile-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    font-family: 'Raleway', sans-serif;
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    background: var(--pink);
    color: #fff;
    padding: 0.9rem 1.5rem;
    border-radius: 999px;
    text-align: center;
    margin-top: 0.5rem;
    box-shadow: 0 4px 16px rgba(232, 56, 109, 0.35);
  }

  /* Scroll lock while the menu is open: the scrollbar disappears, so the page and the
     fixed navbar are padded by exactly its width and nothing shifts sideways. */
  :global(html.menu-open) {
    overflow: hidden;
    padding-right: var(--sbw, 0px);
  }
  :global(html.menu-open) .nav-wrap {
    padding-right: calc(24px + var(--sbw, 0px));
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu, .mobile-menu.open,
    .mobile-link, .mobile-cta,
    .mobile-menu.open .mobile-link, .mobile-menu.open .mobile-cta,
    .hamburger span { transition: none; }
  }

  @media (min-width: 901px) {
    .mobile-menu { display: none; }
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .nav-links { display: none; }
    .nav-cta   { display: none; }
    .hamburger { display: flex; }
  }
</style>

<script>
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobile-menu');
  const root = document.documentElement;

  function setMenu(open: boolean) {
    if (!hamburger || !mobileMenu) return;
    if (open) {
      // width of the scrollbar that is about to disappear, so the layout can make room for it
      root.style.setProperty('--sbw', (window.innerWidth - root.clientWidth) + 'px');
    }
    mobileMenu.classList.toggle('open', open);
    root.classList.toggle('menu-open', open);
    hamburger.setAttribute('aria-expanded', String(open));
    hamburger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    mobileMenu.setAttribute('aria-hidden', String(!open));
    if (open) mobileMenu.removeAttribute('inert');
    else mobileMenu.setAttribute('inert', '');
  }

  hamburger?.addEventListener('click', () => {
    setMenu(!mobileMenu?.classList.contains('open'));
  });

  // Tabs close the menu (the Join button handles its own close, see below)
  document.querySelectorAll('.mobile-link').forEach(link => {
    link.addEventListener('click', () => setMenu(false));
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileMenu?.classList.contains('open')) {
      setMenu(false);
      hamburger?.focus();
    }
  });

  document.addEventListener('click', (e) => {
    if (!mobileMenu?.classList.contains('open')) return;
    const t = e.target as Node;
    if (!mobileMenu.contains(t) && !hamburger?.contains(t)) setMenu(false);
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth > 900 && mobileMenu?.classList.contains('open')) setMenu(false);
  });

  // Join our crew (bar button and menu button): pop the star and let its sparks play
  // for a moment before the page changes. Modified clicks go through untouched.
  document.querySelectorAll<HTMLAnchorElement>('.nav-cta, .mobile-cta').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      e.preventDefault();
      btn.classList.remove('is-sparking');
      void btn.offsetWidth; // restart the animation if clicked again
      btn.classList.add('is-sparking');
      const href = btn.href;
      window.setTimeout(() => { window.location.href = href; }, 650);
    });
  });
</script>
