---
// Trust bar + About card + the three pillars, directly under the hero.
// Content lives in src/data/home.js. The member count is passed in (read live
// from the database by the page); if it is missing, that stat is simply left out.
import { zone } from '../../data/home.js';

interface Props {
  memberCount?: number | null;
}
const { memberCount = null } = Astro.props;

const stats = [
  { icon: 'cap',      tone: 'purple', value: zone.trust.affiliation.value, label: zone.trust.affiliation.label },
  { icon: 'calendar', tone: 'pink',   value: zone.trust.founded.value,     label: zone.trust.founded.label },
  ...(memberCount ? [{ icon: 'users', tone: 'teal', value: String(memberCount), label: memberCount === 1 ? 'Member' : 'Members' }] : []),
];

const icons: Record<string, string> = {
  cap:      '<path d="M12 4 2 9l10 5 10-5-10-5Z"/><path d="M6 11.5V16c0 1.2 2.7 3 6 3s6-1.8 6-3v-4.5"/>',
  calendar: '<rect x="3.5" y="5" width="17" height="15" rx="3.2"/><path d="M8 3v4M16 3v4M3.5 10h17"/>',
  users:    '<circle cx="9" cy="8.5" r="3.2"/><path d="M3 19c.6-3.2 3-5 6-5s5.4 1.8 6 5"/><circle cx="17" cy="9.5" r="2.4"/><path d="M16.5 14.2c2.4.1 4 1.5 4.5 4.3"/>',
  decode:   '<circle cx="12" cy="12" r="9"/><path d="M10 8.8v6.4a.5.5 0 0 0 .78.42l4.9-3.2a.5.5 0 0 0 0-.84l-4.9-3.2a.5.5 0 0 0-.78.42Z" fill="currentColor" stroke="none"/>',
  create:   '<path d="M4 20l1-4.2L16.6 4.2a2 2 0 0 1 2.8 0l.4.4a2 2 0 0 1 0 2.8L8.2 19 4 20Z"/><path d="M14.5 6.3l3.2 3.2"/>',
  inspire:  '<circle cx="9" cy="8.5" r="3.2"/><path d="M3 19c.6-3.2 3-5 6-5s5.4 1.8 6 5"/><circle cx="17" cy="9.5" r="2.4"/><path d="M16.5 14.2c2.4.1 4 1.5 4.5 4.3"/>',
};
const tones: Record<string, string> = { decode: 'pink', create: 'teal', inspire: 'yellow' };
---

<section class="zone" id="about-zone">
  <div class="zone__inner">

    <!-- ── Trust bar ── -->
    <div class="trust glass" data-reveal>
      {stats.map((s, i) => (
        <>
          {i > 0 && <span class="trust__rule" aria-hidden="true"></span>}
          <div class="trust__item">
            <span class={`trust__icon tone-${s.tone}`} aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[s.icon]} />
            </span>
            <span class="trust__text">
              <strong class="trust__value">{s.value}</strong>
              <span class="trust__label">{s.label}</span>
            </span>
          </div>
        </>
      ))}
    </div>

    <!-- ── About card ── -->
    <div class="about glass" data-reveal style="--d: 80ms">
      <div class="about__art" aria-hidden="true">
        <span class="blob blob--pink"></span>
        <span class="blob blob--teal"></span>
        <img src="/images/star-scribble-1.svg" alt="" class="about__deco about__deco--star" width="40" height="40" loading="lazy" />
        <img src="/images/cross-scribble-1.svg" alt="" class="about__deco about__deco--cross" width="26" height="26" loading="lazy" />
        <img
          src="/images/about/girl-tablet.webp"
          alt=""
          class="about__girl"
          width="952"
          height="955"
          loading="lazy"
        />
      </div>

      <div class="about__copy">
        <span class="pill"><i class="pill__dot" aria-hidden="true"></i>{zone.about.label}</span>
        <h2 class="about__title">{zone.about.title} <span>{zone.about.titleAccent}</span></h2>
        <p class="about__body">{zone.about.body}</p>
        <a href={zone.about.cta.href} class="zbtn">
          <span>{zone.about.cta.label}</span>
          <span class="zbtn__icon" aria-hidden="true">
            <svg class="zbtn__glyph" viewBox="0 0 16 16" fill="none"><path d="M2.5 8h10.2M8.4 3.6 12.8 8l-4.4 4.4" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <svg class="zbtn__glyph zbtn__glyph--in" viewBox="0 0 16 16" fill="none"><path d="M2.5 8h10.2M8.4 3.6 12.8 8l-4.4 4.4" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
      </div>
    </div>

    <!-- ── Pillars ── -->
    <div class="pillars">
      {zone.pillars.map((p, i) => (
        <article class="pillar glass" data-reveal style={`--d: ${160 + i * 90}ms`}>
          <span class={`pillar__icon tone-${tones[p.key]}`} aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[p.key]} />
          </span>
          <div>
            <h3 class="pillar__title">{p.title}</h3>
            <p class="pillar__text">{p.text}</p>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<noscript><style>[data-reveal]{opacity:1 !important;transform:none !important}</style></noscript>

<style>
  .zone {
    position: relative;
    padding: 28px 3vw 96px;
    isolation: isolate;
  }

  /* very soft colour washes so the glass has something to blur */
  .zone::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(40% 36% at 8% 18%, rgba(159, 106, 205, 0.11), transparent 70%),
      radial-gradient(38% 34% at 94% 46%, rgba(63, 211, 213, 0.12), transparent 70%),
      radial-gradient(34% 30% at 40% 96%, rgba(233, 41, 93, 0.07), transparent 70%);
  }

  .zone__inner {
    max-width: 1600px;
    margin: 0 auto;
    display: grid;
    gap: 24px;
  }

  /* ── Glass card ── */
  .glass {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0.62));
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    backdrop-filter: blur(14px) saturate(1.4);
    border: 1px solid rgba(255, 255, 255, 0.95);
    border-radius: 28px;
    box-shadow:
      0 0 0 1px rgba(124, 77, 255, 0.07),
      0 26px 50px -26px rgba(90, 60, 170, 0.3),
      0 4px 12px rgba(90, 60, 170, 0.05);
  }

  /* ── Reveal on scroll ── */
  [data-reveal] {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.7s ease var(--d, 0ms),
      transform 0.9s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0ms);
  }
  [data-reveal].is-in { opacity: 1; transform: none; }

  /* ── Pill label ── */
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.5rem 0.95rem 0.5rem 0.8rem;
    font: 800 0.72rem/1 'Raleway', sans-serif;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #1A1A1A;
    background: #fff;
    border: 1px solid rgba(124, 77, 255, 0.16);
    border-radius: 999px;
    box-shadow: 0 6px 16px -8px rgba(90, 60, 170, 0.3);
  }
  .pill__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #9F6ACD;
    box-shadow: 0 0 0 3px rgba(159, 106, 205, 0.18);
  }

  /* ── Tones ── */
  .tone-pink   { color: #E9295D; background: rgba(233, 41, 93, 0.1); }
  .tone-teal   { color: #14AEB1; background: rgba(63, 211, 213, 0.18); }
  .tone-purple { color: #8453C4; background: rgba(159, 106, 205, 0.15); }
  .tone-yellow { color: #D49A00; background: rgba(255, 214, 0, 0.24); }

  /* ── Trust bar ── */
  .trust {
    display: flex;
    align-items: center;
    justify-content: space-around;
    gap: 1.25rem;
    padding: 1.25rem clamp(1.25rem, 3vw, 3rem);
    border-radius: 999px;
  }
  .trust__item { display: flex; align-items: center; gap: 0.95rem; min-width: 0; }
  .trust__icon {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: grid;
    place-items: center;
  }
  .trust__icon svg { width: 24px; height: 24px; }
  .trust__text { display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; }
  .trust__value {
    font: 900 clamp(1.35rem, 1.9vw, 1.9rem)/1 'Raleway', sans-serif;
    letter-spacing: -0.02em;
    color: #1A1A1A;
  }
  .trust__label {
    font: 600 0.84rem/1.2 'Raleway', sans-serif;
    color: #6B7280;
  }
  .trust__rule {
    width: 1px;
    align-self: stretch;
    background: linear-gradient(to bottom, transparent, rgba(26, 26, 26, 0.14), transparent);
  }

  /* ── About card ── */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    min-height: clamp(380px, 32vw, 520px);
    overflow: hidden;
  }

  .about__art {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 2rem 1.5rem 0;
  }

  .about__girl {
    position: relative;
    z-index: 2;
    display: block;
    width: min(100%, 520px);
    height: auto;
  }

  .blob { position: absolute; z-index: 1; border-radius: 58% 42% 55% 45% / 52% 56% 44% 48%; }
  .blob--pink {
    width: 62%;
    aspect-ratio: 1.05;
    left: 6%;
    bottom: 4%;
    background: rgba(255, 150, 185, 0.62);
    transform: rotate(-8deg);
  }
  .blob--teal {
    width: 46%;
    aspect-ratio: 1;
    right: 8%;
    top: 12%;
    background: rgba(100, 224, 226, 0.5);
    border-radius: 46% 54% 42% 58% / 56% 44% 56% 44%;
  }

  .about__deco { position: absolute; z-index: 3; pointer-events: none; }
  .about__deco--star  { top: 9%;  left: 10%; width: 38px; height: auto; }
  .about__deco--cross { top: 22%; right: 7%; width: 24px; height: auto; }

  .about__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 1.25rem;
    padding: clamp(2rem, 4.5vw, 5rem) clamp(1.75rem, 4.5vw, 5.5rem) clamp(2rem, 4.5vw, 5rem) clamp(0.5rem, 1.5vw, 1.5rem);
  }

  .about__title {
    margin: 0;
    font: 900 clamp(2.1rem, 3.5vw, 3.9rem)/1.04 'Raleway', sans-serif;
    letter-spacing: -0.03em;
    color: #1A1A1A;
    max-width: 14ch;
  }
  .about__title span { color: #E9295D; }

  .about__body {
    margin: 0;
    max-width: 54ch;
    font: 500 clamp(1rem, 1.1vw, 1.12rem)/1.7 'Raleway', sans-serif;
    color: #4B4B4B;
  }

  /* ── Button (same pill + icon-swap as the hero) ── */
  .zbtn {
    --ease: cubic-bezier(0.65, 0, 0.25, 1);
    --icon: 44px;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 1.4rem;
    height: 60px;
    margin-top: 0.4rem;
    padding: 0 8px 0 1.9rem;
    font: 700 1rem/1 'Raleway', sans-serif;
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
    border-radius: 999px;
    background: linear-gradient(180deg, #EE3A6B 0%, #E0245A 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.28),
      0 14px 30px -8px rgba(233, 41, 93, 0.55),
      0 3px 8px rgba(233, 41, 93, 0.25);
    transition: transform 0.45s var(--ease), box-shadow 0.45s var(--ease), filter 0.45s var(--ease);
  }
  .zbtn::after { content: ''; position: absolute; left: 0; right: 0; top: -4px; bottom: -8px; }
  .zbtn:hover {
    transform: translateY(-2px);
    filter: brightness(1.07) saturate(1.05);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.32),
      0 20px 38px -8px rgba(233, 41, 93, 0.62),
      0 4px 10px rgba(233, 41, 93, 0.3);
  }
  .zbtn:active { transform: translateY(0) scale(0.975); transition-duration: 0.1s; }
  .zbtn:focus-visible { outline: 3px solid #3FD3D5; outline-offset: 4px; }

  .zbtn__icon {
    flex-shrink: 0;
    width: var(--icon);
    height: var(--icon);
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: 50%;
    background: #fff;
    color: #E9295D;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.14);
  }
  .zbtn__glyph {
    grid-area: 1 / 1;
    width: 18px;
    height: 18px;
    transition: transform 0.55s var(--ease);
  }
  .zbtn__glyph--in { transform: translateX(-44px); }
  .zbtn:hover .zbtn__glyph:not(.zbtn__glyph--in) { transform: translateX(44px); }
  .zbtn:hover .zbtn__glyph--in { transform: translateX(0); }

  /* ── Pillars ── */
  .pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .pillar {
    display: flex;
    align-items: center;
    gap: 1.3rem;
    padding: 1.7rem clamp(1.4rem, 2.4vw, 2.4rem);
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.45s ease;
  }
  .pillar:hover {
    transform: translateY(-4px);
    box-shadow:
      0 0 0 1px rgba(124, 77, 255, 0.1),
      0 32px 56px -26px rgba(90, 60, 170, 0.38),
      0 6px 16px rgba(90, 60, 170, 0.07);
  }
  .pillar__icon {
    flex-shrink: 0;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: grid;
    place-items: center;
  }
  .pillar__icon svg { width: 28px; height: 28px; }
  .pillar__title {
    margin: 0 0 0.3rem;
    font: 900 clamp(1.3rem, 1.6vw, 1.6rem)/1.1 'Raleway', sans-serif;
    letter-spacing: -0.02em;
    color: #1A1A1A;
  }
  .pillar__text { margin: 0; font: 600 0.98rem/1.4 'Raleway', sans-serif; color: #6B7280; }

  /* ── Smaller screens ── */
  @media (max-width: 960px) {
    .zone { padding: 36px 5vw 72px; }
    .trust {
      flex-direction: column;
      align-items: stretch;
      border-radius: 28px;
      gap: 1rem;
    }
    .trust__rule { width: 100%; height: 1px; align-self: auto; background: linear-gradient(to right, transparent, rgba(26, 26, 26, 0.14), transparent); }
    .about { grid-template-columns: 1fr; }
    .about__copy { order: 1; padding: 2rem 1.6rem 1rem; }
    .about__art { order: 2; padding-top: 1rem; }
    .about__girl { width: min(100%, 420px); }
    .about__title { max-width: none; }
    .pillars { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] { opacity: 1; transform: none; transition: none; }
    .pillar, .zbtn, .zbtn__glyph { transition: none; }
    .pillar:hover, .zbtn:hover, .zbtn:active { transform: none; }
    .zbtn:hover .zbtn__glyph:not(.zbtn__glyph--in) { transform: none; }
    .zbtn__glyph--in, .zbtn:hover .zbtn__glyph--in { display: none; }
  }
</style>

<script>
  // Fade/slide each block in as it scrolls into view.
  const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if (!('IntersectionObserver' in window)) {
    items.forEach((el) => el.classList.add('is-in'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.18, rootMargin: '0px 0px -6% 0px' }
    );
    items.forEach((el) => io.observe(el));
  }
</script>
