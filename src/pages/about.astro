---
import BaseLayout from '../layouts/BaseLayout.astro';

const decodeCreateInspire = '/images/decode-create-inpire.svg';
const heroIllustration = '/images/24fps-illustration.png';
---

<BaseLayout title="Home">
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-copy">
        <img
          src={decodeCreateInspire}
          alt="Decode. Create. Inspire."
          class="hero-headline"
          width="1200"
          height="750"
        />
      </div>

      <div class="hero-visual">
        <img
          src={heroIllustration}
          alt="24fps animators and illustrators at work, sketching on tablets"
          class="hero-illustration"
          width="1080"
          height="1080"
        />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 140px 3vw 2rem;
  }

  .hero-inner {
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    align-items: center;
    gap: 0;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2rem;
  }

  .hero-headline {
    width: 100%;
    max-width: 1400px;   /* was 1000px */
    height: auto;
    display: block;
    margin-top: -5rem;    /* new */
  }

  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-illustration {
    width: 100%;
    max-width: 1800px;   /* was 1200px */
    height: auto;
    display: block;
    margin-top: -4rem;    /* new */
  }

  @media (max-width: 960px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 1rem;
      text-align: center;
    }

    .hero-copy {
      align-items: center;
      order: 1;
    }

    .hero-headline {
      max-width: 520px;
      margin: 0 auto;
    }

    .hero-visual {
      order: 2;
    }

    .hero-illustration {
      max-width: 460px;
    }
  }

  @media (max-width: 560px) {
    .hero {
      padding: 96px 5vw 3rem;
    }

    .hero-headline {
      max-width: 360px;
    }

    .hero-illustration {
      max-width: 320px;
    }
  }
</style>