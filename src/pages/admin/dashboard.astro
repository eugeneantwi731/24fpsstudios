---
export const prerender = false;
import { getAdminSupabase } from 'src/lib/supabase-admin';

const token = Astro.cookies.get('admin_session')?.value;
if (!token) return Astro.redirect('/admin');

const runtimeEnv = (Astro.locals as any).runtime?.env;
const supabase = getAdminSupabase(runtimeEnv);

// Validate session
const { data: session } = await supabase
  .from('admin_sessions')
  .select('admin_id, expires_at')
  .eq('token', token)
  .maybeSingle();

if (!session || new Date(session.expires_at) < new Date()) {
  Astro.cookies.delete('admin_session', { path: '/' });
  return Astro.redirect('/admin');
}

const { data: adminUser } = await supabase
  .from('admin_users')
  .select('username, role')
  .eq('id', session.admin_id)
  .maybeSingle();

// Fetch submission stats
const { count: totalCount }    = await supabase.from('member_submissions').select('*', { count: 'exact', head: true });
const { count: pendingCount }  = await supabase.from('member_submissions').select('*', { count: 'exact', head: true }).eq('status', 'pending');
const { count: approvedCount } = await supabase.from('member_submissions').select('*', { count: 'exact', head: true }).eq('status', 'approved');
const { count: rejectedCount } = await supabase.from('member_submissions').select('*', { count: 'exact', head: true }).eq('status', 'rejected');

// Join applications + published team member counts, for sidebar badges
const { count: joinPendingCount } = await supabase.from('join_submissions').select('*', { count: 'exact', head: true }).eq('status', 'pending');
const { count: publishedCount }   = await supabase.from('members').select('*', { count: 'exact', head: true }).eq('published', true);

// Fetch recent submissions
const { data: recentSubmissions } = await supabase
  .from('member_submissions')
  .select('id, name, role, category, status, created_at, photo_url')
  .order('created_at', { ascending: false })
  .limit(8);

const setupDone = Astro.url.searchParams.get('setup') === 'done';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard — 24fps Admin</title>
  <link rel="icon" type="image/svg+xml" href="/images/24fps-favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --pink:    #E9295D;
      --teal:    #3FD3D5;
      --yellow:  #FEC843;
      --purple:  #9F6ACD;
      --black:   #1A1A1A;
      --white:   #FFFFFF;
      --off:     #F8F5F5;
      --muted:   #6B7280;
      --border:  rgba(26,26,26,0.10);
      --pink-light:   rgba(233,41,93,0.08);
      --teal-light:   rgba(63,211,213,0.10);
      --yellow-light: rgba(254,200,67,0.12);
      --purple-light: rgba(159,106,205,0.10);
    }

    html, body {
      height: 100%;
      font-family: 'Raleway', sans-serif;
      background: var(--off);
      color: var(--black);
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    /* ── LAYOUT ── */
    .layout {
      display: grid;
      grid-template-columns: 260px 1fr;
      grid-template-rows: auto 1fr;
      min-height: 100vh;
    }

    /* ── SIDEBAR ── */
    .sidebar {
      grid-row: 1 / -1;
      background: var(--white);
      border-right: 1.5px solid var(--border);
      display: flex;
      flex-direction: column;
      position: sticky;
      top: 0;
      height: 100vh;
      overflow-y: auto;
      z-index: 10;
    }

    .sidebar__brand {
      padding: 28px 24px 20px;
      border-bottom: 1.5px solid var(--border);
    }

    .sidebar__logo {
      display: flex;
      align-items: baseline;
      gap: 0;
      line-height: 1;
      margin-bottom: 4px;
    }

    .sidebar__logo-num {
      font-size: 2rem;
      font-weight: 900;
      color: var(--black);
      letter-spacing: -0.03em;
    }

    .sidebar__logo-fps {
      font-size: 2rem;
      font-weight: 900;
      color: var(--black);
      letter-spacing: -0.03em;
    }

    .sidebar__logo-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--yellow);
      margin-left: 2px;
      margin-bottom: 5px;
      flex-shrink: 0;
      align-self: flex-end;
    }

    .sidebar__tag {
      font-size: 0.55rem;
      font-weight: 800;
      letter-spacing: 0.18em;
      color: var(--muted);
      text-transform: uppercase;
    }

    .sidebar__admin-badge {
      margin-top: 14px;
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--off);
      border-radius: 12px;
      padding: 10px 12px;
    }

    .sidebar__avatar {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--pink), var(--purple));
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.75rem;
      font-weight: 900;
      color: white;
      flex-shrink: 0;
      text-transform: uppercase;
    }

    .sidebar__admin-info { flex: 1; min-width: 0; }
    .sidebar__admin-name {
      font-size: 0.82rem;
      font-weight: 800;
      color: var(--black);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .sidebar__admin-role {
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--pink);
    }

    .sidebar__nav {
      flex: 1;
      padding: 20px 16px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .sidebar__section-label {
      font-size: 0.6rem;
      font-weight: 800;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--muted);
      padding: 12px 8px 6px;
      margin-top: 8px;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 12px;
      border-radius: 12px;
      text-decoration: none;
      font-size: 0.84rem;
      font-weight: 700;
      color: var(--muted);
      transition: background 0.18s, color 0.18s;
      position: relative;
    }

    .nav-item:hover {
      background: var(--off);
      color: var(--black);
    }

    .nav-item.is-active {
      background: var(--pink-light);
      color: var(--pink);
    }

    .nav-item__icon {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      background: var(--off);
      transition: background 0.18s;
    }

    .nav-item.is-active .nav-item__icon {
      background: rgba(233,41,93,0.12);
    }

    .nav-item__icon svg { width: 16px; height: 16px; }

    .nav-item__badge {
      margin-left: auto;
      background: var(--pink);
      color: white;
      font-size: 0.65rem;
      font-weight: 900;
      padding: 2px 7px;
      border-radius: 999px;
      min-width: 20px;
      text-align: center;
    }

    .nav-item--coming {
      opacity: 0.45;
      pointer-events: none;
    }

    .nav-item__soon {
      margin-left: auto;
      font-size: 0.6rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
      background: var(--off);
      padding: 2px 6px;
      border-radius: 5px;
    }

    .sidebar__footer {
      padding: 16px;
      border-top: 1.5px solid var(--border);
    }

    .logout-btn {
      width: 100%;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 12px;
      border-radius: 12px;
      background: none;
      border: none;
      font-family: 'Raleway', sans-serif;
      font-size: 0.84rem;
      font-weight: 700;
      color: var(--muted);
      cursor: pointer;
      transition: background 0.18s, color 0.18s;
    }

    .logout-btn:hover {
      background: rgba(233,41,93,0.06);
      color: var(--pink);
    }

    .logout-btn svg { width: 16px; height: 16px; flex-shrink: 0; }

    /* ── TOPBAR ── */
    .topbar {
      background: var(--white);
      border-bottom: 1.5px solid var(--border);
      padding: 16px 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    .topbar__title {
      font-size: 1.1rem;
      font-weight: 900;
      letter-spacing: -0.01em;
      color: var(--black);
    }

    .topbar__sub {
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--muted);
      margin-top: 2px;
    }

    .topbar__actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      background: var(--pink);
      color: white;
      border: none;
      font-family: 'Raleway', sans-serif;
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 10px 18px;
      border-radius: 999px;
      cursor: pointer;
      text-decoration: none;
      transition: background 0.18s, transform 0.12s, box-shadow 0.18s;
      box-shadow: 0 4px 14px rgba(233,41,93,0.25);
    }

    .btn-primary:hover {
      background: #d4234f;
      transform: translateY(-1px);
      box-shadow: 0 6px 18px rgba(233,41,93,0.35);
    }

    .btn-primary svg { width: 14px; height: 14px; }

    /* ── MAIN CONTENT ── */
    .main {
      padding: 28px 32px 48px;
      overflow-y: auto;
    }

    /* ── SETUP TOAST ── */
    .setup-toast {
      background: linear-gradient(135deg, rgba(63,211,213,0.12), rgba(159,106,205,0.08));
      border: 1.5px solid rgba(63,211,213,0.3);
      border-radius: 16px;
      padding: 14px 20px;
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 24px;
      animation: slideDown 0.4s ease both;
    }

    .setup-toast__icon {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: var(--teal);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .setup-toast__icon svg { width: 18px; height: 18px; color: white; }
    .setup-toast__text { flex: 1; font-size: 0.84rem; font-weight: 600; color: var(--black); }
    .setup-toast__text strong { color: var(--teal); }

    .setup-toast__close {
      background: none;
      border: none;
      cursor: pointer;
      color: var(--muted);
      padding: 4px;
      border-radius: 6px;
      transition: color 0.15s;
    }

    .setup-toast__close:hover { color: var(--black); }
    .setup-toast__close svg { width: 16px; height: 16px; }

    /* ── STATS GRID ── */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      margin-bottom: 28px;
    }

    .stat-card {
      background: var(--white);
      border-radius: 20px;
      padding: 22px 24px;
      border: 1.5px solid var(--border);
      position: relative;
      overflow: hidden;
      transition: transform 0.18s, box-shadow 0.18s;
      animation: fadeUp 0.4s ease both;
    }

    .stat-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 28px rgba(0,0,0,0.08);
    }

    .stat-card:nth-child(1) { border-color: rgba(233,41,93,0.2);   animation-delay: 0.05s; }
    .stat-card:nth-child(2) { border-color: rgba(254,200,67,0.3);  animation-delay: 0.10s; }
    .stat-card:nth-child(3) { border-color: rgba(63,211,213,0.2);  animation-delay: 0.15s; }
    .stat-card:nth-child(4) { border-color: rgba(159,106,205,0.2); animation-delay: 0.20s; }

    .stat-card::before {
      content: '';
      position: absolute;
      top: 0; right: 0;
      width: 80px; height: 80px;
      border-radius: 50%;
      opacity: 0.08;
      transform: translate(20px, -20px);
    }

    .stat-card:nth-child(1)::before { background: var(--pink); }
    .stat-card:nth-child(2)::before { background: var(--yellow); }
    .stat-card:nth-child(3)::before { background: var(--teal); }
    .stat-card:nth-child(4)::before { background: var(--purple); }

    .stat-card__icon {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 14px;
    }

    .stat-card:nth-child(1) .stat-card__icon { background: var(--pink-light); color: var(--pink); }
    .stat-card:nth-child(2) .stat-card__icon { background: var(--yellow-light); color: #b8860b; }
    .stat-card:nth-child(3) .stat-card__icon { background: var(--teal-light); color: #0a7e80; }
    .stat-card:nth-child(4) .stat-card__icon { background: var(--purple-light); color: var(--purple); }

    .stat-card__icon svg { width: 20px; height: 20px; }

    .stat-card__num {
      font-size: 2.4rem;
      font-weight: 900;
      letter-spacing: -0.03em;
      color: var(--black);
      line-height: 1;
      margin-bottom: 4px;
    }

    .stat-card__label {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--muted);
    }

    /* ── SECTION HEADER ── */
    .section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 16px;
    }

    .section-header__left { display: flex; align-items: center; gap: 10px; }

    .section-title {
      font-size: 1rem;
      font-weight: 900;
      letter-spacing: 0.02em;
      color: var(--black);
      text-transform: uppercase;
    }

    .section-title-underline {
      display: block;
      width: 100%;
      height: 4px;
      margin-top: -1px;
    }

    .section-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
    }

    .view-all {
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--pink);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 4px;
      transition: gap 0.18s;
    }

    .view-all:hover { gap: 8px; }
    .view-all svg { width: 14px; height: 14px; }

    /* ── SUBMISSIONS TABLE ── */
    .submissions-card {
      background: var(--white);
      border-radius: 20px;
      border: 1.5px solid var(--border);
      overflow: hidden;
      animation: fadeUp 0.4s 0.25s ease both;
    }

    .table-wrap { overflow-x: auto; }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    thead th {
      background: var(--off);
      padding: 12px 20px;
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--muted);
      text-align: left;
      white-space: nowrap;
      border-bottom: 1.5px solid var(--border);
    }

    tbody tr {
      border-bottom: 1px solid var(--border);
      transition: background 0.15s;
    }

    tbody tr:last-child { border-bottom: none; }
    tbody tr:hover { background: var(--off); }

    tbody td {
      padding: 14px 20px;
      font-size: 0.84rem;
      font-weight: 500;
      color: var(--black);
      vertical-align: middle;
    }

    .member-cell {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .member-avatar {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      object-fit: cover;
      flex-shrink: 0;
      background: var(--off);
    }

    .member-avatar-initials {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: linear-gradient(135deg, var(--pink), var(--purple));
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.72rem;
      font-weight: 900;
      color: white;
      flex-shrink: 0;
      text-transform: uppercase;
    }

    .member-name {
      font-weight: 800;
      font-size: 0.86rem;
      color: var(--black);
    }

    .member-role {
      font-size: 0.72rem;
      font-weight: 500;
      color: var(--muted);
      margin-top: 1px;
    }

    .category-badge {
      display: inline-block;
      padding: 3px 10px;
      border-radius: 999px;
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .category-badge--student  { background: var(--teal-light);   color: #0a7e80; }
    .category-badge--alumni   { background: var(--purple-light);  color: var(--purple); }
    .category-badge--faculty  { background: var(--yellow-light);  color: #8a6000; }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .status-badge::before {
      content: '';
      width: 6px;
      height: 6px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    .status-badge--pending  { background: rgba(254,200,67,0.15); color: #8a6000; }
    .status-badge--pending::before { background: #FEC843; }
    .status-badge--approved { background: rgba(63,211,213,0.12); color: #0a7e80; }
    .status-badge--approved::before { background: var(--teal); }
    .status-badge--rejected { background: rgba(233,41,93,0.1);  color: var(--pink); }
    .status-badge--rejected::before { background: var(--pink); }

    .date-cell {
      font-size: 0.75rem;
      color: var(--muted);
      white-space: nowrap;
    }

    .action-btn {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 6px 14px;
      border-radius: 999px;
      font-family: 'Raleway', sans-serif;
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      text-decoration: none;
      border: 1.5px solid var(--border);
      color: var(--black);
      background: var(--white);
      cursor: pointer;
      transition: background 0.15s, border-color 0.15s, color 0.15s;
    }

    .action-btn:hover {
      background: var(--pink-light);
      border-color: rgba(233,41,93,0.3);
      color: var(--pink);
    }

    .action-btn svg { width: 12px; height: 12px; }

    /* ── EMPTY STATE ── */
    .empty-state {
      padding: 48px 24px;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
    }

    .empty-state__icon {
      width: 64px;
      height: 64px;
      border-radius: 50%;
      background: var(--yellow-light);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 4px;
    }

    .empty-state__icon svg { width: 30px; height: 30px; color: var(--yellow); }

    .empty-state__title {
      font-size: 1rem;
      font-weight: 900;
      color: var(--black);
    }

    .empty-state__sub {
      font-size: 0.82rem;
      font-weight: 500;
      color: var(--muted);
    }

    /* ── BOTTOM GRID ── */
    .bottom-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-top: 24px;
    }

    .info-card {
      background: var(--white);
      border-radius: 20px;
      border: 1.5px solid var(--border);
      padding: 24px;
      animation: fadeUp 0.4s 0.35s ease both;
    }

    .info-card__title {
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 16px;
    }

    .coming-soon-inner {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 24px 0;
      text-align: center;
    }

    .coming-soon-pill {
      background: var(--yellow-light);
      color: #8a6000;
      font-size: 0.65rem;
      font-weight: 900;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 4px 12px;
      border-radius: 999px;
    }

    .coming-soon-title {
      font-size: 1rem;
      font-weight: 900;
      color: var(--black);
    }

    .coming-soon-sub {
      font-size: 0.78rem;
      font-weight: 500;
      color: var(--muted);
      max-width: 200px;
      line-height: 1.5;
    }

    .quick-links {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .quick-link {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 14px;
      border-radius: 12px;
      text-decoration: none;
      background: var(--off);
      border: 1.5px solid var(--border);
      transition: border-color 0.18s, transform 0.12s;
    }

    .quick-link:hover {
      border-color: rgba(233,41,93,0.25);
      transform: translateX(4px);
    }

    .quick-link__icon {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .quick-link__icon svg { width: 15px; height: 15px; }

    .quick-link__label {
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--black);
    }

    .quick-link__sub {
      font-size: 0.7rem;
      font-weight: 500;
      color: var(--muted);
    }

    .quick-link__arrow {
      margin-left: auto;
      color: var(--muted);
      flex-shrink: 0;
    }

    .quick-link__arrow svg { width: 14px; height: 14px; }

    /* ── ANIMATIONS ── */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(14px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    @keyframes slideDown {
      from { opacity: 0; transform: translateY(-10px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ── MOBILE ── */
    @media (max-width: 900px) {
      .layout { grid-template-columns: 1fr; }
      .sidebar { display: none; }
      .stats-grid { grid-template-columns: repeat(2, 1fr); }
      .bottom-grid { grid-template-columns: 1fr; }
      .topbar { padding: 14px 20px; }
      .main { padding: 20px 16px 48px; }
    }

    @media (max-width: 540px) {
      .stats-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    }
  </style>
</head>
<body>
  <div class="layout">

    <!-- ── SIDEBAR ── -->
    <aside class="sidebar">
      <div class="sidebar__brand">
        <div class="sidebar__logo">
          <span class="sidebar__logo-num">24</span>
          <span class="sidebar__logo-fps">fps.</span>
          <span class="sidebar__logo-dot"></span>
        </div>
        <div class="sidebar__tag">Decode Animation Lab</div>
        <div class="sidebar__admin-badge">
          <div class="sidebar__avatar">{adminUser?.username?.slice(0,2) ?? 'AD'}</div>
          <div class="sidebar__admin-info">
            <div class="sidebar__admin-name">{adminUser?.username ?? 'Admin'}</div>
            <div class="sidebar__admin-role">{adminUser?.role ?? 'admin'}</div>
          </div>
        </div>
      </div>

      <nav class="sidebar__nav">
        <span class="sidebar__section-label">Overview</span>
        <a href="/admin/dashboard" class="nav-item is-active">
          <span class="nav-item__icon">
            <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="7" height="7" rx="2" stroke="currentColor" stroke-width="2"/><rect x="14" y="3" width="7" height="7" rx="2" stroke="currentColor" stroke-width="2"/><rect x="3" y="14" width="7" height="7" rx="2" stroke="currentColor" stroke-width="2"/><rect x="14" y="14" width="7" height="7" rx="2" stroke="currentColor" stroke-width="2"/></svg>
          </span>
          Dashboard
        </a>

        <span class="sidebar__section-label">Members</span>
        <a href="/admin/members" class="nav-item">
          <span class="nav-item__icon">
            <svg viewBox="0 0 24 24" fill="none"><circle cx="9" cy="7" r="4" stroke="currentColor" stroke-width="2"/><path d="M3 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M16 3.13a4 4 0 0 1 0 7.75" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M21 21v-2a4 4 0 0 0-3-3.85" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </span>
          All Members
        </a>
        <a href="/admin/members?status=pending" class="nav-item">
          <span class="nav-item__icon">
            <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><path d="M12 6v6l4 2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </span>
          Pending Review
          {pendingCount && pendingCount > 0 && <span class="nav-item__badge">{pendingCount}</span>}
        </a>

        <span class="sidebar__section-label">Content</span>

        <a href="/admin/team" class="nav-item">
          <span class="nav-item__icon">
            <svg viewBox="0 0 24 24" fill="none"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="9" cy="7" r="4" stroke="currentColor" stroke-width="2"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </span>
          Team
          {publishedCount && publishedCount > 0 && <span class="nav-item__badge" style="background: var(--teal);">{publishedCount}</span>}
        </a>

        <a href="/admin/join" class="nav-item">
          <span class="nav-item__icon">
            <svg viewBox="0 0 24 24" fill="none"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="9" cy="7" r="4" stroke="currentColor" stroke-width="2"/><path d="M19 8v6M22 11h-6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </span>
          Join Applications
          {joinPendingCount && joinPendingCount > 0 && <span class="nav-item__badge">{joinPendingCount}</span>}
        </a>

        <a href="#" class="nav-item nav-item--coming">
          <span class="nav-item__icon">
            <svg viewBox="0 0 24 24" fill="none"><path d="M15 10l4.553-2.069A1 1 0 0 1 21 8.82v6.36a1 1 0 0 1-1.447.888L15 14M3 8a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </span>
          Projects
          <span class="nav-item__soon">Soon</span>
        </a>

        <a href="#" class="nav-item nav-item--coming">
          <span class="nav-item__icon">
            <svg viewBox="0 0 24 24" fill="none"><path d="M19 4H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2z" stroke="currentColor" stroke-width="2"/><path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </span>
          Events
          <span class="nav-item__soon">Soon</span>
        </a>

        <a href="#" class="nav-item nav-item--coming">
          <span class="nav-item__icon">
            <svg viewBox="0 0 24 24" fill="none"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke="currentColor" stroke-width="2"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </span>
          Blog
          <span class="nav-item__soon">Soon</span>
        </a>

        <a href="#" class="nav-item nav-item--coming">
          <span class="nav-item__icon">
            <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2"/><path d="M3 9h18M9 21V9" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </span>
          Gallery
          <span class="nav-item__soon">Soon</span>
        </a>

        <span class="sidebar__section-label">System</span>
        <a href="#" class="nav-item nav-item--coming">
          <span class="nav-item__icon">
            <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" stroke="currentColor" stroke-width="2"/></svg>
          </span>
          Settings
          <span class="nav-item__soon">Soon</span>
        </a>
      </nav>

      <div class="sidebar__footer">
        <form method="POST" action="/api/admin/logout">
          <button type="submit" class="logout-btn">
            <svg viewBox="0 0 24 24" fill="none"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M16 17l5-5-5-5M21 12H9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Sign Out
          </button>
        </form>
      </div>
    </aside>

    <!-- ── TOPBAR ── -->
    <header class="topbar">
      <div>
        <div class="topbar__title">Dashboard</div>
        <div class="topbar__sub">Welcome back, {adminUser?.username ?? 'Admin'} 👋</div>
      </div>
      <div class="topbar__actions">
        <a href="/admin/members?status=pending" class="btn-primary">
          <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><path d="M12 6v6l4 2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          Review Pending
          {pendingCount && pendingCount > 0 && <span style="background:white;color:var(--pink);border-radius:999px;padding:1px 7px;font-size:0.65rem;font-weight:900">{pendingCount}</span>}
        </a>
      </div>
    </header>

    <!-- ── MAIN ── -->
    <main class="main">

      {setupDone && (
        <div class="setup-toast" id="setupToast">
          <div class="setup-toast__icon">
            <svg viewBox="0 0 24 24" fill="none"><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/></svg>
          </div>
          <div class="setup-toast__text">
            <strong>Setup complete!</strong> Your admin account has been created. You're all set.
          </div>
          <button class="setup-toast__close" onclick="document.getElementById('setupToast').remove()">
            <svg viewBox="0 0 24 24" fill="none"><path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </button>
        </div>
      )}

      <!-- STATS -->
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-card__icon">
            <svg viewBox="0 0 24 24" fill="none"><circle cx="9" cy="7" r="4" stroke="currentColor" stroke-width="2"/><path d="M3 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </div>
          <div class="stat-card__num">{totalCount ?? 0}</div>
          <div class="stat-card__label">Total Submissions</div>
        </div>
        <div class="stat-card">
          <div class="stat-card__icon">
            <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><path d="M12 6v6l4 2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </div>
          <div class="stat-card__num">{pendingCount ?? 0}</div>
          <div class="stat-card__label">Pending Review</div>
        </div>
        <div class="stat-card">
          <div class="stat-card__icon">
            <svg viewBox="0 0 24 24" fill="none"><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/></svg>
          </div>
          <div class="stat-card__num">{approvedCount ?? 0}</div>
          <div class="stat-card__label">Approved</div>
        </div>
        <div class="stat-card">
          <div class="stat-card__icon">
            <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><path d="M15 9l-6 6M9 9l6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </div>
          <div class="stat-card__num">{rejectedCount ?? 0}</div>
          <div class="stat-card__label">Rejected</div>
        </div>
      </div>

      <!-- RECENT SUBMISSIONS -->
      <div class="section-header">
        <div class="section-header__left">
          <span class="section-dot" style="background:var(--pink)"></span>
          <div>
            <div class="section-title">Recent Submissions</div>
            <svg class="section-title-underline" viewBox="0 0 120 4" preserveAspectRatio="none">
              <path d="M2 3.5c18-2 60-3 116-1.5" stroke="#E9295D" stroke-width="2.5" stroke-linecap="round" fill="none"/>
            </svg>
          </div>
        </div>
        <a href="/admin/members" class="view-all">
          View All
          <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>

      <div class="submissions-card">
        {recentSubmissions && recentSubmissions.length > 0 ? (
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Member</th>
                  <th>Category</th>
                  <th>Status</th>
                  <th>Submitted</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                {recentSubmissions.map(s => (
                  <tr>
                    <td>
                      <div class="member-cell">
                        {s.photo_url
                          ? <img src={s.photo_url} alt={s.name} class="member-avatar" />
                          : <div class="member-avatar-initials">{s.name?.split(' ').map((w: string) => w[0]).slice(0,2).join('')}</div>
                        }
                        <div>
                          <div class="member-name">{s.name}</div>
                          <div class="member-role">{s.role}</div>
                        </div>
                      </div>
                    </td>
                    <td>
                      <span class={`category-badge category-badge--${s.category}`}>{s.category}</span>
                    </td>
                    <td>
                      <span class={`status-badge status-badge--${s.status}`}>{s.status}</span>
                    </td>
                    <td>
                      <span class="date-cell">
                        {new Date(s.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
                      </span>
                    </td>
                    <td>
                      <a href={`/admin/members/${s.id}`} class="action-btn">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/></svg>
                        Review
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <div class="empty-state">
            <div class="empty-state__icon">
              <svg viewBox="0 0 24 24" fill="none"><circle cx="9" cy="7" r="4" stroke="currentColor" stroke-width="2"/><path d="M3 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </div>
            <div class="empty-state__title">No submissions yet</div>
            <div class="empty-state__sub">When members fill out the join form, they'll appear here.</div>
          </div>
        )}
      </div>

      <!-- BOTTOM GRID -->
      <div class="bottom-grid">
        <!-- Quick Links -->
        <div class="info-card">
          <div class="info-card__title">Quick Links</div>
          <div class="quick-links">
            <a href="/admin/members?status=pending" class="quick-link">
              <div class="quick-link__icon" style="background:rgba(254,200,67,0.15);color:#8a6000">
                <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><path d="M12 6v6l4 2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              </div>
              <div>
                <div class="quick-link__label">Pending Submissions</div>
                <div class="quick-link__sub">{pendingCount ?? 0} waiting for review</div>
              </div>
              <div class="quick-link__arrow"><svg viewBox="0 0 24 24" fill="none"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></div>
            </a>
            <a href="/admin/members?status=approved" class="quick-link">
              <div class="quick-link__icon" style="background:rgba(63,211,213,0.12);color:#0a7e80">
                <svg viewBox="0 0 24 24" fill="none"><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/></svg>
              </div>
              <div>
                <div class="quick-link__label">Approved Members</div>
                <div class="quick-link__sub">{approvedCount ?? 0} live on the website</div>
              </div>
              <div class="quick-link__arrow"><svg viewBox="0 0 24 24" fill="none"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></div>
            </a>
            <a href="/join" target="_blank" class="quick-link">
              <div class="quick-link__icon" style="background:rgba(159,106,205,0.1);color:var(--purple)">
                <svg viewBox="0 0 24 24" fill="none"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M15 3h6v6M10 14L21 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              <div>
                <div class="quick-link__label">View Join Form</div>
                <div class="quick-link__sub">Open the public submission form</div>
              </div>
              <div class="quick-link__arrow"><svg viewBox="0 0 24 24" fill="none"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></div>
            </a>
          </div>
        </div>

        <!-- Coming Soon -->
        <div class="info-card">
          <div class="info-card__title">Content Management</div>
          <div class="coming-soon-inner">
            <div style="font-size:2.5rem">🎬</div>
            <div class="coming-soon-pill">Coming Soon</div>
            <div class="coming-soon-title">Projects, Events & Blog</div>
            <div class="coming-soon-sub">Content management tools are being built. Stay tuned.</div>
          </div>
        </div>
      </div>

    </main>
  </div>
</body>
</html>