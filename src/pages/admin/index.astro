---
export const prerender = false;

// If already logged in, redirect to dashboard
const token = Astro.cookies.get('admin_session')?.value;
if (token) {
  return Astro.redirect('/admin/dashboard');
}

const error = Astro.url.searchParams.get('error');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin — 24fps Studios</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --pink:    #E9295D;
      --teal:    #3FD3D5;
      --yellow:  #FFD600;
      --black:   #0A0A0A;
      --surface: #111111;
      --card:    #1A1A1A;
      --border:  #2A2A2A;
      --muted:   #666;
      --white:   #FFFFFF;
    }

    html, body {
      height: 100%;
      background: var(--black);
      color: var(--white);
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    /* ── Noise grain overlay ── */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 0;
    }

    /* ── Accent line top ── */
    .accent-bar {
      position: fixed;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--pink) 0%, var(--teal) 50%, var(--yellow) 100%);
      z-index: 10;
    }

    /* ── Layout ── */
    .page {
      position: relative;
      z-index: 1;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 40px 24px;
    }

    /* ── Brand mark ── */
    .brand {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      margin-bottom: 48px;
      animation: fadeUp 0.5s ease both;
    }

    .brand__logo {
      display: flex;
      align-items: baseline;
      gap: 0;
      line-height: 1;
    }

    .brand__num {
      font-size: 3.2rem;
      font-weight: 900;
      color: var(--white);
      letter-spacing: -0.03em;
    }

    .brand__fps {
      font-size: 3.2rem;
      font-weight: 900;
      color: var(--white);
      letter-spacing: -0.03em;
    }

    .brand__dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--yellow);
      margin-left: 4px;
      margin-bottom: 8px;
      flex-shrink: 0;
      align-self: flex-end;
    }

    .brand__tag {
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.2em;
      color: var(--muted);
      text-transform: uppercase;
      border: 1px solid #2a2a2a;
      padding: 4px 10px;
    }

    /* ── Login card ── */
    .card {
      width: 100%;
      max-width: 420px;
      background: var(--card);
      border: 1px solid var(--border);
      padding: 40px 40px 36px;
      animation: fadeUp 0.5s 0.1s ease both;
    }

    .card__label {
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--pink);
      margin-bottom: 10px;
    }

    .card__title {
      font-size: 1.55rem;
      font-weight: 900;
      letter-spacing: -0.02em;
      color: var(--white);
      margin-bottom: 32px;
      line-height: 1.15;
    }

    /* ── Error ── */
    .error-msg {
      background: rgba(233, 41, 93, 0.1);
      border: 1px solid rgba(233, 41, 93, 0.35);
      color: #ff6b8a;
      font-size: 0.8rem;
      font-weight: 600;
      padding: 10px 14px;
      margin-bottom: 24px;
      letter-spacing: 0.01em;
    }

    /* ── Form fields ── */
    .field {
      display: flex;
      flex-direction: column;
      gap: 7px;
      margin-bottom: 20px;
    }

    .field:last-of-type { margin-bottom: 28px; }

    .field label {
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .field input {
      background: var(--surface);
      border: 1px solid var(--border);
      color: var(--white);
      font-size: 0.95rem;
      font-weight: 500;
      padding: 12px 14px;
      outline: none;
      transition: border-color 0.18s;
      font-family: inherit;
    }

    .field input:focus {
      border-color: var(--pink);
    }

    .field input::placeholder { color: #444; }

    /* ── Submit button ── */
    .btn-login {
      width: 100%;
      background: var(--pink);
      color: var(--white);
      border: none;
      font-size: 0.8rem;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      padding: 14px 24px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      transition: background 0.18s, transform 0.12s;
      font-family: inherit;
    }

    .btn-login:hover  { background: #d4224f; }
    .btn-login:active { transform: scale(0.99); }

    .btn-login.is-loading {
      pointer-events: none;
      opacity: 0.7;
    }

    .spinner {
      display: none;
      width: 16px; height: 16px;
      border: 2px solid rgba(255,255,255,0.3);
      border-top-color: white;
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
    }

    .btn-login.is-loading .spinner  { display: block; }
    .btn-login.is-loading .btn-text { display: none; }

    /* ── Footer note ── */
    .page-foot {
      margin-top: 28px;
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      color: #333;
      text-transform: uppercase;
      animation: fadeUp 0.5s 0.2s ease both;
    }

    /* ── Animations ── */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(16px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    @keyframes spin { to { transform: rotate(360deg); } }
  </style>
</head>
<body>
  <div class="accent-bar"></div>

  <main class="page">
    <!-- Brand -->
    <div class="brand">
      <div class="brand__logo">
        <span class="brand__num">24</span>
        <span class="brand__fps">fps.</span>
        <span class="brand__dot"></span>
      </div>
      <span class="brand__tag">Decode Animation Lab</span>
    </div>

    <!-- Card -->
    <div class="card">
      <p class="card__label">Internal System</p>
      <h1 class="card__title">Admin Access</h1>

      {error && (
        <div class="error-msg">
          {error === 'invalid' ? 'Invalid username or password.' : 'Something went wrong. Try again.'}
        </div>
      )}

      <form id="loginForm">
        <div class="field">
          <label for="username">Username</label>
          <input
            id="username"
            name="username"
            type="text"
            placeholder="Enter username"
            autocomplete="username"
            required
          />
        </div>

        <div class="field">
          <label for="password">Password</label>
          <input
            id="password"
            name="password"
            type="password"
            placeholder="••••••••"
            autocomplete="current-password"
            required
          />
        </div>

        <button type="submit" class="btn-login" id="submitBtn">
          <span class="btn-text">Sign In</span>
          <span class="spinner"></span>
        </button>
      </form>
    </div>

    <p class="page-foot">24fps Studios &mdash; Internal Use Only</p>
  </main>

  <script>
    const form = document.getElementById('loginForm');
    const btn  = document.getElementById('submitBtn');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      btn.classList.add('is-loading');

      const data = new FormData(form);

      const res = await fetch('/api/admin/login', {
        method: 'POST',
        body: data,
      });

      if (res.ok) {
        window.location.href = '/admin/dashboard';
      } else {
        window.location.href = '/admin?error=invalid';
      }
    });
  </script>
</body>
</html>
