---
// src/pages/blog.astro
// /blog is retired in favor of /feed — this keeps old links, bookmarks,
// and anyone typing /blog from hitting a 404. 301 (permanent) tells
// search engines and browsers to treat /feed as the real address going
// forward, so this can just sit here quietly and never need touching again.
export const prerender = false;
return Astro.redirect('/feed', 301);
---
