---
// src/pages/feed.astro
// Public blog/feed page. Reads only status='published' rows via the
// anon Supabase client — RLS on blog_posts guarantees drafts never
// leak here even if this query were tampered with client-side.
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { createClient } from '@supabase/supabase-js';
import { BLOG_CATEGORIES } from '../lib/blog-utils';

const runtimeEnv = (Astro.locals as any).runtime?.env;
const supabaseUrl = runtimeEnv?.PUBLIC_SUPABASE_URL ?? import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseAnonKey = runtimeEnv?.PUBLIC_SUPABASE_ANON_KEY ?? import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
const supabase = createClient(supabaseUrl, supabaseAnonKey);

const activeCategory = Astro.url.searchParams.get('category') || 'all';

const { data: allPosts, error } = await supabase
  .from('blog_posts')
  .select('id, slug, title, excerpt, cover_image_url, category, tags, featured, author_name, author_avatar_url, read_minutes, published_at')
  .eq('status', 'published')
  .order('published_at', { ascending: false });

const posts = allPosts || [];

const featuredPost = posts.find((p) => p.featured) || posts[0] || null;
const restPosts = posts.filter((p) => p.id !== featuredPost?.id);

const filteredRest = activeCategory === 'all'
  ? restPosts
  : restPosts.filter((p) => p.category === activeCategory);

function formatDate(dateStr: string | null) {
  if (!dateStr) return '';
  return new Date(dateStr).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
}

function initialsFor(name: string | null) {
  return (name || '?')
    .split(/\s+/)
    .filter(Boolean)
    .map((w) => w[0]?.toUpperCase())
    .slice(0, 2)
    .join('');
}

const categoryCounts: Record<string, number> = {};
restPosts.forEach((p) => { categoryCounts[p.category] = (categoryCounts[p.category] || 0) + 1; });
---

<BaseLayout title="The Frame Feed" description="Stories, ideas, and behind-the-scenes updates from the 24fps community.">
  <div class="feed-page">
    <header class="feed-hero">
      <span class="feed-hero__eyebrow">The Frame Feed</span>
      <h1 class="feed-hero__title">Stories. Ideas.<br/>Frames. <span class="feed-hero__accent">Realized.</span></h1>
      <p class="feed-hero__sub">Insights, tutorials, behind-the-scenes, and studio updates from the 24fps community.</p>
    </header>

    {error && <p class="feed-error">Couldn't load stories right now. Please try again shortly.</p>}

    <nav class="category-pills" aria-label="Filter by category">
      <a href="/feed" class={`category-pill ${activeCategory === 'all' ? 'is-active' : ''}`}>All</a>
      {BLOG_CATEGORIES.map((c) => (
        <a href={`/feed?category=${c.value}`} class={`category-pill ${activeCategory === c.value ? 'is-active' : ''}`}>
          {c.label}{categoryCounts[c.value] ? ` (${categoryCounts[c.value]})` : ''}
        </a>
      ))}
    </nav>

    {featuredPost && activeCategory === 'all' && (
      <a href={`/feed/${featuredPost.slug}`} class="featured-card">
        <div class="featured-card__badge">Featured Story</div>
        <div class="featured-card__media">
          {featuredPost.cover_image_url && <img src={featuredPost.cover_image_url} alt="" />}
        </div>
        <div class="featured-card__body">
          <h2 class="featured-card__title">{featuredPost.title}</h2>
          {featuredPost.excerpt && <p class="featured-card__excerpt">{featuredPost.excerpt}</p>}
          <div class="featured-card__meta">
            <span class="avatar-initials">{initialsFor(featuredPost.author_name)}</span>
            <span>{featuredPost.author_name || '24fps'}</span>
            <span class="dot">·</span>
            <span>{formatDate(featuredPost.published_at)}</span>
            {featuredPost.read_minutes && <><span class="dot">·</span><span>{featuredPost.read_minutes} min read</span></>}
          </div>
        </div>
      </a>
    )}

    <section class="latest-section">
      <h2 class="latest-section__title">{activeCategory === 'all' ? 'Latest Stories' : `${BLOG_CATEGORIES.find(c => c.value === activeCategory)?.label || activeCategory} Stories`}</h2>

      {filteredRest.length > 0 ? (
        <div class="posts-grid">
          {filteredRest.map((post) => (
            <a href={`/feed/${post.slug}`} class="post-card">
              <div class="post-card__media">
                {post.cover_image_url
                  ? <img src={post.cover_image_url} alt="" loading="lazy" />
                  : <div class="post-card__media-fallback" />}
                <span class="post-card__category">{post.category}</span>
              </div>
              <div class="post-card__body">
                <h3 class="post-card__title">{post.title}</h3>
                {post.excerpt && <p class="post-card__excerpt">{post.excerpt}</p>}
                <div class="post-card__meta">
                  <span class="avatar-initials avatar-initials--sm">{initialsFor(post.author_name)}</span>
                  <span>{post.author_name || '24fps'}</span>
                  <span class="dot">·</span>
                  <span>{formatDate(post.published_at)}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p>No stories in this category yet — check back soon.</p>
        </div>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .feed-page { max-width: 1180px; margin: 0 auto; padding: 3rem 1.5rem 5rem; }

  .feed-hero { text-align: center; margin-bottom: 2.5rem; }
  .feed-hero__eyebrow {
    display: inline-block; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.14em;
    text-transform: uppercase; color: #E9295D; margin-bottom: 0.75rem;
  }
  .feed-hero__title { font-size: clamp(2rem, 5vw, 3.2rem); font-weight: 900; letter-spacing: -0.02em; line-height: 1.1; color: #1A1A1A; }
  .feed-hero__accent { color: #E9295D; }
  .feed-hero__sub { font-size: 1rem; color: #6B7280; margin-top: 1rem; max-width: 46ch; margin-left: auto; margin-right: auto; }

  .feed-error { text-align: center; color: #E9295D; font-weight: 700; margin-bottom: 1.5rem; }

  .category-pills { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; margin-bottom: 2.5rem; }
  .category-pill {
    padding: 8px 16px; border-radius: 999px; border: 1.5px solid rgba(26,26,26,0.12);
    background: white; color: #1A1A1A; text-decoration: none; font-size: 0.82rem; font-weight: 700;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }
  .category-pill:hover { border-color: #E9295D; }
  .category-pill.is-active { background: #1A1A1A; color: white; border-color: #1A1A1A; }

  .featured-card {
    display: grid; grid-template-columns: 1.15fr 1fr; gap: 0; border-radius: 20px; overflow: hidden;
    text-decoration: none; color: inherit; background: #1A1A1A; margin-bottom: 3rem;
    box-shadow: 0 20px 40px rgba(0,0,0,0.12); position: relative;
  }
  .featured-card__badge {
    position: absolute; top: 20px; left: 20px; background: #E9295D; color: white;
    font-size: 0.65rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase;
    padding: 6px 14px; border-radius: 999px; z-index: 2;
  }
  .featured-card__media { position: relative; min-height: 280px; background: linear-gradient(135deg, #3FD3D5, #9F6ACD); }
  .featured-card__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .featured-card__body { padding: 2rem; display: flex; flex-direction: column; justify-content: center; color: white; }
  .featured-card__title { font-size: 1.6rem; font-weight: 900; line-height: 1.25; margin-bottom: 0.75rem; }
  .featured-card__excerpt { font-size: 0.95rem; color: rgba(255,255,255,0.75); line-height: 1.6; margin-bottom: 1.25rem; }
  .featured-card__meta { display: flex; align-items: center; gap: 8px; font-size: 0.8rem; color: rgba(255,255,255,0.7); font-weight: 600; }
  .featured-card__meta .dot { opacity: 0.5; }

  .avatar-initials {
    width: 26px; height: 26px; border-radius: 50%; background: linear-gradient(135deg, #E9295D, #9F6ACD);
    color: white; display: flex; align-items: center; justify-content: center;
    font-size: 0.65rem; font-weight: 800; flex-shrink: 0;
  }
  .avatar-initials--sm { width: 22px; height: 22px; font-size: 0.6rem; }

  .latest-section__title { font-size: 1.3rem; font-weight: 900; margin-bottom: 1.5rem; }

  .posts-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; }
  .post-card { text-decoration: none; color: inherit; border-radius: 16px; overflow: hidden; background: white; border: 1.5px solid rgba(26,26,26,0.08); transition: transform 0.18s, box-shadow 0.18s; }
  .post-card:hover { transform: translateY(-3px); box-shadow: 0 12px 28px rgba(0,0,0,0.08); }
  .post-card__media { position: relative; aspect-ratio: 16/10; background: #F8F5F5; }
  .post-card__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .post-card__media-fallback { width: 100%; height: 100%; background: linear-gradient(135deg, #FFCCD9, #E8D5F5); }
  .post-card__category {
    position: absolute; top: 10px; left: 10px; background: rgba(255,255,255,0.92); color: #1A1A1A;
    font-size: 0.62rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em;
    padding: 4px 10px; border-radius: 999px;
  }
  .post-card__body { padding: 1.1rem 1.2rem 1.3rem; }
  .post-card__title { font-size: 1.02rem; font-weight: 800; line-height: 1.35; margin-bottom: 0.5rem; }
  .post-card__excerpt { font-size: 0.85rem; color: #6B7280; line-height: 1.55; margin-bottom: 0.9rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .post-card__meta { display: flex; align-items: center; gap: 6px; font-size: 0.75rem; color: #6B7280; font-weight: 600; }
  .post-card__meta .dot { opacity: 0.5; }

  .empty-state { text-align: center; padding: 4rem 1rem; color: #6B7280; }

  @media (max-width: 800px) {
    .featured-card { grid-template-columns: 1fr; }
    .featured-card__media { min-height: 200px; }
  }
</style>
