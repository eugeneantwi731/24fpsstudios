---
import BaseLayout from '../layouts/BaseLayout.astro';
import { hero } from '../data/home.js';

const decodeCreateInspire = '/images/decode-create-inpire.svg';
const heroIllustration = '/images/24fps-illustration-trim.png'; // artwork only, empty margins trimmed
---

<BaseLayout title="Home">
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-copy">
        <img
          src={decodeCreateInspire}
          alt="Decode. Create. Inspire."
          class="hero-headline"
          width="1200"
          height="750"
        />

        <p class="hero-sub">{hero.sub}</p>

        <div class="hero-actions">
          <button type="button" class="btn btn--primary" id="reel-btn" data-reel={hero.reelUrl}>
            <span class="btn__label">Watch demo reel</span>
            <span class="btn__icon btn__icon--play" aria-hidden="true">
              <svg class="btn__glyph" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M5.1 2.9v10.2a.55.55 0 0 0 .83.47l8.2-5.1a.55.55 0 0 0 0-.94l-8.2-5.1a.55.55 0 0 0-.83.47z"/></svg>
              <svg class="btn__glyph btn__glyph--in" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M5.1 2.9v10.2a.55.55 0 0 0 .83.47l8.2-5.1a.55.55 0 0 0 0-.94l-8.2-5.1a.55.55 0 0 0-.83.47z"/></svg>
            </span>
          </button>
          <a href="/work" class="btn btn--glass">
            <span class="btn__label">Explore our work</span>
            <span class="btn__icon btn__icon--arrow" aria-hidden="true">
              <svg class="btn__glyph" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.5 8h10.2M8.4 3.6 12.8 8l-4.4 4.4" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <svg class="btn__glyph btn__glyph--in" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.5 8h10.2M8.4 3.6 12.8 8l-4.4 4.4" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </a>
        </div>

        <button type="button" class="scroll-cue" id="scroll-cue" aria-label="Scroll down">
        <svg class="scroll-cue__arrow" viewBox="0 0 15.89 39.23" fill="none" aria-hidden="true">
          <path class="scroll-cue__line" pathLength="1" d="M1.68 0.87c-1.16,6.38 -2.28,16.94 5.91,19.17 8.3,2.26 10.25,-11.77 2.78,-8.44 -4.81,2.15 -4.68,9.95 -3.75,14.26 0.91,4.24 2.54,8.58 4.4,12.49" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          <path class="scroll-cue__head" d="M14.6 29.4C13.56 31.69 11.52 36.09 11.02 38.35C11.02 38.35 3.6 34.26 2.58 33.23" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="scroll-cue__label">Scroll down</span>
      </button>
      </div>

      <div class="hero-visual">
        <img
          src={heroIllustration}
          alt="24fps animators and illustrators at work, sketching on tablets"
          class="hero-illustration"
          width="1060"
          height="922"
        />
      </div>
    </div>
  </section>

  <dialog class="reel-dialog" id="reel-dialog" aria-label="Demo reel">
    <button type="button" class="reel-close" id="reel-close" aria-label="Close">
      <svg viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 2l8 8M10 2l-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
    <div class="reel-stage" id="reel-stage"></div>
  </dialog>
</BaseLayout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&display=swap');

  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    height: 100svh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start; /* content hugs the navbar instead of floating in the middle */
    padding: 104px 3vw 20px;
  }

  .hero-inner {
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    display: grid;
    /* minmax(0, …) lets the text column shrink below its content width: the
       buttons are allowed to run on into the illustration instead of forcing the
       column wider and shrinking the artwork. */
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.32fr);
    align-items: center;
    gap: 0;
  }

  .hero-copy {
    align-self: start;                     /* sits high, under the navbar */
    padding-top: clamp(6px, 1.6vh, 22px);
    position: relative;
    z-index: 2; /* above the illustration, so the buttons can overlap its edge */
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .hero-headline {
    width: 112%;
    max-width: none;
    height: auto;
    display: block;
    position: relative;
    z-index: 1;
  }

  /* ── Short line + buttons under the lettering ── */
  .hero-sub {
    font-family: 'Raleway', sans-serif;
    font-weight: 500;
    font-size: clamp(1rem, 1.25vw, 1.2rem);
    line-height: 1.55;
    color: #4B4B4B;
    max-width: 34ch;
    margin: 0;
  }

  .hero-actions {
    display: flex;
    flex-wrap: nowrap; /* one row; overlaps the illustration slightly on mid-size screens */
    align-items: center;
    gap: 1rem 1.15rem;
    margin-top: 0.35rem;
  }

  /* ── Buttons ─────────────────────────────────────────────────────────
     Pink pill (primary) and frosted-glass pill, each with a round white
     icon well on the right. On hover the icon slides out and a fresh copy
     slides in from the left. */
  .btn {
    --ease: cubic-bezier(0.65, 0, 0.25, 1);
    --h: 60px;                       /* button height; everything else scales from it */
    --icon: calc(var(--h) - 16px);   /* round icon well */
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    gap: 1.6rem;
    height: var(--h);
    padding: 0 8px 0 calc(var(--h) * 0.32);
    font-family: 'Raleway', sans-serif;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.005em;
    line-height: 1;
    white-space: nowrap;
    border-radius: 999px;
    border: 0;
    cursor: pointer;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      transform 0.45s var(--ease),
      box-shadow 0.45s var(--ease),
      filter 0.45s var(--ease),
      background-position 0.7s var(--ease);
  }
  .btn:hover { transform: translateY(-2px); }
  .btn:active { transform: translateY(0) scale(0.975); transition-duration: 0.1s; }
  .btn:focus-visible { outline: 3px solid #3FD3D5; outline-offset: 4px; }

  /* Pink */
  .btn--primary {
    color: #fff;
    background: linear-gradient(180deg, #EE3A6B 0%, #E0245A 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.28),
      0 14px 30px -8px rgba(233, 41, 93, 0.55),
      0 3px 8px rgba(233, 41, 93, 0.25);
  }
  .btn--primary:hover {
    filter: brightness(1.07) saturate(1.05);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.32),
      0 20px 38px -8px rgba(233, 41, 93, 0.62),
      0 4px 10px rgba(233, 41, 93, 0.3);
  }

  /* Frosted glass: white that isn't pure white. It starts at clean white on the
     left and eases to a slightly warmer off-white on the right, with a bright
     edge and a soft shadow. Backdrop blur takes over when it sits on artwork. */
  .btn--glass {
    color: #1A1A1A;
    background: linear-gradient(100deg, rgba(255, 255, 255, 0.97) 0%, rgba(255, 255, 255, 0.9) 45%, rgba(250, 245, 234, 0.88) 100%);
    background-size: 140% 100%;
    background-position: 0 0;
    -webkit-backdrop-filter: blur(18px) saturate(1.5);
    backdrop-filter: blur(18px) saturate(1.5);
    box-shadow:
      inset 0 1.5px 0 rgba(255, 255, 255, 1),
      inset 0 -1px 0 rgba(255, 255, 255, 0.6),
      0 0 0 1px rgba(255, 255, 255, 0.8),
      0 14px 30px -10px rgba(233, 41, 93, 0.24),
      0 3px 8px rgba(40, 30, 60, 0.06);
  }
  .btn--glass:hover {
    background-position: 100% 0;
    box-shadow:
      inset 0 1.5px 0 rgba(255, 255, 255, 1),
      inset 0 -1px 0 rgba(255, 255, 255, 0.6),
      0 0 0 1px rgba(255, 255, 255, 0.9),
      0 20px 38px -10px rgba(233, 41, 93, 0.3),
      0 4px 10px rgba(40, 30, 60, 0.08);
  }

  /* Round icon well */
  .btn__icon {
    position: relative;
    flex-shrink: 0;
    width: var(--icon);
    height: var(--icon);
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.14);
    transition: transform 0.45s var(--ease), background-color 0.45s var(--ease), color 0.45s var(--ease);
  }
  .btn__icon--play  { color: #E9295D; }
  .btn__icon--arrow { color: #1A1A1A; }

  .btn__glyph {
    grid-area: 1 / 1;
    width: calc(var(--icon) * 0.41);
    height: calc(var(--icon) * 0.41);
    display: block;
    transition: transform 0.55s var(--ease);
  }
  .btn__icon--play .btn__glyph { margin-left: 2px; } /* optical centre for a triangle */

  /* The spare copy waits off to the left... */
  .btn__glyph--in { transform: translateX(calc(-1 * var(--icon))); }

  /* ...and on hover the old one exits right while the new one slides in. */
  .btn:hover .btn__glyph:not(.btn__glyph--in) { transform: translateX(var(--icon)); }
  .btn:hover .btn__glyph--in { transform: translateX(0); }

  .btn--primary:hover .btn__icon { transform: scale(1.06); }

  /* Glass: the arrow well fills pink */
  .btn--glass:hover .btn__icon { background: #E9295D; color: #fff; transform: scale(1.06); }

  @media (min-width: 1200px) {
    .btn {
      --h: clamp(70px, 4vw, 84px);
      font-size: clamp(1.1rem, 0.45vw + 0.7rem, 1.3rem);
      gap: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn, .btn__icon, .btn__glyph { transition: none; }
    .btn:hover, .btn:active, .btn--primary:hover .btn__icon, .btn--glass:hover .btn__icon { transform: none; }
    .btn:hover .btn__glyph:not(.btn__glyph--in) { transform: none; }
    .btn__glyph--in, .btn:hover .btn__glyph--in { display: none; }
  }

  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-illustration {
    width: auto;
    max-width: 100%;
    /* As large as the column allows, but never taller than the space between the
       navbar and the bottom of the window, so the whole hero is visible on load. */
    max-height: calc(100svh - 132px);
    height: auto;
    display: block;
  }

  /* ── Scroll cue (bottom centre of the hero) ── */
  .scroll-cue {
    /* Sits a small fixed distance under the buttons. The text column is 40% of the
       row, so 125% of its width lands on the centre of the page. */
    position: absolute;
    left: 125%;
    top: calc(100% + 24px);
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.95rem;
    padding: 0.2rem 0.6rem;
    background: none;
    border: none;
    color: #1A1A1A;
    cursor: pointer;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .scroll-cue__label {
    font-family: 'DM Mono', ui-monospace, 'SFMono-Regular', 'Cascadia Mono', Menlo, Consolas, monospace;
    font-size: 0.8rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color 0.2s;
  }

  .scroll-cue__arrow {
    width: 19px;
    height: 47px;
    flex-shrink: 0;
    transition: color 0.2s;
  }

  /* The stroke is drawn with a dash the length of the whole path, so it can be
     retracted and redrawn on click (see the script). */
  .scroll-cue__line {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .scroll-cue:hover .scroll-cue__label { color: #E9295D; }
  .scroll-cue:hover .scroll-cue__arrow { color: #E9295D; }

  .scroll-cue:focus-visible {
    outline: 3px solid #3FD3D5;
    outline-offset: 3px;
    border-radius: 12px;
  }

  .scroll-cue.is-hidden {
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%) translateY(8px);
  }

  /* ── Demo reel dialog ── */
  .reel-dialog {
    border: none;
    padding: 0;
    margin: auto;
    background: transparent;
    width: min(960px, 92vw);
    max-width: none;
    overflow: visible;
  }
  .reel-dialog::backdrop { background: rgba(10, 10, 10, 0.78); }

  .reel-close {
    position: absolute;
    top: -44px;
    right: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: none;
    background: #fff;
    color: #1A1A1A;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .reel-close svg { width: 12px; height: 12px; }

  .reel-stage {
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
  }

  @media (max-width: 960px) {
    .scroll-cue {
      position: static;
      transform: none;
      margin: 22px auto 0;
    }
    .scroll-cue.is-hidden { transform: translateY(8px); }

    .hero {
      height: auto;
      overflow: visible;
    }

    .hero-inner {
      grid-template-columns: 1fr;
      gap: 1rem;
      text-align: center;
    }

    .hero-copy {
      align-items: center;
      order: 1;
    }

    .hero-sub { max-width: 40ch; }
    .hero-actions { justify-content: center; flex-wrap: wrap; }

    .hero-headline {
      width: 100%;
      max-width: 520px;
      margin: 0 auto;
    }

    .hero-visual {
      order: 2;
    }

    .hero-illustration {
      max-width: 460px;
      max-height: none;
    }
  }

  @media (max-width: 560px) {
    .hero {
      padding: 96px 5vw 3rem;
    }

    .scroll-cue__label { font-size: 0.72rem; letter-spacing: 0.12em; }

    .hero-headline {
      max-width: 360px;
    }

    .hero-illustration {
      max-width: 320px;
    }

    .hero-actions { width: 100%; flex-direction: column; align-items: stretch; max-width: 340px; }
    .btn { justify-content: space-between; }
  }
</style>

<script>
  const btn = document.getElementById('reel-btn') as HTMLButtonElement | null;
  const dialog = document.getElementById('reel-dialog') as HTMLDialogElement | null;
  const stage = document.getElementById('reel-stage');
  const closeBtn = document.getElementById('reel-close');

  function youtubeId(url: string): string | null {
    const m = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([\w-]{11})/);
    return m ? m[1] : null;
  }

  function render(url: string) {
    if (!stage) return;
    stage.innerHTML = '';

    if (!url) {
      const note = document.createElement('div');
      note.style.cssText = 'padding:3rem 2rem;text-align:center;font-family:Raleway,sans-serif;';
      note.innerHTML =
        '<p style="font-size:1.4rem;font-weight:900;margin:0 0 .5rem;">Our reel is on its way.</p>' +
        '<p style="color:#6B7280;margin:0;">We\'re cutting it together. Check back soon.</p>';
      stage.appendChild(note);
      return;
    }

    const yt = youtubeId(url);
    if (yt) {
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube.com/embed/${yt}?autoplay=1&rel=0`;
      frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      frame.allowFullscreen = true;
      frame.title = 'Demo reel';
      frame.style.cssText = 'display:block;width:100%;aspect-ratio:16/9;border:0;';
      stage.appendChild(frame);
    } else {
      const video = document.createElement('video');
      video.src = url;
      video.controls = true;
      video.autoplay = true;
      video.playsInline = true;
      video.style.cssText = 'display:block;width:100%;aspect-ratio:16/9;background:#000;';
      stage.appendChild(video);
    }
  }

  function close() {
    dialog?.close();
  }

  btn?.addEventListener('click', () => {
    render(btn.dataset.reel || '');
    dialog?.showModal();
  });

  closeBtn?.addEventListener('click', close);

  // Click on the dark backdrop closes it; closing also stops playback.
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) close();
  });
  dialog?.addEventListener('close', () => {
    if (stage) stage.innerHTML = '';
  });

  // Scroll cue: jump past the hero, and fade away once the visitor scrolls.
  const cue = document.getElementById('scroll-cue');
  const heroEl = document.querySelector('.hero') as HTMLElement | null;

  const stem = cue?.querySelector('.scroll-cue__line') as SVGPathElement | null;
  const head = cue?.querySelector('.scroll-cue__head') as SVGPathElement | null;
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let raf = 0;

  // Hover / keyboard focus: the line trims itself on along its path. The arrowhead
  // is a separate piece that rides the leading point (turning with the curve),
  // small while the line is drawing, then grows to full size once it arrives.
  // Nothing fades.
  const TIP = { x: 11.02, y: 38.35 };   // the arrow tip, in the SVG's own coordinates
  const SMALL = 0.28;                    // head scale while travelling
  const DRAW = 900;                      // ms to trim the line on
  const GROW = 320;                      // ms for the head to grow at the end

  const easeInOut = (u: number) => -(Math.cos(Math.PI * u) - 1) / 2; // sine in-out: gentle at both ends
  const backOut = (u: number) => { const c1 = 1.4, c3 = c1 + 1; return 1 + c3 * Math.pow(u - 1, 3) + c1 * Math.pow(u - 1, 2); };

  const draw = () => {
    if (!stem || !head || calm) return;
    cancelAnimationFrame(raf);

    const L = stem.getTotalLength();
    const angleAt = (len: number) => {
      const a = stem.getPointAtLength(Math.max(0, len - 0.4));
      const b = stem.getPointAtLength(Math.min(L, len + 0.4));
      return (Math.atan2(b.y - a.y, b.x - a.x) * 180) / Math.PI;
    };
    const finalAngle = angleAt(L);
    const place = (len: number, scale: number) => {
      const pt = stem.getPointAtLength(len);
      head.setAttribute(
        'transform',
        `translate(${pt.x} ${pt.y}) rotate(${angleAt(len) - finalAngle}) scale(${scale}) translate(${-TIP.x} ${-TIP.y})`
      );
    };
    const rest = () => {
      stem.style.strokeDashoffset = '';
      head.removeAttribute('transform');
    };

    const t0 = performance.now();
    const step = (now: number) => {
      const t = now - t0;
      if (t < DRAW) {
        const p = easeInOut(t / DRAW);
        stem.style.strokeDashoffset = String(1.02 * (1 - p));
        place(p * L, SMALL);
      } else if (t < DRAW + GROW) {
        stem.style.strokeDashoffset = '0';
        place(L, SMALL + (1 - SMALL) * backOut((t - DRAW) / GROW));
      } else {
        rest();
        return;
      }
      raf = requestAnimationFrame(step);
    };
    raf = requestAnimationFrame(step);
  };
  cue?.addEventListener('pointerenter', draw);
  cue?.addEventListener('focus', draw);

  cue?.addEventListener('click', () => {
    const top = heroEl ? heroEl.offsetTop + heroEl.offsetHeight : window.innerHeight;
    window.scrollTo({ top, behavior: calm ? 'auto' : 'smooth' });
  });

  const toggleCue = () => cue?.classList.toggle('is-hidden', window.scrollY > 60);
  window.addEventListener('scroll', toggleCue, { passive: true });
  toggleCue();
</script>
