  .submit-btn { display: inline-flex; align-items: center; gap: 10px; background: var(--pink); color: white; font-family: 'Raleway', sans-serif; font-size: 0.88rem; font-weight: 900; letter-spacing: 0.08em; padding: 15px 30px; border: none; border-radius: 999px; cursor: pointer; box-shadow: 0 4px 20px rgba(233,41,93,0.4); transition: background 0.2s, transform 0.15s, box-shadow 0.2s; }
