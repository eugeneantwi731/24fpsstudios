  .photo-preview-card:hover .preview-delete[data-has-photo="true"], .photo-preview-card:focus-within .preview-delete[data-has-photo="true"] { display: flex; }
  .photo-preview-card .preview-delete:hover { background: rgba(254,200,67,0.6); }
