  /* ────────────────────────────────────────
     PHOTO UPLOAD + CROP
  ──────────────────────────────────────── */
  const photoInput     = document.getElementById('photo');
  const uploadZone     = document.getElementById('upload-zone');
  const uploadUi       = document.getElementById('upload-ui');
  const avatarPreview  = document.getElementById('avatar-preview-img');
  const previewDelete  = document.getElementById('preview-delete');
  const cropOverlay    = document.getElementById('crop-overlay');
  const cropCanvas     = document.getElementById('crop-canvas');
  const cropWrap       = document.getElementById('crop-canvas-wrap');
  const cropZoom       = document.getElementById('crop-zoom');
  const cropCancel     = document.getElementById('crop-cancel');
  const cropConfirm    = document.getElementById('crop-confirm');

  // Holds the final cropped blob for submission
  let croppedBlob = null;
  let originalPhotoName = '';

  // Cropper state
  let cropImg = null, cropScale = 1, cropOffX = 0, cropOffY = 0;
  let cropDragging = false, dragStartX = 0, dragStartY = 0, dragOffX = 0, dragOffY = 0;

  function drawCrop() {
    const size = cropCanvas.width;
    const ctx = cropCanvas.getContext('2d');
    ctx.clearRect(0, 0, size, size);
    const sw = cropImg.naturalWidth * cropScale;
    const sh = cropImg.naturalHeight * cropScale;
    ctx.drawImage(cropImg, cropOffX + (size - sw) / 2, cropOffY + (size - sh) / 2, sw, sh);
  }

  let cropObjectUrl = null; // track URL so we can revoke it later

  function openCropper(file) {
    if (cropObjectUrl) URL.revokeObjectURL(cropObjectUrl);
    cropObjectUrl = URL.createObjectURL(file);
    cropImg = new Image();
    cropImg.onload = () => {
      // Show the overlay FIRST so the wrap has real layout dimensions,
      // then measure and draw on the next animation frame.
      cropOverlay.style.display = 'flex';
      requestAnimationFrame(() => {
        const dpr = window.devicePixelRatio || 1;
        const displayPx = cropWrap.clientWidth;   // now non-zero
        const s = Math.round(displayPx * dpr);
        cropCanvas.width  = s;
        cropCanvas.height = s;
        // cover: image fills the full square
        const ratio = Math.max(s / cropImg.naturalWidth, s / cropImg.naturalHeight);
        cropScale = ratio;
        cropZoom.min   = ratio;
        cropZoom.max   = ratio * 3;
        cropZoom.step  = ratio * 0.01;
        cropZoom.value = ratio;
        cropOffX = 0; cropOffY = 0;
        drawCrop();
        // Do NOT revoke cropObjectUrl here — canvas still needs it for redraws
      });
    };
    cropImg.src = cropObjectUrl;
  }

  cropZoom.addEventListener('input', () => {
    cropScale = parseFloat(cropZoom.value);
    clampOffset();
    drawCrop();
  });

  function clampOffset() {
    const s = cropCanvas.width;
    const sw = cropImg.naturalWidth * cropScale;
    const sh = cropImg.naturalHeight * cropScale;
    const maxX = Math.max(0, (sw - s) / 2);
    const maxY = Math.max(0, (sh - s) / 2);
    cropOffX = Math.max(-maxX, Math.min(maxX, cropOffX));
    cropOffY = Math.max(-maxY, Math.min(maxY, cropOffY));
  }

  // Mouse drag
  cropWrap.addEventListener('mousedown', e => {
    cropDragging = true;
    dragStartX = e.clientX; dragStartY = e.clientY;
    dragOffX = cropOffX; dragOffY = cropOffY;
  });
  window.addEventListener('mousemove', e => {
    if (!cropDragging) return;
    cropOffX = dragOffX + (e.clientX - dragStartX);
    cropOffY = dragOffY + (e.clientY - dragStartY);
    clampOffset(); drawCrop();
  });
  window.addEventListener('mouseup', () => { cropDragging = false; });

  // Touch drag
  cropWrap.addEventListener('touchstart', e => {
    cropDragging = true;
    dragStartX = e.touches[0].clientX; dragStartY = e.touches[0].clientY;
    dragOffX = cropOffX; dragOffY = cropOffY;
  }, { passive: true });
  window.addEventListener('touchmove', e => {
    if (!cropDragging) return;
    cropOffX = dragOffX + (e.touches[0].clientX - dragStartX);
    cropOffY = dragOffY + (e.touches[0].clientY - dragStartY);
    clampOffset(); drawCrop();
  }, { passive: true });
  window.addEventListener('touchend', () => { cropDragging = false; });

  // Scroll to zoom
  cropWrap.addEventListener('wheel', e => {
    e.preventDefault();
    cropScale = Math.max(parseFloat(cropZoom.min), Math.min(parseFloat(cropZoom.max), cropScale - e.deltaY * 0.001 * cropScale));
    cropZoom.value = cropScale;
    clampOffset(); drawCrop();
  }, { passive: false });

  cropCancel.addEventListener('click', () => {
    cropOverlay.style.display = 'none';
    photoInput.value = '';
  });

  cropConfirm.addEventListener('click', () => {
    // Always export at 512×512px regardless of display canvas size
    const OUTPUT_SIZE = 512;
    const out = document.createElement('canvas');
    out.width = OUTPUT_SIZE;
    out.height = OUTPUT_SIZE;

    // Scale the draw coords from display canvas → 512px output
    const displaySize = cropCanvas.width;
    const scaleFactor = OUTPUT_SIZE / displaySize;
    const ctx = out.getContext('2d');

    const sw = cropImg.naturalWidth  * cropScale * scaleFactor;
    const sh = cropImg.naturalHeight * cropScale * scaleFactor;
    const dx = (cropOffX + (displaySize - cropImg.naturalWidth  * cropScale) / 2) * scaleFactor;
    const dy = (cropOffY + (displaySize - cropImg.naturalHeight * cropScale) / 2) * scaleFactor;

    ctx.drawImage(cropImg, dx, dy, sw, sh);

    out.toBlob(blob => {
      croppedBlob = blob;
      // Revoke the crop object URL now that we're done with it
      if (cropObjectUrl) { URL.revokeObjectURL(cropObjectUrl); cropObjectUrl = null; }

      const previewUrl = URL.createObjectURL(blob);
      avatarPreview.src = previewUrl;
      previewDelete.dataset.hasPhoto = 'true';
      uploadUi.querySelector('.upload-text').innerHTML = 'Photo selected ✓<br/><span style="font-weight:500;font-size:0.8em;color:var(--muted)">Click to change</span>';
      cropOverlay.style.display = 'none';
    }, 'image/jpeg', 0.92);
  });

  function handleFile(file) {
    if (!file || !file.type.startsWith('image/')) return;
    if (file.size > 5 * 1024 * 1024) { alert('Photo must be under 5MB.'); return; }
    originalPhotoName = file.name;

    const img = new Image();
    const url = URL.createObjectURL(file);
    img.onload = () => {
      URL.revokeObjectURL(url);
      if (img.naturalWidth === img.naturalHeight) {
        // Already square — scale to exactly 512×512px via canvas
        const OUTPUT_SIZE = 512;
        const canvas = document.createElement('canvas');
        canvas.width = OUTPUT_SIZE;
        canvas.height = OUTPUT_SIZE;
        canvas.getContext('2d').drawImage(img, 0, 0, OUTPUT_SIZE, OUTPUT_SIZE);
        canvas.toBlob(blob => {
          croppedBlob = blob;
          const previewUrl = URL.createObjectURL(blob);
          avatarPreview.src = previewUrl;
          previewDelete.dataset.hasPhoto = 'true';
          uploadUi.querySelector('.upload-text').innerHTML = 'Photo selected ✓<br/><span style="font-weight:500;font-size:0.8em;color:var(--muted)">Click to change</span>';
        }, 'image/jpeg', 0.92);
      } else {
        // Not square — open the cropper
        openCropper(file);
      }
    };
    img.src = url;
  }

  previewDelete.addEventListener('click', () => {
    croppedBlob = null;
    originalPhotoName = '';
    // Revoke any lingering preview object URL
    if (avatarPreview.src && avatarPreview.src.startsWith('blob:')) {
      URL.revokeObjectURL(avatarPreview.src);
    }
    avatarPreview.src = '/images/profile-avatar.svg';
    previewDelete.dataset.hasPhoto = 'false';
    photoInput.value = '';
    uploadUi.querySelector('.upload-text').innerHTML = 'Drag &amp; drop your photo here<br/>or click to browse';
  });

  photoInput.addEventListener('change', () => handleFile(photoInput.files[0]));
  uploadZone.addEventListener('dragover', e => { e.preventDefault(); uploadZone.classList.add('dragover'); });
  uploadZone.addEventListener('dragleave', () => uploadZone.classList.remove('dragover'));
  uploadZone.addEventListener('drop', e => {
    e.preventDefault();
    uploadZone.classList.remove('dragover');
    const f = e.dataTransfer.files[0];
    if (f?.type.startsWith('image/')) handleFile(f);
  });

  /* ────────────────────────────────────────
     VALIDATION
  ──────────────────────────────────────── */
  function setError(fieldId, errId, msg) {
    const el = document.getElementById(fieldId);
    const err = document.getElementById(errId);
    if (msg) { el?.classList.add('is-error'); if (err) err.textContent = msg; }
    else      { el?.classList.remove('is-error'); if (err) err.textContent = ''; }
  }

  function validate() {
    let ok = true;
    const v = id => (document.getElementById(id)?.value || '').trim();

    if (v('full-name').length < 2) { setError('full-name','err-full-name','Please enter your full name.'); ok = false; }
    else setError('full-name','err-full-name','');

    if (v('initials').length < 2) { setError('initials','err-initials','Enter 2–3 character initials.'); ok = false; }
    else setError('initials','err-initials','');

    if (!v('category')) { setError('category-btn','err-category','Please select your status.'); ok = false; }
    else setError('category-btn','err-category','');

    if (v('role').length < 2) { setError('role','err-role','Please enter your role / title.'); ok = false; }
    else setError('role','err-role','');

    if (tags.length === 0) { document.getElementById('err-expertise').textContent = 'Add at least one skill.'; ok = false; }
    else document.getElementById('err-expertise').textContent = '';

    const bioVal = v('bio');
    if (bioVal.length < 30)  { setError('bio','err-bio','Bio must be at least 30 characters.'); ok = false; }
    else setError('bio','err-bio','');

    const emailVal = v('email');
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailVal)) { setError('email','err-email','Please enter a valid email address.'); ok = false; }
    else setError('email','err-email','');

    const portVal = v('portfolio');
    if (portVal) {
      // Auto-prepend https:// if user typed a domain without a protocol
      const portInput = document.getElementById('portfolio');
      let normalised = portVal;
      if (!/^https?:\/\//i.test(portVal)) {
        normalised = 'https://' + portVal;
        portInput.value = normalised;
      }
      try {
        const parsed = new URL(normalised);
        if (parsed.protocol !== 'https:' && parsed.protocol !== 'http:') {
          setError('portfolio','err-portfolio','Please enter a valid URL (e.g. https://yourportfolio.com).'); ok = false;
        } else {
          // Also reject obviously fake URLs (no dot in hostname)
          if (!parsed.hostname.includes('.')) {
            setError('portfolio','err-portfolio','Please enter a real portfolio URL (e.g. https://yourportfolio.com).'); ok = false;
          } else {
            setError('portfolio','err-portfolio','');
          }
        }
      } catch {
        setError('portfolio','err-portfolio','Please enter a valid portfolio URL (e.g. https://yourportfolio.com).'); ok = false;
      }
    } else {
      setError('portfolio','err-portfolio','');
    }

    return ok;
  }

  /* ────────────────────────────────────────
     REVIEW MODAL BUILD
  ──────────────────────────────────────── */
  function buildReview() {
    const v = id => (document.getElementById(id)?.value || '').trim();

    const rows = [
      { key: 'Full Name',       val: v('full-name') },
      { key: 'Nickname',        val: v('nickname') || '-' },
      { key: 'Initials',        val: v('initials') },
      { key: 'Category',        val: v('category') },
      { key: 'Program',         val: v('program') || '-' },
      { key: 'Role / Title',    val: v('role') },
      { key: 'Expertise',       val: '__tags__' },
      { key: 'Bio',             val: v('bio') },
      { key: 'Email',           val: v('email') },
      { key: 'Portfolio',       val: v('portfolio') },
      { key: 'Social Links',    val: '__socials__' },
      { key: 'Photo',           val: croppedBlob ? (croppedBlob.name || 'Photo cropped ✓') : 'None (avatar will be created)' },
    ];

    reviewBody.innerHTML = '';
    rows.forEach(r => {
      const row = document.createElement('div');
      row.className = 'review-row';
      let valHtml = '';
      if (r.val === '__tags__') {
        valHtml = tags.map((t, i) =>
          `<span class="tag" data-ci="${i % TAG_COLORS}" style="margin:2px;">${escapeHtml(t)}</span>`
        ).join('') || '-';
      } else if (r.val === '__socials__') {
        const s = JSON.parse(socialsHidden.value || '{}');
        const entries = Object.entries(s);
        valHtml = entries.length
          ? entries.map(([p,u]) => `<div><strong>${p}:</strong> ${escapeHtml(u)}</div>`).join('')
          : '-';
      } else {
        valHtml = escapeHtml(r.val);
      }
      row.innerHTML = `<span class="review-key">${r.key}</span><span class="review-val">${valHtml}</span>`;
      reviewBody.appendChild(row);
    });
  }

  /* ────────────────────────────────────────
     DUPLICATE CHECK
  ──────────────────────────────────────── */
  async function checkDuplicate(email) {
    try {
      const res = await fetch(
        `${SUPABASE_URL}/rest/v1/member_submissions?select=id&email=eq.${encodeURIComponent(email)}&status=in.(pending,approved)`,
        { headers: { 'apikey': SUPABASE_ANON, 'Authorization': `Bearer ${SUPABASE_ANON}` } }
      );
      const data = await res.json();
      return Array.isArray(data) && data.length > 0;
    } catch { return false; }
  }

  /* ────────────────────────────────────────
     PHOTO UPLOAD TO SUPABASE STORAGE
  ──────────────────────────────────────── */
  async function uploadPhoto(file, name) {
    if (!file) return null;
    const ext  = file.name.split('.').pop();
    const path = `${Date.now()}-${name.toLowerCase().replace(/\s+/g,'-')}.${ext}`;
    const res  = await fetch(`${SUPABASE_URL}/storage/v1/object/member-photos/${path}`, {
      method: 'POST',
      headers: { 'Authorization': `Bearer ${SUPABASE_ANON}`, 'Content-Type': file.type },
      body: file,
    });
    if (!res.ok) return null;
    return `${SUPABASE_URL}/storage/v1/object/public/member-photos/${path}`;
  }

  /* ────────────────────────────────────────
     FORM SUBMIT → REVIEW MODAL
  ──────────────────────────────────────── */
  form.addEventListener('submit', e => {
    e.preventDefault();
    if (!validate()) {
      document.querySelector('.is-error')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }
    buildReview();
    overlay.style.display = 'flex';
    overlay.scrollTop = 0;
  });

  btnEdit.addEventListener('click', () => { overlay.style.display = 'none'; });
  overlay.addEventListener('click', e => { if (e.target === overlay) overlay.style.display = 'none'; });

  /* ────────────────────────────────────────
     CONFIRM SUBMIT → SUPABASE
  ──────────────────────────────────────── */
  btnConfirm.addEventListener('click', async () => {
    btnConfirm.disabled = true;
    btnConfirm.textContent = 'Submitting…';

    const v = id => (document.getElementById(id)?.value || '').trim();
    const email = v('email');

    // Duplicate guard
    const isDuplicate = await checkDuplicate(email);
    if (isDuplicate) {
      overlay.style.display = 'none';
      alert(`A submission with the email "${email}" already exists and is under review or approved. You can only submit once.`);
      btnConfirm.disabled = false;
      btnConfirm.textContent = 'Confirm & Submit';
      return;
    }

    try {
      const photoUrl = await uploadPhoto(croppedBlob, v('full-name'));

      const payload = {
        name:       v('full-name'),
        nickname:   v('nickname') || null,
        initials:   v('initials'),
        category:   v('category'),
        program:    v('program') || null,
        role:       v('role'),
        expertise:  tags,
        bio:        v('bio'),
        email,
        portfolio:  v('portfolio'),
        socials:    JSON.parse(socialsHidden.value || '{}'),
        photo_url:  photoUrl,
        status:     'pending',
      };

      const res = await fetch(`${SUPABASE_URL}/rest/v1/member_submissions`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'apikey': SUPABASE_ANON,
          'Authorization': `Bearer ${SUPABASE_ANON}`,
          'Prefer': 'return=minimal',
        },
        body: JSON.stringify(payload),
      });

      if (!res.ok) throw new Error('Submission failed');

      overlay.style.display = 'none';
      form.style.display = 'none';
      document.querySelector('.submit-strip').style.display = 'none';
      successState.style.display = 'block';
      successState.scrollIntoView({ behavior: 'smooth', block: 'center' });

    } catch {
      overlay.style.display = 'none';
      btnConfirm.disabled = false;
      btnConfirm.textContent = 'Confirm & Submit';
      alert('Something went wrong. Please check your connection and try again.');
    }
  });

  /* Underline width is handled by CSS (inline-flex on .section__title-wrap). */

  /* ────────────────────────────────────────
     SYNC UPLOAD ZONE HEIGHT TO PREVIEW CARD
  ──────────────────────────────────────── */
  function syncUploadHeight() {
    const card = document.getElementById('photo-preview-card');
    const zone = document.getElementById('upload-zone');
    if (card && zone) {
      const h = card.offsetHeight;
      if (h > 0) zone.style.height = h + 'px';
    }
  }
  syncUploadHeight();
  window.addEventListener('resize', syncUploadHeight);

  /* ────────────────────────────────────────
     CLEAR ERRORS ON INPUT
  ──────────────────────────────────────── */
  ['full-name','initials','role','bio','email','portfolio'].forEach(id => {
    const el = document.getElementById(id);
    const errEl = document.getElementById(`err-${id}`);
    el?.addEventListener('input', () => { el.classList.remove('is-error'); if (errEl) errEl.textContent = ''; });
    el?.addEventListener('change', () => { el.classList.remove('is-error'); if (errEl) errEl.textContent = ''; });
  });
  tagInput.addEventListener('input', () => { document.getElementById('err-expertise').textContent = ''; });

  /* ────────────────────────────────────────
     STAGE BAR STICKY SHADOW
  ──────────────────────────────────────── */
  const stageBar = document.getElementById('stage-bar');
  if (stageBar) {
    const observer = new IntersectionObserver(
      ([entry]) => stageBar.classList.toggle('is-stuck', !entry.isIntersecting),
      { threshold: 1, rootMargin: '-1px 0px 0px 0px' }
    );
    // Sentinel: a zero-height element placed just above the bar
    const sentinel = document.createElement('div');
    sentinel.style.cssText = 'height:1px;margin-bottom:-1px;pointer-events:none';
    stageBar.parentNode.insertBefore(sentinel, stageBar);
    observer.observe(sentinel);
  }

  /* ────────────────────────────────────────
     HELPERS
  ──────────────────────────────────────── */
  function escapeHtml(str) {
    return String(str)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#039;');
  }
</script>