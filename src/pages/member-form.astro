  .rv-card--yellow:hover { box-shadow: 0 4px 32px rgba(254,200,67,0.28),  0 1px 4px rgba(0,0,0,0.04); }
  .rv-card--purple:hover { box-shadow: 0 4px 32px rgba(159,106,205,0.22), 0 1px 4px rgba(0,0,0,0.04); }
  .rv-card--pink   { border: 1.5px solid rgba(233,41,93,0.18); }
  .rv-card--teal   { border: 1.5px solid rgba(63,211,213,0.18); }
  .rv-card--yellow { border: 1.5px solid rgba(254,200,67,0.25); }
  .rv-card--purple { border: 1.5px solid rgba(159,106,205,0.18); }
  .rv-card__head { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; padding-bottom: 16px; border-bottom: 1px solid var(--border); }
  .rv-card__num { width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.72rem; font-weight: 900; letter-spacing: 0.04em; color: white; flex-shrink: 0; }
  .rv-card__title { font-size: 0.95rem; font-weight: 900; letter-spacing: 0.06em; text-transform: uppercase; color: var(--black); }
  .rv-rows { display: flex; flex-direction: column; gap: 0; }
  .rv-row { display: grid; grid-template-columns: 110px 1fr; gap: 8px; padding: 10px 0; border-bottom: 1px solid var(--border); align-items: start; }
  .rv-row:last-child { border-bottom: none; padding-bottom: 0; }
  .rv-row__key { font-size: 0.72rem; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; padding-top: 2px; }
  .rv-row__val { font-size: 0.88rem; font-weight: 600; color: var(--black); line-height: 1.5; word-break: break-word; }
  .rv-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 2px; }
  .rv-bio-count { font-size: 0.7rem; font-weight: 500; color: var(--muted); margin-top: 8px; display: block; }
  .rv-photo-layout { display: flex; align-items: center; gap: 28px; }
  .rv-photo-avatar { width: 110px; height: 110px; border-radius: 16px; object-fit: cover; flex-shrink: 0; border: 2.5px solid rgba(254,200,67,0.35); box-shadow: 0 4px 16px rgba(254,200,67,0.12); }
  .rv-photo-divider-v { width: 1.5px; align-self: stretch; background: rgba(0,0,0,0.07); border-radius: 2px; flex-shrink: 0; }
  .rv-photo-info-row { display: flex; align-items: stretch; flex: 1; min-width: 0; gap: 0; }
  .rv-photo-info-cell { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; padding: 4px 20px; flex: 1; min-width: 0; position: relative; }
  .rv-photo-info-cell + .rv-photo-info-cell::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 1.5px; background: rgba(0,0,0,0.07); border-radius: 2px; }
  .rv-photo-cell-icon { width: 34px; height: 34px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .rv-photo-cell-icon svg { width: 17px; height: 17px; }
  .rv-photo-cell-icon--teal   { background: rgba(63,211,213,0.13); } .rv-photo-cell-icon--teal svg   { color: var(--teal); width: 26px; height: 26px; }
  .rv-photo-cell-icon--pink   { background: rgba(233,41,93,0.1);   } .rv-photo-cell-icon--pink svg   { color: var(--pink); }
  .rv-photo-cell-icon--purple { background: rgba(159,106,205,0.12);} .rv-photo-cell-icon--purple svg { color: var(--purple); }
  .rv-photo-cell-icon--yellow { background: rgba(254,200,67,0.15); } .rv-photo-cell-icon--yellow svg { color: var(--yellow); }
  .rv-photo-cell-label { font-size: 0.68rem; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; line-height: 1; }
  .rv-photo-cell-val { font-size: 0.85rem; font-weight: 800; color: var(--black); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
  .rv-photo-cell-val--note { font-size: 0.72rem; font-weight: 500; color: var(--muted); white-space: normal; line-height: 1.4; }
  .rv-no-photo { display: flex; align-items: center; gap: 12px; background: rgba(254,200,67,0.08); border: 1.5px dashed rgba(254,200,67,0.4); border-radius: 14px; padding: 16px 20px; }
  .rv-no-photo p { font-size: 0.84rem; font-weight: 600; color: var(--muted); line-height: 1.55; }
  .rv-no-photo p strong { color: var(--yellow); font-weight: 800; display: block; margin-bottom: 2px; }
  .rv-socials { display: flex; flex-direction: column; gap: 8px; }
  .rv-social-row { display: flex; align-items: center; gap: 10px; font-size: 0.82rem; }
  .rv-social-icon { width: 18px; height: 18px; color: var(--teal); flex-shrink: 0; }
  .rv-social-icon svg { width: 18px; height: 18px; }
  .rv-social-platform { font-weight: 700; color: var(--black); min-width: 80px; font-size: 0.8rem; }
  .rv-social-url { color: var(--muted); font-weight: 500; font-size: 0.78rem; word-break: break-all; }

  .review-consent { background: rgba(159,106,205,0.06); border-radius: 20px; padding: 24px 0 24px 32px; margin-bottom: 16px; border: 1.5px solid rgba(159,106,205,0.2); box-shadow: 0 2px 8px rgba(0,0,0,0.04); overflow: hidden; }
  .review-consent__inner { display: flex; align-items: center; gap: 20px; }
  .review-consent__shield { width: clamp(44px, 6vw, 64px); height: clamp(44px, 6vw, 64px); flex-shrink: 0; }
  .review-consent__text { flex: 1; min-width: 0; }
  .review-consent__clapper { width: clamp(120px, 18vw, 200px); height: auto; flex-shrink: 0; align-self: stretch; object-fit: contain; object-position: bottom right; margin-right: -2px; }
  .review-consent__title { font-size: 1rem; font-weight: 900; color: var(--black); margin-bottom: 4px; }
  .review-consent__body { font-size: 0.82rem; font-weight: 500; color: var(--muted); line-height: 1.6; }

  .review-actions-bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 12px; flex-wrap: wrap; }
  .btn-back { display: inline-flex; align-items: center; gap: 8px; background: none; border: 1.5px solid var(--border); color: var(--muted); font-family: 'Raleway', sans-serif; font-size: 0.88rem; font-weight: 700; padding: 13px 24px; border-radius: 999px; cursor: pointer; transition: border-color 0.2s, color 0.2s; }
  .btn-back:hover { border-color: var(--black); color: var(--black); }
  .btn-confirm { display: inline-flex; align-items: center; gap: 8px; background: var(--pink); border: none; color: white; font-family: 'Raleway', sans-serif; font-size: 0.88rem; font-weight: 900; letter-spacing: 0.06em; padding: 14px 32px; border-radius: 999px; cursor: pointer; box-shadow: 0 4px 20px rgba(233,41,93,0.4); transition: background 0.2s, transform 0.15s, box-shadow 0.2s; }
  .btn-confirm:hover { background: #d4234f; transform: translateY(-2px); box-shadow: 0 6px 24px rgba(233,41,93,0.5); }
  .btn-confirm:disabled { opacity: 0.55; cursor: not-allowed; transform: none; }
  .review-security-note { display: flex; align-items: center; justify-content: center; gap: 5px; font-size: 0.72rem; font-weight: 600; color: var(--muted); text-align: center; padding-bottom: 8px; }

  /* ── SUCCESS STATE ── */
  .success-state {
    margin-top: 0;
    padding-top: 40px;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .success-state.is-visible { opacity: 1; transform: translateY(0); }

  /* Hero image — sits behind the card */
  .success-hero-img {
    display: flex;
    justify-content: center;
    margin-bottom: -40px;
    position: relative;
    z-index: 1;
  }
  .success-hero-img img {
    width: clamp(260px, 62vw, 500px);
    height: auto;
    display: block;
    filter: drop-shadow(0 10px 28px rgba(0,0,0,0.12));
    animation: heroImgIn 0.6s cubic-bezier(0.34,1.56,0.64,1) both;
  }
  @keyframes heroImgIn {
    from { opacity: 0; transform: translateY(24px) scale(0.94); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  /* Card — overlays on top of the image */
  .success-card {
    background: var(--white);
    border-radius: 28px;
    padding: 40px 48px 52px;
    text-align: center;
    box-shadow: 0 4px 28px rgba(0,0,0,0.06);
    position: relative;
    z-index: 2;
  }

  /* Checkmark */
  .success-check-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 20px;
    width: 88px;
    height: 88px;
    filter: drop-shadow(0 6px 16px rgba(63,211,213,0.35));
    margin-left: auto;
    margin-right: auto;
  }
  .success-check-svg { width: 88px; height: 88px; overflow: visible; }

  .success-check-bg {
    fill: var(--teal);
    transform-origin: 42.53px 42.52px;
    transform: scale(0);
  }
  .success-state.is-visible .success-check-bg {
    animation: checkPop 0.45s 0.3s cubic-bezier(0.34,1.56,0.64,1) forwards;
  }
  @keyframes checkPop { to { transform: scale(1); } }

  .success-check-tick {
    stroke-dasharray: 80;
    stroke-dashoffset: 80;
  }
  .success-state.is-visible .success-check-tick {
    animation: drawTick 0.4s 0.75s cubic-bezier(0.4,0,0.2,1) forwards;
  }
  @keyframes drawTick { to { stroke-dashoffset: 0; } }

  /* Title */
  .success-title-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    margin-bottom: 6px;
    opacity: 0;
    transform: translateY(10px);
  }
  .success-state.is-visible .success-title-wrap { animation: fadeUp 0.4s 1s ease forwards; }

  .success-title {
    font-size: clamp(1.9rem, 5.5vw, 2.8rem);
    font-weight: 900;
    letter-spacing: -0.01em;
    line-height: 1.05;
    color: var(--black);
    text-transform: uppercase;
  }
  .success-title--pink { color: var(--pink); }

  .success-underline {
    display: block;
    width: clamp(140px, 70%, 340px);
    height: 10px;
    margin-top: 6px;
    margin-left:20px;
  }

  /* Body */
  .success-text {
    font-size: clamp(0.87rem, 2vw, 0.97rem);
    font-weight: 500;
    color: var(--muted);
    line-height: 1.75;
    max-width: 440px;
    margin: 22px auto 32px;
    opacity: 0;
    transform: translateY(10px);
  }
  .success-state.is-visible .success-text { animation: fadeUp 0.4s 1.15s ease forwards; }
  .success-brand { color: var(--pink); font-weight: 800; }

  /* Button */
  .success-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: transparent;
    border: 2px solid var(--pink);
    color: var(--pink);
    font-family: 'Raleway', sans-serif;
    font-size: 0.8rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    padding: 13px 32px;
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.2s, color 0.2s, transform 0.15s, box-shadow 0.2s;
    opacity: 0;
    transform: translateY(10px);
  }
  .success-state.is-visible .success-btn { animation: fadeUp 0.4s 1.3s ease forwards; }
  .success-btn:hover {
    background: var(--pink);
    color: var(--white);
    transform: translateY(-2px);
    box-shadow: 0 6px 22px rgba(233,41,93,0.35);
  }

  @keyframes fadeUp { to { opacity: 1; transform: translateY(0); } }

  @media (max-width: 680px) {
    .success-hero-img { margin-bottom: -56px; }
    .success-card { padding: 32px 24px 40px; border-radius: 22px; }
    .success-check-wrap { width: 76px; height: 76px; }
    .success-check-svg { width: 76px; height: 76px; }
  }

  .btn-confirm.is-loading { pointer-events: none; opacity: 0.8; }
  .btn-confirm.is-loading svg { display: none; }
  .btn-spinner { display: none; width: 18px; height: 18px; border: 2.5px solid rgba(255,255,255,0.3); border-top-color: white; border-radius: 50%; animation: spin 0.7s linear infinite; flex-shrink: 0; }
  .btn-confirm.is-loading .btn-spinner { display: block; }
  @keyframes spin { to { transform: rotate(360deg); } }

  .site-footer { position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; padding: 48px 24px 40px; margin-top: 8px; min-height: 140px; }
  .footer-logo { height: 72px; width: auto; transition: opacity 0.2s; display: block; position: relative; z-index: 2; }

  @media (max-width: 680px) {
    .hero { padding: 48px 20px 56px; }
    .section { padding: 28px 22px; }
    .fields--2, .fields--3 { grid-template-columns: 1fr; }
    .fields--identity { grid-template-columns: 2fr 1fr; gap: 12px; }
    .field--nickname { grid-column: 1 / 2; }
    .field--full { grid-column: 1; }
    .social-row { grid-template-columns: 1fr 40px; }
    .social-select-wrap { grid-column: 1 / -1; }
    .social-url { grid-column: 1; }
    .social-remove { grid-column: 2; grid-row: 2; }
    .submit-strip { padding: 24px 22px; }
    .section__icon-bg { width: 72px; height: 72px; margin-top: 0; }
    .section__icon-bg img { width: 72px; height: 72px; }
    .form-wrap { padding: 0 16px 60px; }
    .section__title { font-size: 1.05rem; }
    .opt-badge { display: none; }
    .photo-layout { grid-template-columns: 1fr; }
    .photo-divider-v { display: none; }
    .photo-preview-col { flex-direction: column; align-items: flex-start; gap: 8px; width: 100%; margin-top: 20px; }
    .no-photo-note { flex-direction: row; align-items: flex-start; padding-left: 0; }
    .deco--comicshade { width: 200px; bottom: -70px; left: -70px; }
    .site-footer { padding: 40px 24px 32px; }
    .footer-logo { height: 42px; }
    .review-grid { grid-template-columns: 1fr; }
    .rv-card--full { grid-column: 1; }
    .rv-card { padding: 22px 20px; }
    .rv-photo-layout { flex-direction: column; align-items: flex-start; gap: 16px; }
    .rv-photo-avatar { width: 90px; height: 90px; }
    .rv-photo-divider-v { display: none; }
    .rv-photo-info-row { flex-wrap: wrap; gap: 0; }
    .rv-photo-info-cell { padding: 8px 14px; min-width: 45%; }
    .rv-photo-info-cell + .rv-photo-info-cell::before { display: none; }
    .review-consent { padding: 20px; }
    .review-consent__inner { gap: 14px; }
    .review-consent__clapper { display: none; }
    .review-actions-bar { flex-direction: column; }
    .btn-back, .btn-confirm { width: 100%; justify-content: center; }
    .rv-row { grid-template-columns: 90px 1fr; }
    .crop-overlay { padding: 12px; }
    .crop-modal { padding: 20px 16px 16px; gap: 12px; border-radius: 16px; max-height: calc(100dvh - 24px); }
    .crop-canvas-wrap { max-height: min(300px, calc(100dvh - 210px)); }
    .crop-actions { justify-content: stretch; }
    .crop-cancel, .crop-confirm { flex: 1; text-align: center; padding: 12px 10px; font-size: 0.82rem; }
  }

  @media (max-width: 400px) {
    .section { padding: 22px 16px; }
    .form-wrap { padding: 0 12px 60px; }
