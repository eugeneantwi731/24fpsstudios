  .crop-cancel { background: none; border: 1.5px solid var(--border); color: var(--muted); font-family: 'Raleway', sans-serif; font-size: 0.84rem; font-weight: 700; padding: 11px 22px; border-radius: 999px; cursor: pointer; white-space: nowrap; flex-shrink: 0; }
  .crop-confirm { background: var(--pink); border: none; color: white; font-family: 'Raleway', sans-serif; font-size: 0.84rem; font-weight: 900; letter-spacing: 0.05em; padding: 11px 26px; border-radius: 999px; cursor: pointer; white-space: nowrap; flex-shrink: 0; box-shadow: 0 4px 14px rgba(233,41,93,0.3); }

  #review-page { padding-top: 32px; }
