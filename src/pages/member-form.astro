---
// src/pages/member-form.astro
// 24fps Decode Animation Lab - Member Profile Submission Form
// No Navbar or Footer - standalone page shared via WhatsApp link
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Member Profile Submission - 24fps Decode Animation Lab</title>
  <link rel="icon" type="image/svg+xml" href="/images/24fps-favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
</head>

<body>

  <!-- ── PAGE WRAPPER ── -->
  <main class="page">

    <!-- Decorative scribbles – bottom of page, live on footer -->

    <!-- ── HERO ── -->
    <header class="hero">
      <!-- Header decos -->
      <img src="/images/film-strip.svg"           class="deco deco--film"      alt="" aria-hidden="true" />
      <img src="/images/crown-scribble.svg"        class="deco deco--crown"     alt="" aria-hidden="true" />
      <img src="/images/star-scribble-1.svg"       class="deco deco--star1"     alt="" aria-hidden="true" />
      <img src="/images/star-scribble-2.svg"       class="deco deco--star2"     alt="" aria-hidden="true" />
      <img src="/images/cross-scribble-1.svg"      class="deco deco--cross1"    alt="" aria-hidden="true" />
      <img src="/images/line-scribble.svg"         class="deco deco--line"      alt="" aria-hidden="true" />
      <div class="hero__inner">
        <!-- Logo -->
        <a href="/" class="hero__logo" aria-label="24fps Home">
          <img src="/images/24fps-header-logo.svg" alt="24fps Decode Animation Lab" />
        </a>

        <!-- Dynamic title — swaps between stage 1 and stage 2 -->
        <div class="hero__title-wrap" id="hero-title-s1">
          <h1 class="hero__title">
            MEMBER PROFILE<br/>
            <span class="hero__title--pink">SUBMISSION <span class="hero__title-form">FORM<img src="/images/three-sparks.svg" class="sparks-inline" alt="" aria-hidden="true" /></span></span>
          </h1>
        </div>
        <div class="hero__title-wrap" id="hero-title-s2" style="display:none">
          <h1 class="hero__title">
            REVIEW YOUR<br/>
            <span class="hero__title--pink">PROFILE</span>
          </h1>
        </div>

        <p class="hero__sub" id="hero-sub-s1">
          This form collects the information that will appear on your official
          profile page on the 24fps Decode Animation Lab website.
          Take your time - this is how the world sees you.
        </p>
        <p class="hero__sub" id="hero-sub-s2" style="display:none">
          Please review your information below before submitting.
          Everything looks good? Hit Confirm &amp; Submit.
        </p>
      </div>
    </header>

    <!-- ── STAGE BAR (sticky progress indicator) ── -->
    <div class="stage-bar" id="stage-bar">
      <div class="stage-bar__inner">
        <div class="stage-indicator" id="stage-indicator" aria-label="Form progress">
          <!-- Bubble row: bubbles + connector all in one flex row, align-items:center guarantees perfect centering -->
          <div class="stage-indicator__bubbles">
            <div class="stage-step stage-step--active" id="step-1" data-step="1">
              <div class="stage-step__bubble" id="bubble-1">
                <svg class="stage-step__check" viewBox="0 0 16 16" fill="none"><path d="M3 8l3.5 3.5L13 5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span class="stage-step__num">1</span>
              </div>
            </div>
            <div class="stage-connector" id="connector-1-2"></div>
            <div class="stage-step" id="step-2" data-step="2">
              <div class="stage-step__bubble" id="bubble-2"><span class="stage-step__num">2</span></div>
            </div>
          </div>
          <!-- Label row: labels aligned under each bubble, gap spacer matches connector width -->
          <div class="stage-indicator__labels">
            <span class="stage-step__label" id="label-1">Fill Form</span>
            <span class="stage-label-gap" aria-hidden="true"></span>
            <span class="stage-step__label" id="label-2">Review &amp; Submit</span>
          </div>
        </div>
      </div>
    </div>

    <!-- ── FORM BODY ── -->
    <section class="form-wrap">
      <form id="member-form" novalidate>

        <!-- ══ SECTION 01: IDENTITY ══ -->
        <div class="section" id="sec-01">
          <div class="section__head">
            <div class="section__head-left">
              <span class="section__num" style="--clr: var(--pink)">01</span>
                <div class="section__title-wrap">
                  <div class="section__title-underline-wrap">
                    <h2 class="section__title">Identity</h2>
                    <svg class="section__title-underline" viewBox="0 0 70.82 4.26" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none"><path d="M1.23 4.26c-1.11,0.11 -2.41,-2 0.49,-2.29 16.96,-1.66 44.64,-2.65 62.25,-1.38 0.87,0.06 6.9,0.29 6.84,1.21 -0.05,0.85 -5.65,0.51 -6.49,0.51 -8.2,-0.08 -14.21,-0.26 -22.66,-0.11 -13,0.24 -27.49,0.71 -40.44,2.06z" fill="#E9295D"/></svg>
                  </div>
                  <p class="section__sub">Who are you?</p>
                </div>
            </div>
            <div class="section__icon-bg">
              <img src="/images/identity-icon.svg" alt="" aria-hidden="true" />
            </div>
          </div>
          <div class="fields fields--identity">
            <div class="field">
              <label class="label" for="full-name">Full Name <span class="req">*</span></label>
              <input class="input" id="full-name" name="full_name" type="text"
                     placeholder="e.g. John Delali Attah" autocomplete="name" required />
              <span class="err" id="err-full-name"></span>
            </div>
            <div class="field">
              <label class="label" for="initials">Initials <span class="req">*</span></label>
              <input class="input" id="initials" name="initials" type="text"
                     placeholder="e.g. JDA" maxlength="3" required />
              <span class="hint">2–3 characters from your name</span>
              <span class="err" id="err-initials"></span>
            </div>
            <div class="field field--nickname">
              <label class="label" for="nickname">Nickname <span class="opt">optional</span></label>
              <input class="input" id="nickname" name="nickname" type="text" placeholder="e.g. Hohoe Dr. Strange" />
            </div>
          </div>
        </div>

        <!-- ══ SECTION 02: YOUR ROLE ══ -->
        <div class="section" id="sec-02">
          <div class="section__head">
            <div class="section__head-left">
              <span class="section__num" style="--clr: var(--teal)">02</span>
                <div class="section__title-wrap">
                  <div class="section__title-underline-wrap">
                    <h2 class="section__title">Your Role</h2>
                    <svg class="section__title-underline" viewBox="0 0 70.82 4.26" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none"><path d="M1.23 4.26c-1.11,0.11 -2.41,-2 0.49,-2.29 16.96,-1.66 44.64,-2.65 62.25,-1.38 0.87,0.06 6.9,0.29 6.84,1.21 -0.05,0.85 -5.65,0.51 -6.49,0.51 -8.2,-0.08 -14.21,-0.26 -22.66,-0.11 -13,0.24 -27.49,0.71 -40.44,2.06z" fill="#3FD3D5"/></svg>
                  </div>
                  <p class="section__sub">Where do you fit in the studio?</p>
                </div>
            </div>
            <div class="section__icon-bg">
              <img src="/images/your-role-icon.svg" alt="" aria-hidden="true" />
            </div>
          </div>
          <div class="fields fields--3">

            <!-- Category -->
            <div class="field">
              <label class="label" for="category-btn">Status <span class="req">*</span></label>
              <div class="category-dd-wrap" id="category-dd-wrap">
                <button type="button" class="input category-dd-trigger" id="category-btn"
                        aria-haspopup="listbox" aria-expanded="false">
                  <span class="category-dd-label" id="category-dd-label">Student, Alumni or Faculty?</span>
                  <svg class="category-dd-caret" viewBox="0 0 16 16" fill="none">
                    <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  </svg>
                </button>
                <ul class="category-dd-list" id="category-dd-list" role="listbox" style="display:none">
                  <li class="category-dd-item" role="option" data-value="student">Student</li>
                  <li class="category-dd-item" role="option" data-value="alumni">Alumni</li>
                  <li class="category-dd-item" role="option" data-value="faculty">Faculty</li>
                </ul>
              </div>
              <input type="hidden" id="category" name="category" required />
              <span class="err" id="err-category"></span>
            </div>

            <!-- Program - text input, not dropdown -->
            <div class="field">
              <label class="label" for="program">Program <span class="opt">optional</span></label>
              <input class="input" id="program" name="program" type="text"
                     placeholder="e.g. Communication Design" />
              <span class="hint">Your department / programme</span>
            </div>

            <!-- Role / Title -->
            <div class="field">
              <label class="label" for="role">Role / Title <span class="req">*</span></label>
              <input class="input" id="role" name="role" type="text"
                     placeholder="e.g. 3D Modeler, Sound Designer" required />
              <span class="hint">Your specific studio role</span>
              <span class="err" id="err-role"></span>
            </div>
          </div>
        </div>

        <!-- ══ SECTION 03: EXPERTISE ══ -->
        <div class="section" id="sec-03">
          <div class="section__head">
            <div class="section__head-left">
              <span class="section__num" style="--clr: var(--yellow)">03</span>
                <div class="section__title-wrap">
                  <div class="section__title-underline-wrap">
                    <h2 class="section__title">Expertise</h2>
                    <svg class="section__title-underline" viewBox="0 0 70.82 4.26" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none"><path d="M1.23 4.26c-1.11,0.11 -2.41,-2 0.49,-2.29 16.96,-1.66 44.64,-2.65 62.25,-1.38 0.87,0.06 6.9,0.29 6.84,1.21 -0.05,0.85 -5.65,0.51 -6.49,0.51 -8.2,-0.08 -14.21,-0.26 -22.66,-0.11 -13,0.24 -27.49,0.71 -40.44,2.06z" fill="#FEC843"/></svg>
                  </div>
                  <p class="section__sub">What are your skills?</p>
                </div>
            </div>
            <div class="section__icon-bg">
              <img src="/images/expertise-icon.svg" alt="" aria-hidden="true" />
            </div>
          </div>

          <p class="section__instructions">
            Add your skills. Type a skill and press Enter to add.<br/>
            <strong>* At least one skill is required.</strong>
          </p>

          <div class="tag-input-wrap" id="tag-wrap">
            <div class="tag-input-row">
              <input class="input tag-input" id="expertise-text" type="text"
                     placeholder="Type a skill and press Enter…" autocomplete="off" />
              <button type="button" class="add-tag-btn" id="add-tag-btn" aria-label="Add skill">
                <svg viewBox="0 0 16 16" fill="none">
                  <line x1="8" y1="2" x2="8" y2="14" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
                  <line x1="2" y1="8" x2="14" y2="8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
                </svg>
                Add
              </button>
            </div>
            <div class="tags-list" id="tags-list"></div>
          </div>
          <span class="err" id="err-expertise"></span>
          <input type="hidden" id="expertise-hidden" name="expertise" />
        </div>

        <!-- ══ SECTION 04: BIO ══ -->
        <div class="section" id="sec-04">
          <div class="section__head">
            <div class="section__head-left">
              <span class="section__num" style="--clr: var(--purple)">04</span>
                <div class="section__title-wrap">
                  <div class="section__title-underline-wrap">
                    <h2 class="section__title">Your Bio</h2>
                    <svg class="section__title-underline" viewBox="0 0 70.82 4.26" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none"><path d="M1.23 4.26c-1.11,0.11 -2.41,-2 0.49,-2.29 16.96,-1.66 44.64,-2.65 62.25,-1.38 0.87,0.06 6.9,0.29 6.84,1.21 -0.05,0.85 -5.65,0.51 -6.49,0.51 -8.2,-0.08 -14.21,-0.26 -22.66,-0.11 -13,0.24 -27.49,0.71 -40.44,2.06z" fill="#9F6ACD"/></svg>
                  </div>
                  <p class="section__sub">Tell the world who you are.</p>
                </div>
            </div>
            <div class="section__icon-bg">
              <img src="/images/your-bio-icon.svg" alt="" aria-hidden="true" />
            </div>
          </div>

          <p class="section__instructions">
            Tell us about yourself, your interests, and what drives your creativity.
            <strong>Minimum 30 characters. Maximum 600 characters.</strong>
          </p>


          <div class="field">
            <label class="label" for="bio">Bio <span class="req">*</span></label>
            <textarea class="input textarea" id="bio" name="bio" rows="5"
              placeholder="Write 2–4 sentences about yourself - your role at 24fps, what you work on, and what drives your creative practice."
              required></textarea>
            <div class="bio-footer">
              <span class="err" id="err-bio"></span>
              <span class="char-count"><span id="bio-count">0</span> / 600</span>
            </div>
          </div>
        </div>

        <!-- ══ SECTION 05: CONTACT & PORTFOLIO ══ -->
        <div class="section" id="sec-05">
          <div class="section__head">
            <div class="section__head-left">
              <span class="section__num" style="--clr: var(--pink)">05</span>
                <div class="section__title-wrap">
                  <div class="section__title-underline-wrap">
                    <h2 class="section__title">Contact &amp; Portfolio</h2>
                    <svg class="section__title-underline" viewBox="0 0 70.82 4.26" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none"><path d="M1.23 4.26c-1.11,0.11 -2.41,-2 0.49,-2.29 16.96,-1.66 44.64,-2.65 62.25,-1.38 0.87,0.06 6.9,0.29 6.84,1.21 -0.05,0.85 -5.65,0.51 -6.49,0.51 -8.2,-0.08 -14.21,-0.26 -22.66,-0.11 -13,0.24 -27.49,0.71 -40.44,2.06z" fill="#E9295D"/></svg>
                  </div>
                  <p class="section__sub">How can people reach you?</p>
                </div>
            </div>
            <div class="section__icon-bg">
              <img src="/images/contact-portfolio-icon.svg" alt="" aria-hidden="true" />
            </div>
          </div>
          <div class="fields fields--2">
            <div class="field">
              <label class="label" for="email">Email Address <span class="req">*</span></label>
              <input class="input" id="email" name="email" type="email"
                     placeholder="e.g. you@example.com" autocomplete="email" required />
              <span class="err" id="err-email"></span>
            </div>
            <div class="field">
              <label class="label" for="portfolio">Portfolio URL <span class="opt">optional</span></label>
              <input class="input" id="portfolio" name="portfolio" type="url"
                     placeholder="e.g. https://yourportfolio.com" />
              <span class="err" id="err-portfolio"></span>
            </div>
          </div>
        </div>

        <!-- ══ SECTION 06: SOCIAL LINKS ══ -->
        <div class="section" id="sec-06">
          <div class="section__head">
            <div class="section__head-left">
              <span class="section__num" style="--clr: var(--teal)">06</span>
              <div class="section__title-wrap">
                <div class="section__title-row">
                  <div class="section__title-underline-wrap">
                    <h2 class="section__title">Social Links</h2>
                    <svg class="section__title-underline" viewBox="0 0 70.82 4.26" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none"><path d="M1.23 4.26c-1.11,0.11 -2.41,-2 0.49,-2.29 16.96,-1.66 44.64,-2.65 62.25,-1.38 0.87,0.06 6.9,0.29 6.84,1.21 -0.05,0.85 -5.65,0.51 -6.49,0.51 -8.2,-0.08 -14.21,-0.26 -22.66,-0.11 -13,0.24 -27.49,0.71 -40.44,2.06z" fill="#3FD3D5"/></svg>
                  </div>
                  <span class="opt-badge">optional</span>
                </div>
                <p class="section__sub">Add your social or professional links.</p>
              </div>
            </div>
            <div class="section__icon-bg">
              <img src="/images/social-links-icon.svg" alt="" aria-hidden="true" />
            </div>
          </div>

          <p class="section__instructions">
            Select a platform and paste your full profile URL. Click <strong>Add Link</strong> to add more.
          </p>

          <div class="socials-builder" id="socials-builder"></div>

          <button type="button" class="add-social-btn" id="add-social-btn">
            <svg viewBox="0 0 16 16" fill="none">
              <line x1="8" y1="2" x2="8" y2="14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              <line x1="2" y1="8" x2="14" y2="8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            Add Link
          </button>

          <input type="hidden" id="socials-hidden" name="socials" value="{}" />
        </div>

        <!-- ══ SECTION 07: PHOTO ══ -->
        <div class="section" id="sec-07">
          <div class="section__head">
            <div class="section__head-left">
              <span class="section__num" style="--clr: var(--yellow)">07</span>
              <div class="section__title-wrap">
                <div class="section__title-row">
                  <div class="section__title-underline-wrap">
                    <h2 class="section__title">Photo</h2>
                    <svg class="section__title-underline" viewBox="0 0 70.82 4.26" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none"><path d="M1.23 4.26c-1.11,0.11 -2.41,-2 0.49,-2.29 16.96,-1.66 44.64,-2.65 62.25,-1.38 0.87,0.06 6.9,0.29 6.84,1.21 -0.05,0.85 -5.65,0.51 -6.49,0.51 -8.2,-0.08 -14.21,-0.26 -22.66,-0.11 -13,0.24 -27.49,0.71 -40.44,2.06z" fill="#FEC843"/></svg>
                  </div>
                  <span class="opt-badge">optional</span>
                </div>
              </div>
            </div>
          </div>

          <div class="photo-layout">
            <!-- LEFT: Upload zone -->
            <div class="upload-col">
              <span class="upload-spacer" aria-hidden="true"></span>
              <div class="upload-zone" id="upload-zone">
                <input type="file" id="photo" name="photo"
                       accept="image/jpeg,image/png,image/webp"
                       class="upload-input" />
                <div class="upload-ui" id="upload-ui">
                  <img src="/images/upload-icon.svg" class="upload-icon" alt="" aria-hidden="true" />
                  <p class="upload-text">Drag &amp; drop your photo here<br/>or click to browse</p>
                  <p class="upload-hint">JPG, PNG, or WEBP • Under 5MB</p>
                </div>
              </div>
            </div>

            <!-- DIVIDER -->
            <div class="photo-divider-v" aria-hidden="true"></div>

            <!-- MIDDLE: Preview card -->
            <div class="photo-preview-col">
              <span class="preview-label">PREVIEW</span>
              <div class="photo-preview-card" id="photo-preview-card">
                <img src="/images/profile-avatar.svg" id="avatar-preview-img" alt="Avatar preview" />
                <button type="button" class="preview-delete" id="preview-delete" aria-label="Remove photo" data-has-photo="false">
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M10 11v6M14 11v6" stroke="white" stroke-width="2" stroke-linecap="round"/>
                  </svg>
                </button>
              </div>
            </div>

            <!-- RIGHT: No-photo note -->
            <div class="no-photo-note">
              <p class="no-photo-text">
                <strong>No photo? No worries!</strong><br/>
                We'll create a custom illustrated avatar for you.
              </p>
              <img src="/images/arrow-line-turned.svg" class="no-photo-deco" alt="" aria-hidden="true" />
            </div>
          </div>
        </div>

        <!-- ══ REVIEW SUBMISSION BUTTON (bottom of stage 1) ══ -->
        <div class="submit-strip" id="submit-strip">
          <div class="submit-strip__center">
            <img src="/images/three-sparks.svg" class="submit-sparks submit-sparks--left" alt="" aria-hidden="true" />
            <button type="button" class="submit-btn" id="go-to-review-btn">
              <svg viewBox="0 0 20 20" fill="none" width="20" height="20">
                <path d="M3 10l14 0M10 4l6 6-6 6" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              REVIEW SUBMISSION
            </button>
            <img src="/images/three-sparks.svg" class="submit-sparks submit-sparks--right" alt="" aria-hidden="true" />
          </div>
        </div>

      </form>

      <!-- ══ STAGE 2: REVIEW PAGE ══ -->
      <div id="review-page" style="display:none">

        <!-- Review grid: 2 columns for sections 01-06, full width for 07 -->
        <div class="review-grid" id="review-grid"></div>

        <!-- Consent strip -->
        <div class="review-consent">
          <div class="review-consent__inner">
            <svg viewBox="0 0 24 24" fill="none" class="review-consent__shield" xmlns="http://www.w3.org/2000/svg">
              <path d="M9.34875 11.5L11.3488 13.5L15.5 9.34878M11.7253 3.07852L5.72528 4.7928C5.29598 4.91546 5 5.30784 5 5.75432L5 10.8538C5 14.0834 6.55966 17.1141 9.18762 18.9912L11.4188 20.5849C11.7665 20.8332 12.2335 20.8332 12.5812 20.5849L14.8124 18.9912C17.4403 17.1141 19 14.0834 19 10.8538V5.75432C19 5.30784 18.704 4.91546 18.2747 4.7928L12.2747 3.07852C12.0952 3.02721 11.9048 3.02721 11.7253 3.07852Z" stroke="var(--purple)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <div class="review-consent__text">
              <p class="review-consent__title">Almost there!</p>
              <p class="review-consent__body">By submitting, you confirm that all information provided is accurate and you give 24fps Decode Animation Lab permission to use it on our website and related platforms.</p>
            </div>
            <img src="/images/clapper-note.svg" class="review-consent__clapper" alt="" aria-hidden="true" />
          </div>
        </div>

        <!-- Action bar -->
        <div class="review-actions-bar">
          <button type="button" class="btn-back" id="btn-back">
            <svg viewBox="0 0 20 20" fill="none" width="18" height="18">
              <path d="M17 10H3M10 4l-6 6 6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Go Back &amp; Edit
          </button>
          <button type="button" class="btn-confirm" id="btn-confirm">
            <svg viewBox="0 0 337.56 298.76" fill="none" width="18" height="18" xmlns="http://www.w3.org/2000/svg">
              <path fill="white" fill-rule="evenodd" d="M37.85 133.57l187.18 -69.08c1.01,-0.37 2.13,0.09 2.59,1.06 0.46,0.98 0.09,2.13 -0.84,2.67l-162.14 93.6 8.51 89.36c1.14,6.73 5.46,11.54 13.07,10.77 10.16,-1.02 21.27,-25.84 34.57,-39.76l67.01 69.66c17.25,19.09 24.67,-5.96 31.22,-20.12l110.43 -238.75c16.63,-35.66 7.84,-37.34 -27.75,-28.46l-271.53 67.73c-15.45,3.85 -40.5,8.13 -25.61,26.02l33.29 35.31z"/>
            </svg>
            Confirm &amp; Submit
          </button>
        </div>
        <p class="review-security-note">
          <svg viewBox="-4 0 32 32" width="13" height="13" xmlns="http://www.w3.org/2000/svg">
            <g transform="translate(-4)">
              <path d="M26,12H24V7h-.069A7.993,7.993,0,0,0,8.069,7H8v5H6a2,2,0,0,0-2,2V30a2,2,0,0,0,2,2H26a2,2,0,0,0,2-2V14A2,2,0,0,0,26,12ZM12,8a4,4,0,0,1,8,0v4H12ZM23,28H9a1,1,0,0,1-1-1V17a1,1,0,0,1,1-1H23a1,1,0,0,1,1,1V27A1,1,0,0,1,23,28Z" fill="currentColor"/>
              <circle cx="2" cy="2" r="2" transform="translate(14 20)" fill="currentColor"/>
            </g>
          </svg>
          Your information is secure and will never be shared without permission.
        </p>
      </div>

      <!-- ══ CROP MODAL ══ -->
      <div class="crop-overlay" id="crop-overlay" style="display:none" role="dialog" aria-modal="true" aria-label="Crop your photo">
        <div class="crop-modal">
          <h3>Crop Your Photo</h3>
          <p>Drag to reposition · scroll or slide to zoom · must be square (1:1)</p>
          <div class="crop-canvas-wrap" id="crop-canvas-wrap">
            <canvas id="crop-canvas"></canvas>
          </div>
          <div class="crop-zoom-row">
            <label for="crop-zoom">Zoom</label>
            <input type="range" id="crop-zoom" min="1" max="3" step="0.01" value="1" />
          </div>
          <div class="crop-actions">
            <button type="button" class="crop-cancel" id="crop-cancel">Cancel</button>
            <button type="button" class="crop-confirm" id="crop-confirm">Use This Crop</button>
          </div>
        </div>
      </div>

      <!-- ══ SUCCESS STATE ══ -->
      <div class="success-state" id="success-state" style="display:none">
        <img src="/images/three-sparks.svg" class="success-sparks" alt="" aria-hidden="true" />
        <div class="success-check">
          <svg viewBox="0 0 60 60" fill="none">
            <circle cx="30" cy="30" r="28" stroke="var(--pink)" stroke-width="2.2"/>
            <path d="M18 30L26 38L42 22" stroke="var(--pink)" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h2 class="success-title">Profile Submitted!</h2>
        <p class="success-text">
          Your profile is now under review by the team. Once approved, it will
          go live on the 24fps website. Keep creating.
        </p>
        <div class="success-badge">DECODE · CREATE · INSPIRE</div>
      </div>

    </section>

    <!-- ── FOOTER ── -->
    <footer class="site-footer">
      <!-- Footer decos -->
      <img src="/images/cross-scribble-2.svg"     class="deco deco--cross2"    alt="" aria-hidden="true" />
      <img src="/images/star-line-scribble.svg"   class="deco deco--starline"  alt="" aria-hidden="true" />
      <img src="/images/comic-shade.svg"           class="deco deco--comicshade" alt="" aria-hidden="true" />
      <img src="/images/24fps-footer-logo.svg" alt="24fps Decode Animation Lab" class="footer-logo" />
    </footer>

  </main>

</body>
</html>

<!-- ══════════════════════════════════════════
     STYLES
══════════════════════════════════════════ -->
<style is:global>
  /* ── RESET & ROOT ── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --pink:   #E9295D;
    --teal:   #3FD3D5;
    --yellow: #FEC843;
    --purple: #9F6ACD;
    --black:  #1A1A1A;
    --white:  #FFFFFF;
    --off:    #F8F5F5;
    --muted:  #6B7280;
    --border: rgba(26,26,26,0.12);

    /* tag cycling colors */
    --tag0: var(--pink);
    --tag1: var(--teal);
    --tag2: var(--yellow);
    --tag3: var(--purple);
  }

  body {
    font-family: 'Raleway', sans-serif;
    background: var(--off);
    color: var(--black);
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  /* ── PAGE ── */
  .page { min-height: 100vh; position: relative; }

  /* ── HERO ── */
  .hero {
    position: relative;
    padding: 64px 24px 72px;
    background: transparent;
    text-align: center;
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero__logo {
    display: block;
    margin-bottom: 24px;
  }
  .hero__logo img { height: clamp(60px, 12vw, 100px); width: auto; display: block; margin: 0 auto; }

  .hero__title {
    font-size: clamp(2.4rem, 5.5vw, 3.6rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--black);
    margin-bottom: 16px;
  }
  .hero__title--pink { color: var(--pink); }

  .hero__sub {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--muted);
    line-height: 1.65;
    max-width: 480px;
    margin: 0 auto;
  }

  /* ── STAGE BAR ── */
  .stage-bar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(248, 245, 245, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(26,26,26,0.08);
    padding: 14px 24px;
    transition: box-shadow 0.3s;
  }
  .stage-bar.is-stuck {
    box-shadow: 0 2px 16px rgba(0,0,0,0.08);
  }
  .stage-bar__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
  }

  /* ── STAGE INDICATOR ── */
  /*
   * Two-row layout:
   *   Row 1 (bubble-row): [bubble] [connector] [bubble]  — all vertically centered
   *   Row 2 (label-row):  [label]              [label]   — centered under each bubble
   * The connector lives in the same flex row as the bubbles so it is ALWAYS
   * at the same height as their centers. No margin hacks needed.
   */
  .stage-indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 7px;
    position: relative;
    z-index: 2;
  }

  /* Top row: bubbles + connector, all vertically centered */
  .stage-indicator__bubbles {
    display: flex;
    align-items: center;
    gap: 0;
  }

  /* Bottom row: labels aligned under each bubble */
  .stage-indicator__labels {
    display: flex;
    align-items: flex-start;
    gap: 0;
  }

  .stage-step {
    display: contents; /* step is purely a logical grouping, not a visual box */
  }

  .stage-step__bubble {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--off);
    border: 2px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transition: background 0.3s, border-color 0.3s, box-shadow 0.3s;
  }

  .stage-step__num {
    font-size: 0.82rem;
    font-weight: 900;
    color: var(--muted);
    transition: color 0.3s;
    letter-spacing: 0.02em;
  }

  .stage-step__check {
    display: none;
    width: 18px;
    height: 18px;
    position: absolute;
  }

  .stage-step__label {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--muted);
    white-space: nowrap;
    letter-spacing: 0.03em;
    transition: color 0.3s;
    text-align: center;
    width: 38px; /* same as bubble so label centers under it */
  }

  /* Spacer in the labels row to match connector width */
  .stage-label-gap {
    width: calc(80px + 16px); /* connector width + side margins */
    flex-shrink: 0;
  }

  /* Active step — filled circle with number */
  .stage-step--active .stage-step__bubble {
    background: var(--pink);
    border-color: var(--pink);
    box-shadow: 0 0 0 4px rgba(233,41,93,0.15);
  }
  .stage-step--active .stage-step__num { color: white; }
  .stage-step--active .stage-step__label { color: var(--pink); }

/* ── FIX: Center the overflowing text perfectly under the bubble ── */
  .stage-step__label {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--muted);
    white-space: nowrap;
    letter-spacing: 0.03em;
    transition: color 0.3s;
    width: 38px; /* same as bubble so label centers under it */
    
    /* ADD THESE TWO LINES */
    display: flex;
    justify-content: center;
  }

  /* Label standalone color states */
  .stage-step__label.label--active { color: var(--pink); }
  .stage-step__label.label--done   { color: var(--teal); }

  /* ── FIX: Restored the missing selector for the completed bubble ── */
  .stage-step--done .stage-step__bubble {
    background: transparent;
    border: 2px solid var(--teal);
    box-shadow: none; /* Ensures no active glow remains */
  }
  
  .stage-step--done .stage-step__num { 
    display: none; 
  }
  
  .stage-step--done .stage-step__check {
    display: block;
    color: var(--teal);
  }
  
  .stage-step--done .stage-step__label { 
    color: var(--teal); 
  }

  /* Connector — sits in the bubble row, align-items: center handles everything */
  .stage-connector {
    width: 80px;
    height: 2px;
    background: var(--border);
    margin: 0 8px;
    flex-shrink: 0;
    position: relative;
    overflow: hidden;
    border-radius: 2px;
    /* No margin-top needed — align-items:center on parent does the work */
  }
  .stage-connector::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--teal);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s ease;
    border-radius: 2px;
  }
  .stage-connector--filled::after { transform: scaleX(1); }

  @media (max-width: 400px) {
    .stage-connector { width: 40px; }
    .stage-label-gap { width: calc(40px + 16px); }
    .stage-step__label { font-size: 0.65rem; }
  }

  /* ── DECORATIVE SCRIBBLES ── */
  .deco {
    position: absolute;
    pointer-events: none;
    z-index: 0;
  }

  /* ── HEADER DECOS (relative to .hero) ── */
  .deco--film   { width: clamp(180px, 35vw, 400px); top: 0;    right: 0; }
  .deco--crown  { width: clamp(44px,  8vw,  90px);  top: 40px; left: 25%; }
  .deco--cross1 { width: clamp(18px,  3vw,  36px);  top: 100px; right: 32%; }
  .deco--star1  { width: clamp(28px,  5vw,  60px);  top: 200px; left: 16%; }
  .deco--star2  { width: clamp(36px,  6vw,  80px);  top: 300px; right: 18%; }
  .deco--line   { width: clamp(40px,  7vw,  80px);  top: 360px; left: 10%; }

  /* ── FOOTER DECOS (relative to .site-footer) ── */
  .deco--cross2   { width: clamp(20px, 3.5vw, 38px); top: 24px; left: 26%; }
  .deco--starline { width: clamp(70px, 12vw, 140px); top: 20px; right: 24%; z-index: 1; }
  .deco--comicshade {
    width: 300px;
    bottom: -100px;
    left: -100px;
    top: auto;
    z-index: 0;
    opacity: 0.55;
  }

  .deco--sparks { display: none; }

  /* ── SPARKS – anchored to "FORM", scales with font size ── */
  .hero__title--pink {
    position: relative;
  }
  .hero__title-form {
    position: relative;
    display: inline-block;
  }
  .sparks-inline {
    position: absolute;
    width: 0.6em;
    right: -1.2em;
    top: -0.2em;
  }

  /* ── FORM WRAPPER ── */
  .form-wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 40px 80px;
  }

  /* ── SECTION CARD BASE ── */
  .section {
    background: var(--white);
    border-radius: 24px;
    padding: 36px 40px;
    margin-top: 20px;
    position: relative;
    overflow: visible; /* Keeps dropdown content from being clipped */
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    animation: sectionIn 0.45s ease both;
    transition: box-shadow 0.4s ease;
  }

  /* ── PERMANENT DESCENDING LAYER STACK ── */
  /* This forces higher sections to always paint on top of lower sections */
  .section:nth-of-type(1) { z-index: 7; }
  .section:nth-of-type(2) { z-index: 6; }
  .section:nth-of-type(3) { z-index: 5; }
  .section:nth-of-type(4) { z-index: 4; }
  .section:nth-of-type(5) { z-index: 3; }
  .section:nth-of-type(6) { z-index: 2; } /* Your socials block */
  .section:nth-of-type(7) { z-index: 1; } /* Elements below socials */

  /* Dynamically elevates whichever card you are currently interacting with */
  .section:focus-within {
    z-index: 10;
  }

  /* Borders always visible, no glow at rest */
  #sec-01, #sec-05 { border: 1.5px solid rgba(233,41,93,0.18); }
  #sec-02, #sec-06 { border: 1.5px solid rgba(63,211,213,0.18); }
  #sec-03, #sec-07 { border: 1.5px solid rgba(254,200,67,0.25); }
  #sec-04          { border: 1.5px solid rgba(159,106,205,0.18); }

  /* Glow transitions in when card is active */
  #sec-01:focus-within, #sec-05:focus-within { box-shadow: 0 4px 32px rgba(233,41,93,0.22), 0 1px 4px rgba(0,0,0,0.04); }
  #sec-02:focus-within, #sec-06:focus-within { box-shadow: 0 4px 32px rgba(63,211,213,0.22), 0 1px 4px rgba(0,0,0,0.04); }
  #sec-03:focus-within, #sec-07:focus-within { box-shadow: 0 4px 32px rgba(254,200,67,0.28), 0 1px 4px rgba(0,0,0,0.04); }
  #sec-04:focus-within                        { box-shadow: 0 4px 32px rgba(159,106,205,0.22), 0 1px 4px rgba(0,0,0,0.04); }

  @keyframes sectionIn {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── SECTION HEADER ── */
  .section__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 24px;
  }

  /* Left side: number + title stacked */
  .section__head-left {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    flex: 1;
  }

  /* Number badge – circle like the reference */
  .section__num {
    flex-shrink: 0;
    width: 44px; height: 44px;
    border-radius: 50%;
    background: var(--clr, var(--pink));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    color: #fff;
  }

  /* Big decorative icon – top-right of the card */
  .section__icon-bg {
    flex-shrink: 0;
    width: 100px; height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: -8px;
  }
  .section__icon-bg img {
    width: 100px; height: 100px;
    object-fit: contain;
    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.08));
  }

  /* ── SVG underline under section title ── */
  .section__title-wrap {
    display: inline-flex;
    flex-direction: column;
    gap: 1px;
  }

  .section__title {
    font-size: 1.25rem;
    font-weight: 900;
    color: var(--black);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    line-height: 1.2;
  }

  /* Wraps just the h2 + SVG so underline only spans the title text, not the opt-badge */
  .section__title-underline-wrap {
    display: inline-flex;
    flex-direction: column;
    width: fit-content; /* This breaks the flex stretch and snaps the line to the text width */
  }

  .section__title-underline {
    display: block;
    width: 100%;
    height: 5px;
    margin-top: -2px;
    flex-shrink: 0;
  }

  /* Colour the underline SVG fill per section */
  #sec-01 .section__title-underline path,
  #sec-05 .section__title-underline path { fill: var(--pink); }
  #sec-02 .section__title-underline path,
  #sec-06 .section__title-underline path { fill: var(--teal); }
  #sec-03 .section__title-underline path,
  #sec-07 .section__title-underline path { fill: var(--yellow); }
  #sec-04 .section__title-underline path { fill: var(--purple); }

  .section__sub {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--muted);
    margin-top: 4px;
  }

  /* Title row: title + opt-badge side by side, underline only under title */
  .section__title-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .section__instructions {
    font-size: 0.84rem;
    font-weight: 500;
    color: var(--muted);
    line-height: 1.6;
    margin-bottom: 16px;
    background: color-mix(in srgb, var(--sec-clr, var(--pink)) 14%, transparent);
    padding: 10px 14px;
    border-radius: 10px;
  }
  .section__instructions strong { color: var(--black); }
  kbd {
    background: var(--off);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 1px 6px;
    font-family: 'Raleway', sans-serif;
    font-size: 0.8em;
    font-weight: 700;
  }

  /* ── FIELD GRID ── */
  .fields { display: grid; gap: 16px; }
  .fields--2 { grid-template-columns: 1fr 1fr; }
  .fields--3 { grid-template-columns: 1fr 1fr 1fr; }
  /* Identity: name takes ~2/3, initials ~1/3 on row 1; nickname spans full on row 2 */
  .fields--identity { grid-template-columns: 2fr 1fr; }
  .field--full { grid-column: 1 / -1; }
  .field--nickname { grid-column: 1 / 2; } /* same width as the name field above */

  /* ── FIELD ── */
  .field { display: flex; flex-direction: column; gap: 5px; }

  .label {
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--black);
  }
  .req { color: var(--pink); font-size: 1rem; font-weight: 800; }
  .opt {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0.02em;
    margin-left: 4px;
  }

  /* ── INPUTS ── */
  .input {
    width: 100%;
    font-family: 'Raleway', sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--black);
    background: var(--off);
    border: 1.5px solid var(--border);
    border-radius: 12px;
    padding: 11px 14px;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
    appearance: none;
  }
  .input:focus {
    border-color: var(--sec-clr, var(--pink));
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--sec-clr, var(--pink)) 15%, transparent);
    background: var(--white);
  }
  .input.is-error {
    border-color: #ef4444;
    box-shadow: 0 0 0 3px rgba(239,68,68,0.1);
  }

  /* Per-section active color token */
  #sec-01, #sec-05 { --sec-clr: var(--pink); }
  #sec-02, #sec-06 { --sec-clr: var(--teal); }
  #sec-03, #sec-07 { --sec-clr: var(--yellow); }
  #sec-04          { --sec-clr: var(--purple); }

  .textarea {
    resize: vertical;
    min-height: 110px;
    line-height: 1.6;
  }

  /* ── CATEGORY CUSTOM DROPDOWN ── */
  .category-dd-wrap {
    position: relative;
    width: 100%;
  }
  .category-dd-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    cursor: pointer;
    text-align: left;
    font-weight: 600;
    color: var(--muted);
  }
  .category-dd-trigger.has-value { color: var(--black); }
  .category-dd-trigger:hover,
  .category-dd-trigger.is-open { border-color: var(--teal); background: var(--white); }
  .category-dd-trigger:focus { outline: none; }

  .category-dd-label { flex: 1; }

  .category-dd-caret {
    width: 16px; height: 16px;
    flex-shrink: 0;
    color: var(--muted);
    transition: transform 0.2s;
  }
  .category-dd-trigger.is-open .category-dd-caret { transform: rotate(180deg); }

  .category-dd-list {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    width: 100%;
    background: var(--white);
    border: 1.5px solid rgba(63,211,213,0.35);
    border-radius: 13px;
    box-shadow: 0 8px 28px rgba(0,0,0,0.12);
    z-index: 100;
    list-style: none;
    padding: 6px;
    overflow: hidden;
  }

  .category-dd-item {
    padding: 10px 12px;
    border-radius: 8px;
    font-family: 'Raleway', sans-serif;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--black);
    cursor: pointer;
    transition: background 0.15s;
  }
  .category-dd-item:hover { background: rgba(63,211,213,0.1); }
  .category-dd-item.is-selected {
    background: rgba(63,211,213,0.14);
    color: var(--black);
  }

  .hint {
    font-size: 0.73rem;
    font-weight: 500;
    color: var(--muted);
    line-height: 1.4;
  }

  .err {
    font-size: 0.73rem;
    font-weight: 600;
    color: #ef4444;
    display: block;
  }
  .err:empty { display: none; }

  /* ── TAG INPUT ── */
  .tag-input-wrap {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .tag-input-row {
    display: flex;
    gap: 0;
    align-items: center;
    background: var(--off);
    border: 1.5px solid var(--border);
    border-radius: 14px;
    padding: 5px 5px 5px 0;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .tag-input-row:focus-within {
    border-color: var(--yellow);
    box-shadow: 0 0 0 3px rgba(254,200,67,0.15);
    background: var(--white);
  }

  .tag-input {
    flex: 1;
    background: transparent;
    border: none !important;
    box-shadow: none !important;
    border-radius: 0;
    padding: 10px 16px;
    font-size: 0.92rem;
  }
  .tag-input:focus {
    border-color: transparent !important;
    box-shadow: none !important;
    background: transparent !important;
  }

  .add-tag-btn {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--yellow);
    color: var(--white);
    font-family: 'Raleway', sans-serif;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    padding: 10px 20px;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    transition: background 0.2s, box-shadow 0.2s;
    white-space: nowrap;
  }
  .add-tag-btn:hover {
    box-shadow: 0 0 0 3px rgba(254,200,67,0.35), 0 2px 10px rgba(254,200,67,0.45);
  }
  .add-tag-btn:active {
    box-shadow: 0 0 0 4px rgba(254,200,67,0.45), 0 2px 14px rgba(254,200,67,0.55);
  }
  .add-tag-btn svg { width: 14px; height: 14px; stroke: var(--white); }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    min-height: 0;
  }

  /* Tags — solid pastel pills matching reference image */
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px 8px 16px;
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    border: none;
    animation: tagPop 0.22s cubic-bezier(0.34,1.56,0.64,1) both;
  }
  @keyframes tagPop {
    from { transform: scale(0.6); opacity: 0; }
    to   { transform: scale(1); opacity: 1; }
  }
  .tag[data-ci="0"] { background: #FFCCD9; color: #C41E4A; }
  .tag[data-ci="1"] { background: #C4F2F2; color: #0A7E80; }
  .tag[data-ci="2"] { background: #FFF0B3; color: #8A6000; }
  .tag[data-ci="3"] { background: #E8D5F5; color: #6A35A8; }

  .tag-remove {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px; height: 20px;
    border-radius: 50%;
    opacity: 0.75;
    transition: opacity 0.15s, background 0.15s;
    color: inherit;
    flex-shrink: 0;
    font-style: normal;
  }
  .tag-remove:hover { opacity: 1; background: rgba(0,0,0,0.1); }
  .tag-remove svg { width: 11px; height: 11px; stroke-width: 2; }

  /* ── BIO EXTRAS ── */
  .bio-extract-row {
    margin-bottom: 16px;
  }

  .bio-file-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 6px;
    flex-wrap: wrap;
  }

  .bio-file-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--off);
    border: 1.5px dashed var(--border);
    border-radius: 10px;
    padding: 9px 16px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--muted);
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }
  .bio-file-label:hover {
    border-color: var(--teal);
    color: var(--teal);
  }
  .bio-file-label svg { width: 16px; height: 16px; flex-shrink: 0; }
  .bio-file-input { display: none; }

  .bio-file-note {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--teal);
  }

  .bio-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 4px;
  }

  .char-count {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--muted);
    white-space: nowrap;
  }
  .char-count.over { color: #ef4444; }

  /* ── OPTIONAL BADGE CLEANUP ── */
  .opt-badge {
    font-size: 0.72rem;
    font-weight: 900;          /* Reduced boldness from heavy to semi-bold */
    letter-spacing: normal;    /* Removes the squeeze, resets to default tracking */
    color: var(--black);       /* Keeps the color pure black */
    background: none;
    border: none;
    padding: 0;
    text-transform: uppercase;
    display: inline-block;
    width: fit-content;
    margin-left: 4px;
    vertical-align: baseline;
  }

  /* Resets the tracking for the parentheses back to normal */
  .opt-badge::before { 
    content: '('; 
    margin-right: 0;
  }
  .opt-badge::after { 
    content: ')'; 
    margin-left: 0;
  }

  /* ── SOCIALS BUILDER ── */
  .socials-builder {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 14px;
  }

  .social-row {
    display: grid;
    grid-template-columns: 200px 1fr 40px;
    gap: 10px;
    align-items: center;
  }

  /* ── CUSTOM SOCIAL DROPDOWN ── */
  .social-select-wrap {
    position: relative;
    width: 100%;
  }

  .social-dropdown {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'Raleway', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--black);
    background: var(--off);
    border: 1.5px solid var(--border);
    border-radius: 11px;
    padding: 9px 12px;
    cursor: pointer;
    outline: none;
    text-align: left;
    transition: border-color 0.2s, background 0.2s;
    position: relative;
  }
  .social-dropdown:hover,
  .social-dropdown.is-open { border-color: var(--teal); background: var(--white); }

  .social-dd-icon {
    width: 18px; height: 18px;
    flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    color: var(--teal);
  }
  .social-dd-icon svg { width: 18px; height: 18px; }

  .social-dd-label { flex: 1; }

  .social-dd-caret {
    width: 14px; height: 14px;
    color: var(--muted);
    flex-shrink: 0;
    transition: transform 0.2s;
    display: flex; align-items: center; justify-content: center;
  }
  .social-dd-caret svg { width: 14px; height: 14px; }
  .social-dropdown.is-open .social-dd-caret { transform: rotate(180deg); }

  .social-dd-list {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    width: 100%;
    background: var(--white);
    border: 1.5px solid rgba(63,211,213,0.35);
    border-radius: 13px;
    box-shadow: 0 8px 28px rgba(0,0,0,0.12);
    z-index: 100;
    list-style: none;
    padding: 6px;
    overflow-y: visible;
  }

  .social-dd-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 10px;
    border-radius: 8px;
    font-family: 'Raleway', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--black);
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  .social-dd-item:hover { background: rgba(63,211,213,0.1); color: var(--black); }
  .social-dd-item.is-selected {
    background: rgba(63,211,213,0.14);
    color: var(--black);
  }
  .social-dd-item.is-selected .social-dd-item-icon { color: var(--teal); }

  .social-dd-item-icon {
    width: 18px; height: 18px;
    flex-shrink: 0;
    color: var(--muted);
    display: flex; align-items: center; justify-content: center;
    transition: color 0.15s;
  }
  .social-dd-item-icon svg { width: 18px; height: 18px; }
  .social-dd-item:hover .social-dd-item-icon { color: var(--teal); }

  .social-url {
    font-family: 'Raleway', sans-serif;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--black);
    background: var(--off);
    border: 1.5px solid var(--border);
    border-radius: 11px;
    padding: 10px 14px;
    outline: none;
    width: 100%;
    transition: border-color 0.2s;
  }
  .social-url:focus {
    border-color: var(--teal);
    background: var(--white);
  }

  .social-remove {
    width: 36px; height: 36px;
    background: none;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--teal);
    flex-shrink: 0;
    transition: opacity 0.2s, color 0.2s, transform 0.2s;
  }
  .social-remove:hover {
    color: var(--teal);
    opacity: 1;
    transform: scale(1.1);
  }
  .social-remove svg { width: 22px; height: 22px; }

  .add-social-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: none;
    border: 1.5px dashed rgba(63,211,213,0.5);
    color: var(--teal);
    font-family: 'Raleway', sans-serif;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    padding: 10px 20px;
    border-radius: 11px;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
  }
  .add-social-btn:hover {
    background: rgba(63,211,213,0.06);
    border-color: var(--teal);
  }
  .add-social-btn svg { width: 14px; height: 14px; }

  /* ── PHOTO UPLOAD ── */
  .photo-layout {
    display: grid;
    grid-template-columns: 1.6fr 1px 1fr 1fr;
    gap: 0 24px;
    align-items: start;
    margin-top: 16px;
  }

  .upload-zone {
    position: relative;
    border: 2px dashed rgba(26,26,26,0.15);
    border-radius: 16px;
    background: transparent;
    transition: border-color 0.2s, background 0.2s;
    overflow: hidden;
    cursor: pointer;
    width: 100%;
    min-height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .upload-zone:hover { border-color: rgba(26,26,26,0.3); }
  .upload-zone.dragover {
    border-color: var(--yellow);
    background: rgba(254,200,67,0.04);
  }
  .upload-input {
    position: absolute; inset: 0;
    opacity: 0; cursor: pointer;
    width: 100%; height: 100%;
  }
  .upload-ui {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 20px;
    pointer-events: none;
  }
  .upload-icon { width: 44px; height: 44px; }
  .upload-text {
    font-size: 0.86rem;
    font-weight: 700;
    color: var(--black);
    text-align: center;
    line-height: 1.5;
  }
  .upload-hint {
    font-size: 0.73rem;
    font-weight: 500;
    color: var(--muted);
  }

  /* Upload col wrapper — spacer matches PREVIEW label so image bottoms align */
  .upload-col {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-self: stretch;
  }
  .upload-col .upload-zone {
    flex: 1; /* fill remaining height after spacer */
    min-height: 200px;
  }
  .upload-spacer {
    display: block;
    height: 0.62rem; /* matches preview-label font-size line height */
    line-height: 1;
    visibility: hidden;
  }

  /* Middle col: label sits on top, image below — top-aligned with upload zone */
  .photo-preview-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }
  .preview-label {
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--muted);
    text-transform: uppercase;
    padding-left: 2px;
  }
  .photo-preview-card {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 18px;
    background: none;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  .photo-preview-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 18px;
  }
  /* delete overlay – only shown when a photo is loaded (data-has-photo="true") */
  .photo-preview-card .preview-delete {
    display: none;
    position: absolute;
    inset: 0;
    background: rgba(254,200,67,0.35);
    border-radius: 18px;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border: none;
    transition: background 0.2s;
    z-index: 2;
  }
  /* Only show delete overlay on hover when photo is loaded */
  .photo-preview-card:hover .preview-delete[data-has-photo="true"],
  .photo-preview-card:focus-within .preview-delete[data-has-photo="true"] {
    display: flex;
  }
  .photo-preview-card .preview-delete:hover { background: rgba(254,200,67,0.6); }
  .photo-preview-card .preview-delete svg { width: 32px; height: 32px; }

  /* Vertical divider between upload and preview */
  .photo-divider-v {
    width: 1px;
    background: var(--border);
    align-self: stretch;
    margin-top: 22px; /* below PREVIEW label height */
  }

  /* Right col: no-photo note top-aligned */
  .no-photo-note {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-left: 4px;
    padding-top: 22px;
  }
  .no-photo-deco { width: 72px; height: auto; }
  .no-photo-text {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--muted);
    line-height: 1.6;
  }
  .no-photo-text strong {
    color: var(--yellow);
    font-weight: 800;
    display: block;
    margin-bottom: 4px;
    font-size: 0.86rem;
  }


  /* ── SUBMIT STRIP ── */
  .submit-strip {
    padding: 32px 40px;
    margin-top: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .submit-strip__center {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .submit-sparks {
    width: clamp(22px, 3vw, 29px);
    height: auto;
    flex-shrink: 0;
    position: relative;
    top: -20px;
  }
  .submit-sparks--left  { transform: scaleX(-1); }
  .submit-sparks--right { transform: scaleX(1); }

  .submit-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--pink);
    color: white;
    font-family: 'Raleway', sans-serif;
    font-size: 0.88rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    padding: 15px 30px;
    border: none;
    border-radius: 999px;
    cursor: pointer;
    box-shadow: 0 4px 20px rgba(233,41,93,0.4);
    transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
  }
  .submit-btn:hover {
    background: #d4234f;
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(233,41,93,0.5);
  }
  .submit-btn:disabled {
    opacity: 0.55; cursor: not-allowed; transform: none;
  }

  /* ── CROP MODAL ── */
  .crop-overlay {
    position: fixed;
    inset: 0;
    background: rgba(26,26,26,0.72);
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }
  .crop-modal {
    background: var(--white);
    border-radius: 20px;
    padding: 24px 24px 20px;
    width: 100%;
    max-width: 480px;
    /* Prevent modal from overflowing viewport height */
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 14px;
    box-shadow: 0 8px 40px rgba(0,0,0,0.2);
  }
  .crop-modal h3 {
    font-size: 1rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--black);
    margin: 0;
    line-height: 1.2;
  }
  .crop-modal > p {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--muted);
    margin: -6px 0 0;
    line-height: 1.5;
  }
  .crop-canvas-wrap {
    width: 100%;
    aspect-ratio: 1 / 1;
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    background: #111;
    cursor: move;
    user-select: none;
    touch-action: none;
    /* Shrink on small screens so buttons stay visible */
    max-height: min(420px, calc(100dvh - 220px));
  }
  .crop-canvas-wrap canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* the 1:1 guide overlay */
  .crop-canvas-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 2.5px solid rgba(255,255,255,0.55);
    border-radius: 12px;
    pointer-events: none;
  }
  .crop-zoom-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .crop-zoom-row label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--muted);
    white-space: nowrap;
  }
  .crop-zoom-row input[type=range] {
    flex: 1;
    accent-color: var(--pink);
    min-width: 0;
  }
  .crop-actions {
    display: flex;
    gap: 10px;
    justify-content: flex-end;
    flex-wrap: nowrap;
  }
  .crop-cancel {
    background: none;
    border: 1.5px solid var(--border);
    color: var(--muted);
    font-family: 'Raleway', sans-serif;
    font-size: 0.84rem;
    font-weight: 700;
    padding: 11px 22px;
    border-radius: 999px;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .crop-confirm {
    background: var(--pink);
    border: none;
    color: white;
    font-family: 'Raleway', sans-serif;
    font-size: 0.84rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    padding: 11px 26px;
    border-radius: 999px;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    box-shadow: 0 4px 14px rgba(233,41,93,0.3);
  }

  /* Mobile crop modal adjustments */
  @media (max-width: 520px) {
    .crop-overlay { padding: 12px; }
    .crop-modal {
      padding: 20px 16px 16px;
      gap: 12px;
      border-radius: 16px;
      max-height: calc(100dvh - 24px);
    }
    .crop-canvas-wrap {
      max-height: min(300px, calc(100dvh - 210px));
    }
    .crop-actions {
      justify-content: stretch;
    }
    .crop-cancel, .crop-confirm {
      flex: 1;
      text-align: center;
      justify-content: center;
      padding: 12px 10px;
      font-size: 0.82rem;
    }
  }

  /* ── REVIEW PAGE ── */
  #review-page {
    padding-top: 32px; /* breathing room below the sticky stage bar */
  }

  .review-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }

  /* Photo card spans full width */
  .rv-card--full { grid-column: 1 / -1; }

  .rv-card {
    background: var(--white);
    border-radius: 24px;
    padding: 28px 32px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    animation: sectionIn 0.4s ease both;
    transition: box-shadow 0.3s ease;
    cursor: default;
  }

  /* Hover glow per card colour — mirrors the form section active glow */
  .rv-card--pink:hover   { box-shadow: 0 4px 32px rgba(233,41,93,0.22),   0 1px 4px rgba(0,0,0,0.04); }
  .rv-card--teal:hover   { box-shadow: 0 4px 32px rgba(63,211,213,0.22),  0 1px 4px rgba(0,0,0,0.04); }
  .rv-card--yellow:hover { box-shadow: 0 4px 32px rgba(254,200,67,0.28),  0 1px 4px rgba(0,0,0,0.04); }
  .rv-card--purple:hover { box-shadow: 0 4px 32px rgba(159,106,205,0.22), 0 1px 4px rgba(0,0,0,0.04); }

  /* Section color borders matching form cards */
  .rv-card--pink   { border: 1.5px solid rgba(233,41,93,0.18); }
  .rv-card--teal   { border: 1.5px solid rgba(63,211,213,0.18); }
  .rv-card--yellow { border: 1.5px solid rgba(254,200,67,0.25); }
  .rv-card--purple { border: 1.5px solid rgba(159,106,205,0.18); }

  .rv-card__head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
  }

  .rv-card__num {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    color: white;
    flex-shrink: 0;
  }

  .rv-card__title {
    font-size: 0.95rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--black);
  }

  .rv-rows { display: flex; flex-direction: column; gap: 0; }

  .rv-row {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 8px;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
    align-items: start;
  }
  .rv-row:last-child { border-bottom: none; padding-bottom: 0; }

  .rv-row__key {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding-top: 2px;
  }

  .rv-row__val {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--black);
    line-height: 1.5;
    word-break: break-word;
  }

  .rv-row__val .tag {
    font-size: 0.72rem;
    padding: 4px 12px;
    margin: 2px 3px 2px 0;
  }

  /* Tags container in review */
  .rv-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 2px; }

  /* Bio char count */
  .rv-bio-count {
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--muted);
    margin-top: 8px;
    display: block;
  }

  /* ── Photo card redesign ── */
  .rv-photo-layout {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .rv-photo-avatar {
    width: 110px;
    height: 110px;
    border-radius: 16px;
    object-fit: cover;
    flex-shrink: 0;
    border: 2.5px solid rgba(254,200,67,0.35);
    box-shadow: 0 4px 16px rgba(254,200,67,0.12);
  }

  /* Vertical divider between avatar and info row */
  .rv-photo-divider-v {
    width: 1.5px;
    align-self: stretch;
    background: rgba(0,0,0,0.07);
    border-radius: 2px;
    flex-shrink: 0;
  }

  /* Info row: all 4 items in one flex row */
  .rv-photo-info-row {
    display: flex;
    align-items: stretch;
    flex: 1;
    min-width: 0;
    gap: 0;
  }

  /* Each info cell */
  .rv-photo-info-cell {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    padding: 4px 20px;
    flex: 1;
    min-width: 0;
    position: relative;
  }

  /* Vertical separator between cells */
  .rv-photo-info-cell + .rv-photo-info-cell::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 1.5px;
    background: rgba(0,0,0,0.07);
    border-radius: 2px;
  }

  /* Colored icon circle */
  .rv-photo-cell-icon {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .rv-photo-cell-icon svg {
    width: 17px;
    height: 17px;
  }
  /* check SVG has a taller viewBox so needs a nudge */
  .rv-photo-cell-icon--teal svg {
    width: 26px;
    height: 26px;
  }
  .rv-photo-cell-icon--teal   { background: rgba(63,211,213,0.13); }
  .rv-photo-cell-icon--teal svg   { color: var(--teal); }
  .rv-photo-cell-icon--pink   { background: rgba(233,41,93,0.1); }
  .rv-photo-cell-icon--pink svg   { color: var(--pink); }
  .rv-photo-cell-icon--purple { background: rgba(159,106,205,0.12); }
  .rv-photo-cell-icon--purple svg { color: var(--purple); }
  .rv-photo-cell-icon--yellow { background: rgba(254,200,67,0.15); }
  .rv-photo-cell-icon--yellow svg { color: var(--yellow); }

  /* Label + value text */
  .rv-photo-cell-label {
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1;
  }
  .rv-photo-cell-val {
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--black);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }
  /* Note cell value is smaller and wraps */
  .rv-photo-cell-val--note {
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--muted);
    white-space: normal;
    line-height: 1.4;
  }

  .rv-no-photo {
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(254,200,67,0.08);
    border: 1.5px dashed rgba(254,200,67,0.4);
    border-radius: 14px;
    padding: 16px 20px;
  }

  .rv-no-photo p {
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--muted);
    line-height: 1.55;
  }

  .rv-no-photo p strong {
    color: var(--yellow);
    font-weight: 800;
    display: block;
    margin-bottom: 2px;
  }

  /* Social links in review */
  .rv-socials { display: flex; flex-direction: column; gap: 8px; }
  .rv-social-row {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.82rem;
  }
  .rv-social-icon {
    width: 18px; height: 18px;
    color: var(--teal);
    flex-shrink: 0;
  }
  .rv-social-icon svg { width: 18px; height: 18px; }
  .rv-social-platform {
    font-weight: 700;
    color: var(--black);
    min-width: 80px;
    font-size: 0.8rem;
  }
  .rv-social-url {
    color: var(--muted);
    font-weight: 500;
    font-size: 0.78rem;
    word-break: break-all;
  }

  /* Consent strip */
  .review-consent {
    background: rgba(159,106,205,0.06);
    border-radius: 20px;
    padding: 24px 0 24px 32px;
    margin-bottom: 16px;
    border: 1.5px solid rgba(159,106,205,0.2);
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    overflow: hidden;
  }

  .review-consent__inner {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .review-consent__shield {
    width: clamp(44px, 6vw, 64px);
    height: clamp(44px, 6vw, 64px);
    flex-shrink: 0;
  }

  .review-consent__text {
    flex: 1;
    min-width: 0;
  }

  .review-consent__clapper {
    width: clamp(120px, 18vw, 200px);
    height: auto;
    flex-shrink: 0;
    align-self: stretch;
    object-fit: contain;
    object-position: bottom right;
    margin-right: -2px;
  }

  .review-consent__title {
    font-size: 1rem;
    font-weight: 900;
    color: var(--black);
    margin-bottom: 4px;
  }

  .review-consent__body {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--muted);
    line-height: 1.6;
  }

  /* Action bar */
  .review-actions-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }

  .btn-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: none;
    border: 1.5px solid var(--border);
    color: var(--muted);
    font-family: 'Raleway', sans-serif;
    font-size: 0.88rem;
    font-weight: 700;
    padding: 13px 24px;
    border-radius: 999px;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }
  .btn-back:hover { border-color: var(--black); color: var(--black); }

  .btn-confirm {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--pink);
    border: none;
    color: white;
    font-family: 'Raleway', sans-serif;
    font-size: 0.88rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    padding: 14px 32px;
    border-radius: 999px;
    cursor: pointer;
    box-shadow: 0 4px 20px rgba(233,41,93,0.4);
    transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
  }
  .btn-confirm:hover {
    background: #d4234f;
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(233,41,93,0.5);
  }
  .btn-confirm:disabled { opacity: 0.55; cursor: not-allowed; transform: none; }

  .review-security-note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--muted);
    text-align: center;
    padding-bottom: 8px;
  }

  /* Responsive review grid */
  @media (max-width: 680px) {
    .review-grid { grid-template-columns: 1fr; }
    .rv-card--full { grid-column: 1; }
    .rv-card { padding: 22px 20px; }
    .rv-photo-layout { flex-direction: column; align-items: flex-start; gap: 16px; }
    .rv-photo-avatar { width: 90px; height: 90px; }
    .rv-photo-divider-v { display: none; }
    .rv-photo-info-row { flex-wrap: wrap; gap: 0; }
    .rv-photo-info-cell { padding: 8px 14px; min-width: 45%; }
    .rv-photo-info-cell + .rv-photo-info-cell::before { display: none; }
    .review-consent { padding: 20px; }
    .review-consent__inner { gap: 14px; }
    .review-consent__clapper { display: none; }
    .review-actions-bar { flex-direction: column; }
    .btn-back, .btn-confirm { width: 100%; justify-content: center; }
    .rv-row { grid-template-columns: 90px 1fr; }
  }

  /* ── SUCCESS STATE ── */
  .success-state {
    text-align: center;
    padding: 80px 40px;
    background: var(--white);
    border-radius: 28px;
    margin-top: 20px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.04);
    position: relative;
  }
  .success-sparks {
    position: absolute;
    top: 24px; right: 24px;
    width: 48px;
    opacity: 0.7;
  }
  .success-check {
    width: 72px; height: 72px;
    margin: 0 auto 20px;
    animation: popIn 0.5s cubic-bezier(0.34,1.56,0.64,1) both;
  }
  @keyframes popIn {
    from { transform: scale(0); opacity: 0; }
    to   { transform: scale(1); opacity: 1; }
  }
  .success-title {
    font-size: 2rem;
    font-weight: 900;
    color: var(--black);
    margin-bottom: 12px;
  }
  .success-text {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--muted);
    line-height: 1.65;
    max-width: 400px;
    margin: 0 auto 24px;
  }
  .success-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    color: var(--pink);
    background: rgba(233,41,93,0.07);
    border: 1.5px solid rgba(233,41,93,0.2);
    padding: 8px 20px;
    border-radius: 999px;
  }

  /* ── FOOTER ── */
  .site-footer {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px 24px 40px;
    margin-top: 8px;
    min-height: 140px;
  }
  .footer-logo {
    height: 72px;
    width: auto;
    transition: opacity 0.2s;
    display: block;
    position: relative;
    z-index: 2;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 680px) {
    .hero { padding: 48px 20px 56px; }
    .section { padding: 28px 22px; }
    .fields--2, .fields--3 { grid-template-columns: 1fr; }
    .fields--identity { grid-template-columns: 2fr 1fr; gap: 12px; }
    .field--nickname { grid-column: 1 / 2; margin-top: 0; }
    .field--full { grid-column: 1; }
    .social-row { grid-template-columns: 1fr 40px; }
    .social-select-wrap { grid-column: 1 / -1; }
    .social-url { grid-column: 1; }
    .social-remove { grid-column: 2; grid-row: 2; }
    .submit-strip { padding: 24px 22px; }
    .submit-btn { justify-content: center; }
    /* shrink section icons so they don't overflow/crop on small cards */
    .section__icon-bg {
      width: 72px; height: 72px;
      margin-top: 0;
    }
    .section__icon-bg img {
      width: 72px; height: 72px;
    }
    /* reduce outer form padding so cards get more width */
    .form-wrap { padding: 0 16px 60px; }
    /* smaller section titles on mobile */
    .section__title { font-size: 1.05rem; }
    /* hide optional badge on small screens */
    .opt-badge { display: none; }
    /* photo section on mobile */
    .photo-avatar-wrap { width: 68px; height: 68px; }
    .photo-layout { grid-template-columns: 1fr; }
    .photo-divider-v { display: none; }
    .photo-preview-col {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      width: 100%;
      margin-top: 20px;
    }
    .photo-preview-col .preview-label {
      order: -1;
      font-size: 0.72rem;
    }
    .photo-preview-card {
      width: 100%;
      max-width: 100%;
    }
    .no-photo-note { flex-direction: row; align-items: flex-start; padding-left: 0; }
    /* comic-shade crop scales with its smaller size */
    .deco--comicshade { width: 200px; bottom: -70px; left: -70px; }
    /* footer */
    .site-footer { padding: 40px 24px 32px; }
    .footer-logo { height: 42px; }
  }

  /* ── EXTRA-SMALL SCREENS (≤ 400px) ── */
  @media (max-width: 400px) {
    .section { padding: 22px 16px; }
    .form-wrap { padding: 0 12px 60px; }
    .section__icon-bg {
      width: 52px; height: 52px;
    }
    .section__icon-bg img {
      width: 52px; height: 52px;
    }
    .section__title { font-size: 0.95rem; }
    .opt-badge { display: none; }
    /* comic-shade crop scales down further */
    .deco--comicshade { width: 150px; bottom: -50px; left: -50px; }
  }

  /* ── TINY SCREENS (≤ 340px) – hide all decos ── */
  @media (max-width: 340px) {
    .deco { display: none; }
  }
</style>

