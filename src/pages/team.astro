---

<BaseLayout title="Team">
  <div class="team-page">
    <section class="team-hero">
      <h1 class="team-hero__title">OUR<br/><span class="team-hero__title--pink">TEAM</span></h1>
      <p class="team-hero__sub">The people behind 24fps — faculty, alumni, and the students building every production.</p>
    </section>

    {error && (
      <p class="team-error">Couldn't load the team right now. Please try again shortly.</p>
    )}

    {!error && allMembers.length === 0 && (
      <p class="team-empty">No published members yet.</p>
    )}

    {!error && allMembers.length > 0 && categories.map((category) => {
      const list = membersByCategory(category);
      if (list.length === 0) return null;

      return (
        <section class="team-section" id={category}>
          <h2 class="team-section__title">{categoryLabels[category]}</h2>
          <div class="team-grid">
            {list.map((m, i) => {
              const accent = ACCENTS[i % ACCENTS.length];
              const { lead, last } = splitName(m.name);
              const socialEntries = m.socials && typeof m.socials === 'object' ? Object.entries(m.socials) : [];
              const expertiseList: string[] = Array.isArray(m.expertise) ? m.expertise : [];
              return (
                <article class={`member-card member-card--${accent}`} id={m.slug}>
                  <div class="member-card__glow" aria-hidden="true"></div>
                  <div class="member-card__photo-col">
                    {m.photo_url
                      ? <img src={m.photo_url} alt={m.name} class="member-card__photo" loading="lazy" />
                      : <div class="member-card__photo-fallback">{initialsFor(m)}</div>
                    }
                  </div>
                  <div class="member-card__body">
                    <div class="member-card__top">
                      <a href={`/team/${m.slug}`} class="member-card__name">
                        {lead && <span class="member-card__name-lead">{lead} </span>}
                        <span class="member-card__name-last">{last || lead}</span>
                      </a>
                      <p class="member-card__role">{m.role}</p>
                      <div class="member-card__tags">
                        {expertiseList.length > 0
                          ? expertiseList.map((tag, ti) => (
                              <span class="member-card__tag" data-ci={ti % 4}>{tag}</span>
                            ))
                          : <span class="member-card__tag-empty">No expertise listed</span>
                        }
                      </div>
                    </div>
                    <div class="member-card__contact">
                      {m.email && (
                        <a href={`mailto:${m.email}`} class="member-card__email">
                          <span class="member-card__email-icon">
                            <svg viewBox="0 0 24 24" fill="none"><rect x="2" y="4" width="20" height="16" rx="3" stroke="currentColor" stroke-width="2"/><path d="M3 6l9 7 9-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                          </span>
                          <span class="member-card__email-text">{m.email}</span>
                        </a>
                      )}
                      <div class="member-card__bottom">
                        <div class="member-card__socials">
                          {socialEntries.map(([platform, url]) => (
                            url ? (
                              <a href={url as string} target="_blank" rel="noopener" class="member-card__icon-link" title={platform} aria-label={platform}>
                                <span class="member-card__icon-inner" set:html={SOCIAL_ICONS[platform] || SOCIAL_ICONS.others}></span>
                              </a>
                            ) : null
                          ))}
                        </div>
                        <a href={`/team/${m.slug}`} class="member-card__arrow" aria-label={`View ${m.name}'s full profile`}>
                          <svg viewBox="0 0 24 24" fill="none"><path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </a>
                      </div>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      );
    })}
  </div>
</BaseLayout>

<style>
  /* Uses the site's real global.css variables (loaded once via
     BaseLayout) rather than redefining a competing local palette.
     global.css doesn't have a --purple, so it's added here. */
  :root {
    --purple: #9F6ACD; /* matches member-form.astro's --purple */
  }

  .team-page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 8rem 1.5rem 6rem;
    font-family: 'Raleway', sans-serif;
  }

  .team-hero { text-align: center; margin-bottom: 4rem; }
  .team-hero__title {
    font-size: clamp(2.4rem, 5.5vw, 3.6rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--black);
    margin-bottom: 16px;
  }
  .team-hero__title--pink { color: var(--pink); }
  .team-hero__sub {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--muted, var(--grey));
    line-height: 1.65;
    max-width: 480px;
    margin: 0 auto;
  }

  .team-error, .team-empty { text-align: center; color: var(--grey); padding: 3rem 0; }

  .team-section { margin-bottom: 4.5rem; }
  .team-section__title {
    font-size: 1.4rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 1.75rem;
    color: var(--black);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1.25rem;
  }
  @media (min-width: 780px) {
    .team-grid { grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
  }

  /* ── CARD ── */
  .member-card {
    position: relative;
    display: flex;
    gap: 0;
    min-height: 240px;
    border-radius: 24px;

    /* Same soft warm-white sheen as .navbar's own background —
       no accent tint here; each card's color still shows up in
       its glow, name, tags, icons and arrow below. */
    background: linear-gradient(
      to right,
      #FCF8F8 0%,
      #FFFFFF 25%,
      #FFFFFF 75%,
      #FCF8F8 100%
    );

    border: none;
    overflow: hidden;
    scroll-margin-top: 120px;
    transition: transform 0.22s ease, box-shadow 0.22s ease;
  }
  .member-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 40px rgba(26,26,26,0.12);
  }
  .member-card:target {
    box-shadow: 0 0 0 2px var(--card-accent, var(--pink));
  }

  /* Glass edge — same technique as .navbar::before: a bright-to-faded
     white gradient masked down to a thin ring, giving that whitish
     border look without any accent-color tint. */
  .member-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 24px;
    padding: 1.5px;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 1) 0%,
      rgba(255, 255, 255, 0.4) 100%
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
    z-index: 2;
  }

  /* Subtle animated glow bleeding from behind the card — deliberately
     slow and low-opacity so it reads as ambient, not attention-grabbing. */
  .member-card__glow {
    position: absolute;
    inset: -30%;
    background: radial-gradient(ellipse 65% 55% at 15% 20%, var(--card-accent-soft, rgba(233,41,93,0.16)), transparent 70%);
    filter: blur(18px);
    opacity: 0.8;
    animation: memberGlow 9s ease-in-out infinite;
    pointer-events: none;
    z-index: 0;
  }
  @keyframes memberGlow {
    0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.7; }
    50% { transform: translate(3%, 2%) scale(1.06); opacity: 0.95; }
  }
  @media (prefers-reduced-motion: reduce) {
    .member-card__glow { animation: none; }
  }

  .member-card--pink   { --card-accent: var(--pink);   --card-hover: #A7284E; --card-accent-soft: rgba(233,41,93,0.16); }
  .member-card--teal   { --card-accent: var(--teal);   --card-hover: #358B85; --card-accent-soft: rgba(63,211,213,0.18); }
  .member-card--yellow { --card-accent: var(--yellow); --card-hover: #AB8C2E; --card-accent-soft: rgba(254,200,67,0.20); }
  .member-card--purple { --card-accent: var(--purple); --card-hover: #84799C; --card-accent-soft: rgba(159,106,205,0.18); }

  .member-card--pink:hover   { box-shadow: 0 12px 32px rgba(233,41,93,0.18); }
  .member-card--teal:hover   { box-shadow: 0 12px 32px rgba(63,211,213,0.20); }
  .member-card--yellow:hover { box-shadow: 0 12px 32px rgba(254,200,67,0.24); }
  .member-card--purple:hover { box-shadow: 0 12px 32px rgba(159,106,205,0.20); }

  .member-card__photo-col {
    position: relative;
    z-index: 1;
    flex: 0 0 38%;
    min-width: 110px;
    align-self: stretch;
  }
  .member-card__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .member-card__photo-fallback {
    width: 100%;
    height: 100%;
    min-height: 240px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--card-accent-soft, var(--off-white));
    color: var(--card-accent, var(--grey));
    font-size: 1.9rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .member-card__body {
    position: relative;
    z-index: 1;
    flex: 1;
    min-width: 0;
    padding: 1.4rem 1.3rem 1.15rem 1.3rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
