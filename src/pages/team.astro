---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { createClient } from '@supabase/supabase-js';

// Public read-only client — anon key only, no service role here.
// RLS on the `members` table only allows SELECT where published =
// true, so this can never leak unpublished or pending submissions
// even if someone inspects the network tab.
const runtimeEnv = (Astro.locals as any).runtime?.env;
const supabaseUrl = runtimeEnv?.PUBLIC_SUPABASE_URL ?? import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseAnonKey = runtimeEnv?.PUBLIC_SUPABASE_ANON_KEY ?? import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
const supabase = createClient(supabaseUrl, supabaseAnonKey);

const { data: members, error } = await supabase
  .from('members')
  .select('*')
  .eq('published', true)
  .order('name', { ascending: true });

const allMembers = members || [];

const categories = ['faculty', 'alumni', 'student'] as const;
const categoryLabels: Record<string, string> = {
  faculty: 'Faculty',
  alumni: 'Alumni',
  student: 'Students',
};

// Card accent rotates pink → teal → yellow → purple by position within
// each category's own grid, restarting at 0 for every section — same
// rule as SECTION_COLORS / TAG_COLORS in the member submission form.
const ACCENTS = ['pink', 'teal', 'yellow', 'purple'] as const;

function membersByCategory(category: string) {
  return allMembers.filter((m) => m.category === category);
}

function initialsFor(m: any) {
  if (m.initials) return m.initials;
  return (m.name || '')
    .split(/\s+/)
    .filter(Boolean)
    .map((w: string) => w[0]?.toUpperCase())
    .slice(0, 2)
    .join('');
}

// Splits a full name into "first + middle" (rendered black) and
// "last" (rendered in the card's accent color) per the card spec.
function splitName(name: string) {
  const parts = (name || '').trim().split(/\s+/);
  if (parts.length <= 1) return { lead: name || '', last: '' };
  return { lead: parts.slice(0, -1).join(' '), last: parts[parts.length - 1] };
}

const SOCIAL_ICONS: Record<string, string> = {
