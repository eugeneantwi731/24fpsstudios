---

<BaseLayout title={member.name}>
  <main class={`profile-page profile-page--${accent}`}>
    <a href="/team" class="back-link">
      <svg viewBox="0 0 24 24" fill="none"><path d="M19 12H5M5 12l7 7M5 12l7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Back to Team
    </a>

    <div class="profile-hero">
      <div class="profile-hero__glow" aria-hidden="true"></div>
      <div class="profile-photo-col">
        {member.photo_url
          ? <img src={member.photo_url} alt={member.name} class="profile-photo" />
          : <div class="profile-photo-fallback">{initialsFor(member)}</div>
        }
      </div>
      <div class="profile-info">
        <span class="profile-category">{categoryLabels[member.category] || member.category}</span>
        <h1 class="profile-name">
          {lead && <span class="profile-name-lead">{lead} </span>}
          <span class="profile-name-last">{last || lead}</span>
        </h1>
        {member.nickname && <p class="profile-nickname">"{member.nickname}"</p>}
        <p class="profile-role">{member.role}{member.program ? ` · ${member.program}` : ''}</p>

        <div class="profile-contact">
          {member.email && (
            <a href={`mailto:${member.email}`} class="profile-contact-link">
              <svg viewBox="0 0 24 24" fill="none"><rect x="2" y="4" width="20" height="16" rx="3" stroke="currentColor" stroke-width="2"/><path d="M3 6l9 7 9-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {member.email}
            </a>
          )}
          {member.portfolio && (
            <a href={member.portfolio} target="_blank" rel="noopener" class="profile-contact-link">
              <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20" stroke="currentColor" stroke-width="2"/></svg>
              Portfolio
            </a>
          )}
        </div>

        {socialEntries.length > 0 && (
          <div class="profile-socials">
            {socialEntries.map(([platform, url]) => (
              url ? (
                <a href={url as string} target="_blank" rel="noopener" class="profile-social-link" title={platform} set:html={SOCIAL_ICONS[platform] || SOCIAL_ICONS.others}></a>
              ) : null
            ))}
          </div>
        )}
      </div>
    </div>

    {member.bio && (
      <section class="profile-section">
        <h2 class="profile-section__title">About</h2>
        <p class="profile-bio">{member.bio}</p>
      </section>
    )}

    {expertiseList.length > 0 && (
      <section class="profile-section">
        <h2 class="profile-section__title">Expertise</h2>
        <div class="profile-tags">
          {expertiseList.map((tag, i) => (
            <span class="profile-tag" data-ci={i % 4}>{tag}</span>
          ))}
        </div>
      </section>
    )}
  </main>
</BaseLayout>

<style>
  :root {
    --pink:    #E9295D;
    --teal:    #3FD3D5;
    --yellow:  #FEC843;
    --purple:  #9F6ACD;
    --black:   #1A1A1A;
    --white:   #FFFFFF;
    --off:     #F8F5F5;
    --muted:   #6B7280;

    --pink-dark:   #C41E4A;
    --teal-dark:   #0A7E80;
    --yellow-dark: #8A6000;
    --purple-dark: #6A35A8;
  }

  .profile-page {
    max-width: 880px;
    margin: 0 auto;
    padding: 7rem 1.5rem 6rem;
    font-family: 'Raleway', sans-serif;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 2rem;
    transition: color 0.18s;
  }
  .back-link svg { width: 16px; height: 16px; }
  .back-link:hover { color: var(--black); }

  .profile-hero {
    position: relative;
    display: flex;
    gap: 2rem;
    align-items: flex-start;
    background: var(--white);
    border: 1.5px solid var(--profile-accent-soft, rgba(233,41,93,0.16));
    border-radius: 28px;
    padding: 2.25rem;
    overflow: hidden;
    margin-bottom: 3rem;
  }

  .profile-hero__glow {
    position: absolute;
    inset: -30%;
    background: radial-gradient(ellipse 55% 50% at 10% 15%, var(--profile-accent-soft, rgba(233,41,93,0.16)), transparent 70%);
    filter: blur(24px);
    opacity: 0.85;
    animation: profileGlow 10s ease-in-out infinite;
    pointer-events: none;
    z-index: 0;
  }
  @keyframes profileGlow {
    0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.75; }
    50% { transform: translate(2%, 2%) scale(1.05); opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .profile-hero__glow { animation: none; }
  }

  .profile-page--pink   { --profile-accent: var(--pink);   --profile-accent-dark: var(--pink-dark);   --profile-accent-soft: rgba(233,41,93,0.16); }
  .profile-page--teal   { --profile-accent: var(--teal);   --profile-accent-dark: var(--teal-dark);   --profile-accent-soft: rgba(63,211,213,0.18); }
  .profile-page--yellow { --profile-accent: var(--yellow); --profile-accent-dark: var(--yellow-dark); --profile-accent-soft: rgba(254,200,67,0.20); }
  .profile-page--purple { --profile-accent: var(--purple); --profile-accent-dark: var(--purple-dark); --profile-accent-soft: rgba(159,106,205,0.18); }

  .profile-photo-col { position: relative; z-index: 1; flex-shrink: 0; }
  .profile-photo {
    width: 168px;
    height: 168px;
    border-radius: 22px;
    object-fit: cover;
    display: block;
  }
  .profile-photo-fallback {
    width: 168px;
    height: 168px;
    border-radius: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--profile-accent-soft);
    color: var(--profile-accent-dark);
    font-size: 2.2rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .profile-info { position: relative; z-index: 1; flex: 1; min-width: 0; }

  .profile-category {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--profile-accent-dark);
    background: var(--profile-accent-soft);
    padding: 4px 12px;
    border-radius: 999px;
    margin-bottom: 0.75rem;
  }

  .profile-name {
    font-size: 2rem;
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .profile-name-lead { color: var(--black); }
  .profile-name-last { color: var(--profile-accent-dark); }

  .profile-nickname {
    font-size: 0.95rem;
    color: var(--muted);
    font-style: italic;
    margin-top: 0.4rem;
  }

  .profile-role {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--muted);
    margin-top: 0.6rem;
  }

  .profile-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    margin-top: 1.1rem;
  }
  .profile-contact-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    color: var(--black);
    font-size: 0.85rem;
    font-weight: 700;
    transition: color 0.18s;
  }
  .profile-contact-link svg { width: 16px; height: 16px; color: var(--profile-accent-dark); flex-shrink: 0; }
  .profile-contact-link:hover { color: var(--profile-accent-dark); }

  .profile-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.2rem;
  }
  .profile-social-link {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--profile-accent-soft);
    color: var(--profile-accent-dark);
    transition: background 0.18s, color 0.18s, transform 0.18s;
  }
  .profile-social-link svg { width: 16px; height: 16px; }
  .profile-social-link:hover {
    background: var(--profile-accent);
    color: var(--white);
    transform: translateY(-2px);
  }

  .profile-section { margin-bottom: 2.5rem; }
  .profile-section__title {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1rem;
  }
  .profile-bio {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--black);
    max-width: 65ch;
  }

  .profile-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .profile-tag {
    display: inline-flex;
    align-items: center;
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 700;
