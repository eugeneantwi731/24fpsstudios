---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createClient } from '@supabase/supabase-js';

const { slug } = Astro.params;

const runtimeEnv = (Astro.locals as any).runtime?.env;
const supabaseUrl = runtimeEnv?.PUBLIC_SUPABASE_URL ?? import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseAnonKey = runtimeEnv?.PUBLIC_SUPABASE_ANON_KEY ?? import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
const supabase = createClient(supabaseUrl, supabaseAnonKey);

const { data: member, error } = await supabase
  .from('members')
  .select('*')
  .eq('slug', slug)
  .eq('published', true)
  .maybeSingle();

if (error || !member) {
  return Astro.redirect('/team');
}

// Figure out this member's position (and therefore accent color) within
// their own category, so the profile page matches the color they had
// on the grid card — same rotation rule, recomputed here since a single
// member fetch doesn't know its own index.
const { data: categoryMembers } = await supabase
  .from('members')
  .select('slug')
  .eq('published', true)
  .eq('category', member.category)
  .order('name', { ascending: true });

const ACCENTS = ['pink', 'teal', 'yellow', 'purple'] as const;
const indexInCategory = (categoryMembers || []).findIndex((m) => m.slug === member.slug);
const accent = ACCENTS[(indexInCategory >= 0 ? indexInCategory : 0) % ACCENTS.length];

function splitName(name: string) {
  const parts = (name || '').trim().split(/\s+/);
  if (parts.length <= 1) return { lead: name || '', last: '' };
  return { lead: parts.slice(0, -1).join(' '), last: parts[parts.length - 1] };
}
const { lead, last } = splitName(member.name);

function initialsFor(m: any) {
  if (m.initials) return m.initials;
  return (m.name || '')
    .split(/\s+/)
    .filter(Boolean)
    .map((w: string) => w[0]?.toUpperCase())
    .slice(0, 2)
    .join('');
}

const categoryLabels: Record<string, string> = {
  faculty: 'Faculty',
  alumni: 'Alumni',
  student: 'Student',
};

const expertiseList: string[] = Array.isArray(member.expertise) ? member.expertise : [];
const socialEntries = member.socials && typeof member.socials === 'object' ? Object.entries(member.socials) : [];

const SOCIAL_ICONS: Record<string, string> = {
